  - m_Id: 1785876483923968
    m_Localized: OPGAVECENTER
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: Alle opgaver er ryddet!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701185
    m_Localized: Fuldfør opgaver for at samle <color=#C31439>Brændstoffer</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701186
    m_Localized: Færdiggør alle opgaver for at låse op for næste fase og få vidunderlige belønninger!
