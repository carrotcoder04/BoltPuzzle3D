  - m_Id: 1785876483923968
    m_Localized: GÖREV MERKEZİ
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: Tüm Görevler Tamamlandı!
    m_Metadata:
      m_Items: []
