  m_TableData:
  - m_Id: 759331545088
    m_Localized: ΣΤΑΔΙΟ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1785876483923968
    m_Localized: ΚΕΝΤΡΟ ΑΣΚΗΣΕΩΝ
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: Όλες οι εργασίες ολοκληρώθηκαν!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701185
    m_Localized: Ολοκληρώστε καθήκοντα για να συλλέξετε <color=#C31439>Καύσιμα</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701186
    m_Localized: Ολοκληρώστε όλα τα καθήκοντα για να ξεκλειδώσετε την επόμενη σκηνή και να πάρετε υπέροχα βραβεία!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701187
    m_Localized: Ολοκλήρωσε τις εργασίες!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701188
    m_Localized: Συλλέξτε καύσιμα!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701189
    m_Localized: Κερδίστε υπέροχες ανταμοιβές!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701190
    m_Localized: Καθαρίστε το τρέχον στάδιο για να προχωρήσετε!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701191
    m_Localized: Το σεντούκι είναι ήδη ανοιγμένο!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701192
    m_Localized: Το καθήκον ήδη διεκδικήθηκε!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876504895488
    m_Localized: Ολοκληρώστε όλα τα προηγούμενα στάδια για να έχετε πρόσβαση σε αυτό το καθήκον!
    m_Metadata:
      m_Items: []
  - m_Id: 133379687869046784
    m_Localized: Κερδίστε {0} κέρματα!
    m_Metadata:
      m_Items: []
  - m_Id: 133379687885824000
    m_Localized: Ξοδέψτε {0} κέρματα!
    m_Metadata:
      m_Items: []
