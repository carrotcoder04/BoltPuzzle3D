    m_Localized: ステージ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1785876483923968
    m_Localized: クエストセンター
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: 全ミッションクリア！
    m_Metadata:
      m_Items: []
