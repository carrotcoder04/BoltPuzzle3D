  m_TableData:
  - m_Id: 759331545088
    m_Localized: चरण {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1785876483923968
    m_Localized: कार्य केंद्र
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: सभी कार्य समाप्त!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701185
    m_Localized: कार्य पूरे करें <color=#C31439>ईंधन</color> इकट्ठा करने के लिए!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701186
    m_Localized: अगले चरण को अनलॉक करने और शानदार पुरस्कार पाने के लिए सभी कार्यों को पूरा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701187
    m_Localized: कार्य पूरा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701188
    m_Localized: ईंधन इकट्ठा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701189
    m_Localized: अद्भुत इनाम कमाएं!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701190
    m_Localized: वर्तमान चरण को साफ़ करके आगे बढ़ें!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701191
    m_Localized: संदूक पहले ही खुल चुका है!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701192
    m_Localized: कार्य पहले ही दावा किया जा चुका है!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876504895488
    m_Localized: इस कार्य तक पहुँचने के लिए सभी पिछले चरण पूरे करें!
    m_Metadata:
      m_Items: []
  - m_Id: 133379687869046784
    m_Localized: '{0} सिक्के कमाएं!'
    m_Metadata:
      m_Items: []
  - m_Id: 133379687885824000
    m_Localized: '{0} सिक्के खर्च करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 42760616560025601
    m_Localized: '{0} स्तर जीतें!'
    m_Metadata:
      m_Items: []
  - m_Id: 12277718623182848
    m_Localized: एक स्तर जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671104
    m_Localized: 1 उपहार बॉक्स खोलें!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671105
    m_Localized: की शिकार में 1 उपहार बॉक्स खोलें!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671106
    m_Localized: '{0} उपहार बॉक्स खोलें!'
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671107
    m_Localized: की शिकार में {0} उपहार बॉक्स खोलें!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671108
    m_Localized: '{0} फूल इकट्ठा करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671109
    m_Localized: गार्डन एरिना में {0} फूल इकट्ठा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220418
    m_Localized: मिशन हब
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220419
    m_Localized: कार्य पूरे करें <color=#C31439>पोषण</color> इकट्ठा करने के लिए!
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220420
    m_Localized: उपचार जुटाएं!
    m_Metadata:
      m_Items: []
  - m_Id: 21699334096543744
    m_Localized: 1 उपहार बॉक्स पाएँ!
    m_Metadata:
      m_Items: []
  - m_Id: 21699334125903872
    m_Localized: '{0} उपहार बॉक्स पाएँ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21699334134292480
    m_Localized: गुब्बारा यात्रा में 1 उपहार बॉक्स पाएँ!
    m_Metadata:
      m_Items: []
  - m_Id: 21699334138486784
    m_Localized: गुब्बारा यात्रा में {0} उपहार बॉक्स पाएँ!
    m_Metadata:
      m_Items: []
  - m_Id: 25343820374728704
    m_Localized: पहली कोशिश में {0} स्तर जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 27128643292487680
    m_Localized: बधाई हो!
    m_Metadata:
      m_Items: []
