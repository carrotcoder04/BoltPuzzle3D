  m_TableData:
  - m_Id: 759331545088
    m_Localized: مرحلہ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1785876483923968
    m_Localized: ٹاسک سینٹر
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701184
    m_Localized: تمام کام مکمل!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701185
    m_Localized: ٹاسک مکمل کریں تاکہ <color=#C31439>ایندھن</color> جمع کر سکیں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701186
    m_Localized: اگلے مرحلے کو انلاک کرنے اور شاندار انعامات حاصل کرنے کے لیے تمام ٹاسک مکمل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701187
    m_Localized: کام مکمل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701188
    m_Localized: ایندھن جمع کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701189
    m_Localized: حیرت انگیز انعامات حاصل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701190
    m_Localized: آگے بڑھنے کے لیے موجودہ مرحلہ صاف کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701191
    m_Localized: چیست پہلے ہی کھل چکی ہے!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876500701192
    m_Localized: ٹاسک پہلے ہی حاصل کر لیا گیا ہے!
    m_Metadata:
      m_Items: []
  - m_Id: 1785876504895488
    m_Localized: اس ٹاسک تک رسائی کے لیے تمام پچھلے مراحل مکمل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 133379687869046784
    m_Localized: '{0} سکے کما ئیں!'
    m_Metadata:
      m_Items: []
  - m_Id: 133379687885824000
    m_Localized: '{0} سکے خرچ کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 42760616560025601
    m_Localized: '{0} سطحیں جیتیں'
    m_Metadata:
      m_Items: []
  - m_Id: 12277718623182848
    m_Localized: ایک لیول جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671104
    m_Localized: 1 تحفہ باکس کھولیں!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671105
    m_Localized: کی ہنٹر میں 1 گفٹ باکس کھولیں!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671106
    m_Localized: '{0} تحفہ باکس کھولیں!'
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671107
    m_Localized: کی ہنٹر میں {0} گفٹ باکس کھولیں!
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671108
    m_Localized: '{0} پھول جمع کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 16548679354671109
    m_Localized: باغ کے میدان میں {0} پھول جمع کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220418
    m_Localized: مشن حب
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220419
    m_Localized: ٹاسک مکمل کریں تاکہ <color=#C31439>جادو کی دوائیں</color> جمع کر سکیں!
    m_Metadata:
      m_Items: []
  - m_Id: 20293628076220420
    m_Localized: مادے جمع کریں!
    m_Metadata:
      m_Items: []
