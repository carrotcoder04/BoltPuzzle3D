  - m_Id: 626313388032
    m_Localized: Samla skruvmejslar!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Hitta nycklar!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Tjäna belöningar!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Detta är din sista chans att använda skruvmejslar.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Inga skruvmejslar kvar!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Grattis!\nDu har slutfört NYCKELJAKTARE!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: LYCKA TILL
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: FORTSäTT Gå
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Om du lämnar nu kommer du att förlora dina skruvmejslar!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Du har skruvmejslar för att tjäna belöningar!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: AVSLÖJA ALLA
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: NYCKELJAKTARE
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Genomför nivåer för att få fler
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: FÖRSÖK IGEN
    m_Metadata:
      m_Items: []
