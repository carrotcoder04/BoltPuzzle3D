    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Chúc mừng!\nBạn đã hoàn thành THỢ SỬA CHỮA KHÓA!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: CHÚC MAY MẮN
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: TIẾP TỤC
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: TỐI ĐA
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Nếu bạn thoát bây giờ, bạn sẽ mất các tua vít của mình!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Bạn có các tua vít để kiếm phần thưởng!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: TIẾT LỘ TẤT CẢ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: THỢ SỬA CHỮA KHÓA
    m_Metadata:
      m_Items: []
