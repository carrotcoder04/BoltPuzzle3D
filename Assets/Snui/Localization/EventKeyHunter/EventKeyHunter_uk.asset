  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: Збирайте викрутки!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Знайдіть ключі!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Заробляйте винагороди!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Це ваш останній шанс використати викрутки.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Викруток більше немає!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Вітаємо!\nВи завершили ЛОВЕЦЬ КЛЮЧІВ!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: УДАЧІ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: Продовжуйте
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: МАКС
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Якщо ви зараз вийдете, ви втратите свої викрутки!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: У вас є викрутки для отримання винагород!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: ВІДКРИТИ ВСЕ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: ЛОВЕЦЬ КЛЮЧІВ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Завершуйте рівні, щоб отримати більше
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: Спробуйте ще раз
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Перемагайте на рівнях!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Вигравайте рівні, щоб отримати викрутки. Використовуйте викрутку, щоб відкрити цю вкладку.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Знайдіть ключі, щоб отримати фінальні винагороди!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
