  m_TableData:
  - m_Id: 626313388032
    m_Localized: Gyűjts csavarhúzót!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Találd meg a kulcsokat!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Szerezd meg a jutalmakat!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Ez az utolsó esélyed a csavarhúzók felhasználására.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Nincsenek csavarhúzók!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Gratulálunk!\nTeljesítetted a KULCSKERESŐT!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: JÓ SIKERT
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: FOLYTATSD
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Ha most kilépsz, elveszíted a csavarhúzóidat!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Van csavarhúzód, hogy jutalmakat szerezz!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: TáRJ FEL MINDENT
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: KULCSKERESŐ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Teljesíts szinteket, hogy többet szerezz
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: PRÓBÁLD ÚJRA
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Nyerd meg a szinteket!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Nyerd meg a szinteket, hogy csavarhúzókat szerezz. Használj csavarhúzót ennek a fülnek a feloldásához.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Találj kulcsokat a végső jutalmakért!
    m_Metadata:
      m_Items: []
