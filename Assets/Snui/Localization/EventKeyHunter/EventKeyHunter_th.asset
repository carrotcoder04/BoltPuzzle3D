  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: สะสมไขควง!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: ค้นหากุญแจ!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: รับรางวัล!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: นี่คือโอกาสสุดท้ายของคุณในการใช้ไขควง.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: ไม่มีไขควงเหลือ!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: ยินดีด้วย! คุณได้เสร็จสิ้นนักล่ากุญแจ!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: โชคดี
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: ดำเนินการต่อ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: สูงสุด
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: ถ้าคุณออกตอนนี้ คุณจะเสียไขควง!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: คุณมีไขควงเพื่อรับรางวัล!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: เปิดเผยทั้งหมด
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: นักล่ากุญแจ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: ผ่านระดับเพื่อรับมากขึ้น
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: ลองใหม่อีกครั้ง
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: ชนะเลเวล!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: ชนะระดับเพื่อรับไขควง ใช้ไขควงเพื่อปลดล็อกแท็บนี้.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: หากุญแจเพื่อรับรางวัลสุดท้าย!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
