  m_TableData:
  - m_Id: 626313388032
    m_Localized: Kumpul pemutar skru!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Cari Kunci!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Dapatkan ganjaran!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Ini adalah peluang terakhir anda untuk menggunakan pemutar skru.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Tiada pemutar skru yang tinggal!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Tahniah!\nAnda telah menyelesaikan PEMBURU KUNCI!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: SELAMAT MENCUBA
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: TERUSKAN
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAKS
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Jika anda keluar sekarang, anda akan kehilangan pemutar skru anda!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Anda mempunyai pemutar skru untuk mendapatkan ganjaran!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: UNGKAPKAN SEMUA
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: PEMBURU KUNCI
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Selesaikan tahap untuk mendapatkan lebih banyak
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: CUBA LAGI
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Menang tahap!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Menang level untuk mendapatkan pemutar skru. Gunakan pemutar skru untuk membuka tab ini.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Cari kunci untuk mendapatkan ganjaran akhir!
    m_Metadata:
      m_Items: []
