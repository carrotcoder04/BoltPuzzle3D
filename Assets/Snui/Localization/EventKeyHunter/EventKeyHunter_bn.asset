  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: স্ক্রু ড্রাইভার সংগ্রহ করো!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: কী খুঁজুন!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: পুরস্কার উপার্জন করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: স্ক্রু ড্রাইভার ব্যবহারের এটাই তোমার শেষ সুযোগ।
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: কোন স্ক্রু ড্রাইভার অবশিষ্ট নেই!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "অভিনন্দন!\nআপনি কী শিকারী সম্পন্ন করেছেন!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: শুভকামনা
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: চালিয়ে যান
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: সর্বাধিক
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: যদি তুমি এখনই ছেড়ে দাও, তাহলে তোমার স্ক্রু ড্রাইভারগুলো হারাবে!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: পুরষ্কার জিততে তোমার কাছে স্ক্রু ড্রাইভার আছে!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: সব প্রকাশ করুন
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: কী শিকারী
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: আরও পেতে স্তর সম্পূর্ণ করুন
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: পুনরায় চেষ্টা করুন
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: স্তর জেতো!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: স্তর জিতে স্ক্রু ড্রাইভার নিন। এই ট্যাব আনলক করতে স্ক্রু ড্রাইভার ব্যবহার করুন।
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: চূড়ান্ত পুরস্কার পাওয়ার জন্য কী খুঁজুন!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
