  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: پیچ‌گوشتی جمع کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: کلیدها را پیدا کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: جوایز کسب کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: این آخرین شانس شما برای استفاده از پیچ‌گوشتی‌هاست.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: دیگر پیچ‌گوشتی باقی نمانده!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "تبریک می گویم!\nشما شکارچی کلید را تکمیل کردید!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: موفق باشید
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: به جلو ادامه دهید
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: حداکثر
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: اگر الآن تسلیم شوید، پیچ‌گوشتی‌هایتان را از دست خواهید داد!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: شما پیچ‌گوشتی دارید تا جوایز کسب کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: همه را نمایان کنید
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: شکارچی کلید
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: مراحل را کامل کنید تا بیشتر به دست آورید
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: دوباره تلاش کنید
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: سطح‌ها را ببرید!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: برای به‌دست آوردن پیچ‌گوشتی‌ها مراحل را ببرید. از پیچ‌گوشتی برای باز کردن این تب استفاده کنید.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: کلیدها را پیدا کنید تا جوایز نهایی را بگیرید!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
