    m_Localized: Vidaları kullanmak için son şansın.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Hiç vida kalmadı!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Tebrikler!\nANAHTAR AVCISI'nı tamamladın!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: İYİ ŞANS
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: DEVAM ET
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAKS
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Şimdi çıkarsan, vidalarını kaybedersin!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Ödüller kazanmak için vidaların var!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: HEPSİNİ GÖSTER
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: ANAHTAR AVCISI
    m_Metadata:
      m_Items: []
