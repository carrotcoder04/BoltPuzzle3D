  m_TableData:
  - m_Id: 626313388032
    m_Localized: 收集螺丝刀!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: 收集钥匙!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: 获得大奖!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: 这是使用螺丝刀的最后机会啦!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: 螺丝刀用完了!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "恭喜你!\n成功完成了钥匙猎人任务!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: 祝你好运
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: 继续加油
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: 最大
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: 如果现在退出，你将失去现有螺丝刀!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: 螺丝刀还没用完，快解锁奖励!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: 一键拧开
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: 钥匙猎人
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: 通关以获取螺丝刀
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: 再试一次
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: 赢得关卡!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: "通关获取螺丝刀，\n使用螺丝刀拧下板子。"
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: 寻找更多钥匙，赢取终极大奖!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
