  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: EventKeyHunter_zh-Hant
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: 收集螺絲起子!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: 收集鑰匙!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: 獲得大獎!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: 這是使用螺絲起子的最後機會啦!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: 螺絲起子用完了!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "恭喜你!\n成功完成了鑰匙獵人任務!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: 祝你好運
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: 繼續加油
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: 最大
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: 如果現在退出，你將失去現有螺絲起子!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: 螺絲起子還沒用完，快解鎖獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: 一鍵擰開
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: 鑰匙獵人
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: 通關以獲得螺絲起子
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: 再試一次
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: 贏得關卡!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: "通關取得螺絲起子，\n使用螺絲起子旋下板子。"
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: 尋找更多鑰匙，贏取終極大獎!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
