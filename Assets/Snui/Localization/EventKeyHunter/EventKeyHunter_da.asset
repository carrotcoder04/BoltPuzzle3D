  m_TableData:
  - m_Id: 626313388032
    m_Localized: Samle skruetrækker!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Find nøgler!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Tjen belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Dette er din sidste chance for at bruge skruetrækkere.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Ingen skruetrækkere tilbage!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Tillykke!\nDu har gennemført NØGLE JÆGER!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: GOD LYKKE
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: FORSAT
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAKSI
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Hvis du lukker nu, vil du miste dine skruetrækkere!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Du har skruetrækkere til at tjene belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: AFSLØR ALT
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: NØGLE JÆGER
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Fuldfør niveauer for at få mere
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: PRØV IGEN
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: VIND NIVEAUER!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Vind niveauer for at få skruetrækkere. Brug skruetrækkeren til at låse op for denne fane.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Find nøglerne for at få de endelige belønninger!
    m_Metadata:
      m_Items: []
