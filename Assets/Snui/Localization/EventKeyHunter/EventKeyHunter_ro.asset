    m_Localized: Colectează șurubelnițe!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Găsește chei!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Câștigă recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Aceasta este ultima ta șansă de a folosi șurubelnițele.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Nu mai ai șurubelnițe!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Felicitări!\nAi completat VÂNĂTORUL DE CHEI!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: BAFTĂ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: CONTINUĂ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Dacă pleci acum, vei pierde șurubelnițele!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Ai șurubelnițe pentru a câștiga recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: REVELEAZĂ TOT
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: VÂNĂTOR DE CHEI
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
