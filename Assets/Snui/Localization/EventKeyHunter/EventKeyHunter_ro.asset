    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: ÎNCERCAȚI DIN NOU
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Câștigă nivele!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Câștigă niveluri pentru a obține șuruburi. Folosește șurubul pentru a debloca această filă.
    m_Metadata:
      m_Items: []
