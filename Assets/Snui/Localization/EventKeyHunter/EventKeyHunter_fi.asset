  - m_Id: 626313388032
    m_Localized: Kerää ruuvimeisseli!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Löydä avaimet!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Ansaitse palkintoja!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Tämä on viimeinen mahdollisuus käyttää ruuvimeisseleitä.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Ei ruuvimeisseleitä jäljellä!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Onnittelut!\nSinä olet suorittanut AVAIMEN METSÄSTÄJÄN!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: ONNEA
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: JATKA
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAKS
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Jos lopetat nyt, menetät ruuvimeisseleitäsi!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Sinulla on ruuvimeisseleitä ansaitaksesi palkintoja!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: PALJASTA KAIKKI
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: AVAIMEN METSÄSTÄJÄ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Valmis tasoja saadaksesi lisää
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: YRITÄ UUDESTAAN
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Voita tasoja!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Voita tasoja saadaksesi ruuvimeisseleitä. Käytä ruuvimeisseliä avatakseesi tämä välilehti.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Löydä avaimet saadaksesi lopulliset palkinnot!
