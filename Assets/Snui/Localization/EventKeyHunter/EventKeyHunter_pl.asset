  - m_Id: 626313388032
    m_Localized: Zbieraj śrubokręty!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Znajdź klucze!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Zarobij nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: To twoja ostatnia szansa, aby użyć śrubokrętów.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Brak śrubokrętów!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Gratulacje!\nUkończyłeś ŁOWCĘ KLUCZY!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: POWODZENIA
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: NIE PODDAWAJ SIĘ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Jeśli teraz zrezygnujesz, stracisz swoje śrubokręty!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Masz śrubokręty, aby zdobywać nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: UJAWNIJ WSZYSTKO
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: ŁOWCA KLUCZY
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Ukończ poziomy, aby zdobyć więcej
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: SPRÓBUJ PONOWNIE
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Wygraj poziomy!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Wygrywaj poziomy, aby zdobyć wkrętaki. Użyj wkrętaka, aby odblokować tę zakładkę.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Znaleźć klucze, aby otrzymać ostateczne nagrody!
