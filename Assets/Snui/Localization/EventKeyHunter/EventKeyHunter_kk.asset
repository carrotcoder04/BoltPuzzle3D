  m_SharedData: {fileID: 11400000, guid: 87af58f7a2918874db9d4a82217c227f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 626313388032
    m_Localized: Бұрандалы кілттерді жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 626330165248
    m_Localized: Кілттерді табыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359552
    m_Localized: Сыйлықтарды алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 626334359553
    m_Localized: Бұрандалы кілттерді пайдалану үшін соңғы шанс.
    m_Metadata:
      m_Items: []
  - m_Id: 626338553856
    m_Localized: Бұрандалы кілттер қалған жоқ!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553857
    m_Localized: "Құттықтаймыз!\nСІЗ КЛЮЧ БАЛАНЫ АЯҚТАДЫҢЫЗ!"
    m_Metadata:
      m_Items: []
  - m_Id: 626338553858
    m_Localized: ЖАҚСЫ БАҚ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553859
    m_Localized: ЖАЛҒАСТЫРЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 626338553860
    m_Localized: МАКС
    m_Metadata:
      m_Items: []
  - m_Id: 626338553861
    m_Localized: Егер қазір шықсаңыз, бұрандалы кілттеріңізді жоғалтасыз!
    m_Metadata:
      m_Items: []
  - m_Id: 626338553862
    m_Localized: Сыйлықтарды алу үшін сізде бұрандалы кілттер бар!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748160
    m_Localized: БАРЛЫҚ СИЗДІ АНЫҚТАУ
    m_Metadata:
      m_Items: []
  - m_Id: 626342748161
    m_Localized: КЛЮЧ БАЛА
    m_Metadata:
      m_Items: []
  - m_Id: 626342748162
    m_Localized: Көбірек алу үшін деңгейлерді аяқтаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 626342748163
    m_Localized: ҚАЙТА ТЫРЫСАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 3765309530112
    m_Localized: Деңгейлерді жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 626342748164
    m_Localized: Деңгейлерді жеңіп, бұралмаларды алыңыз. Бұл қойындыны ашу үшін бұралманы пайдаланыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 626342748165
    m_Localized: Соңғы сыйлықтарды алу үшін кілттерді табыңыз!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
