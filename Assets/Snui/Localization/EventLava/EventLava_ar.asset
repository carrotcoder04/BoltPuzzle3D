  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'ستبدأ القفزة التالية في:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: اربح {0} مستوى دون الفشل في إكمال التحدي!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: لقد فشلت في التحدي. حظًا أفضل في المرة القادمة!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: ابدأ التحدي مع {0} لاعب!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: فز بالمستويات دون الفشل.
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: اكسب حصتك من العملات!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: المستويات
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: ابحث عن لاعبين في مستواك.
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: اللاعبون
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: أنت تشارك الجائزة مع {0} فائزين آخرين!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: لقد فزت!
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: انتهى {0}! حظًا أوفر في المرة القادمة!
    m_Metadata:
      m_Items:
      - rid: 1603597504982810695
  - m_Id: 26880132651147264
    m_Localized: اربح {0} مستوى لإكمال التحدي!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: هناك <color=#C8332D>{0} لاعب</color> في التحدي!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: اربح المستويات دون فشل للتقدم إلى المراحل التالية!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: سيتم توزيع <color=#C8332D>الجائزة الكبرى</color> بالتساوي بين <color=#C8332D>الفائزين!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: مبروك!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: القفز على المكعبات
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: القفز بين الأعمدة
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: القفز على الأعمدة
    m_Metadata:
      m_Items: []
