  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'پرش بعدی در:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: بدون شکست در تکمیل چالش، {0} مرحله را ببرید!
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} به پایان رسید! دفعه بعد شانس بیاورید!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810696
  - m_Id: 159155012007616512
    m_Localized: '<color=#C8332D>{0} بازیکن</color> در چالش وجود دارند!'
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: بدون شکست در مراحل بعدی پیروز شوید!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: جایزه بزرگ <color=#C8332D>به طور مساوی بین <color=#C8332D>برندگان تقسیم خواهد شد!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: شما در چالش شکست خوردید. دفعه بعد شانس بهتری خواهید داشت!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: چالش را با {0} بازیکن شروع کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: بدون شکست در مراحل پیروز شوید!
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: سهم خود را از سکه‌ها کسب کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: سطوح
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: به دنبال بازیکنانی در سطح خود هستم
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: بازیکنان
    m_Metadata:
      m_Items: []
  - m_Id: 26880132651147264
    m_Localized: برای تکمیل چالش، {0} مرحله را ببرید!
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: تبریک!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: شما برنده شدید!
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: شما پاداش را با {0} برنده دیگر به اشتراک می‌گذارید!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: پرش مکعب‌ها
