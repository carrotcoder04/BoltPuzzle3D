  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 下次挑戰開始倒數：
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: 連勝{0}關，即可完成挑戰!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: 很遺憾失敗了，下次好運!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: 與{0}名玩家同場開賽
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: 連續通關，保持不敗
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: 勝者瓜分大獎
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: 連勝關卡
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: 正在匹配玩家
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: 參與人數
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: 你將與另外{0}位得獎者瓜分獎金池!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: 你成功啦!
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: "{0}已結束!\n祝你下次好運!"
    m_Metadata:
      m_Items:
      - rid: 1603597504982810666
  - m_Id: 26880132651147264
    m_Localized: 連勝{0}關，即可完成挑戰!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: 挑戰已集結<color=#C8332D>{0}名玩家!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: 連勝的情況下通過一關即可前進一步!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>終極大獎</color>將由<color=#C8332D>獲勝者</color>平分!'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: 恭喜!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: 積木跳躍賽
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: 石柱跳躍賽
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: 圓柱跳躍賽
    m_Metadata:
      m_Items: []
