  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Następne Skakanie rozpocznie się za:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Wygraj {0} poziomów, nie ponosząc porażek w wyzwaniu!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Nie udało Ci się przejść wyzwania. Powodzenia następnym razem!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Rozpocznij wyzwanie z {0} graczami!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Wygraj poziomy bez porażki
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Zarób swoją część monet!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Poziomy
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Szukamy graczy na Twoim poziomie.
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Gracze
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Dzielisz nagrodę z {0} innymi zwycięzcami!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Wygrasz
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} się skończyło! Następnym razem więcej szczęścia!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810685
  - m_Id: 26880132651147264
    m_Localized: Wygraj {0} poziomów, aby ukończyć wyzwanie!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: W wyzwaniu bierze udział <color=#C8332D>{0} graczy</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Wygraj poziomy, nie ponosząc porażek w wyzwaniu, aby przejść do kolejnych etapów!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>Nagroda główna</color> zostanie podzielona po równo między <color=#C8332D>zwycięzców!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: GRATULACJE!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: SKACZĄCE KOSTKI
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
