  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Neste hopp vil starte om:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Vinn {0} nivåer uten å mislykkes med å fullføre utfordringen!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Du feilet utfordringen. Bedre lykke neste gang!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Start utfordringen med {0} spillere!
