  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Næste spring vil starte om:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Vind {0} niveauer uden at fejle for at fuldføre udfordringen!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Du mislykkedes udfordringen. Bedre held næste gang!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Start udfordringen med {0} spillere!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Vind niveauer uden at fejle
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Tjen din andel af mønter!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Niveauer
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Leder efter spillere på dit niveau
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Spillere
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Du deler belønningen med {0} andre vindere!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Du vinder
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} er slut! Bedre held næste gang!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810668
  - m_Id: 26880132651147264
    m_Localized: Vind {0} niveauer for at fuldføre udfordringen!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Der er <color=#C8332D>{0} spillere</color> i udfordringen!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Vind niveauer uden at fejle for at gå videre til de næste trin!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>hovedpræmien</color> deles ligeligt mellem <color=#C8332D>vinderne!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: TILLYKKE!
    m_Metadata:
      m_Items: []
