  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'הקפיצה הבאה תתחיל בעוד:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: זכו ב-{0} רמות מבלי להיכשל בהשלמת האתגר!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: נכשלת באתגר. בהצלחה בפעם הבאה!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: התחילו את האתגר עם {0} שחקנים!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: נצח רמות מבלי להיכשל.
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: הרוויח את חלקך במטבעות!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: דרגות
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: מחפשים שחקנים ברמה שלכם
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: שחקנים
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: אתה משתף את הפרס עם {0} מנצחים אחרים!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: ניצחת
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} נגמר! בהצלחה בפעם הבאה!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810697
  - m_Id: 26880132651147264
    m_Localized: זכו ב-{0} רמות כדי להשלים את האתגר!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: יש <color=#C8332D>{0} שחקנים</color> באתגר!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: זכו ברמות מבלי להיכשל כדי להתקדם לשלבים הבאים!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: ה<color=#C8332D>פרס הגדול</color> יחולק שווה בשווה בין <color=#C8332D>הזוכים!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: מזל טוב!
    m_Metadata:
