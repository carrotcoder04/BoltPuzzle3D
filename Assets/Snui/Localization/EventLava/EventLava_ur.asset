  m_SharedData: {fileID: 11400000, guid: 08c21e7866fc7f240a80c30d403d01db, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1603597504982810698
  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'اگلا چھلانگ شروع ہوگا:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: چیلنج کو مکمل کرنے میں ناکام ہوئے بغیر {0} سطحیں جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: آپ چیلنج میں ناکام ہوگئے۔ اگلی بار بہتر قسمت!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: '{0} کھلاڑیوں کے ساتھ چیلنج شروع کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: یادیں بغیر ناکام ہوئے جیتیں۔
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: اپنا حصہ کے سکوں حاصل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: سطحیں
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: آپ کی سطح پر کھلاڑیوں کی تلاش ہے۔
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: کھلاڑی
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: آپ {0} دوسرے فاتحین کے ساتھ انعام بانٹ رہے ہیں!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: آپ جیت گئے
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} ختم! اگلی بار خوش قسمتی ہو!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810698
  - m_Id: 26880132651147264
    m_Localized: چیلنج مکمل کرنے کے لیے {0} سطحیں جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: چیلنج میں <color=#C8332D>{0} کھلاڑی</color> ہیں!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: اگلے مراحل تک آگے بڑھنے میں ناکام ہوئے بغیر سطحیں جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>عظیم انعام</color> کو <color=#C8332D>جیتنے والوں کے درمیان برابر تقسیم کیا جائے گا!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: مبارک ہو!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: مکعبوں کا چھلانگ لگانا
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: ستونوں کا چھلانگ لگانا
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: ستونوں کا چھلانگ لگانا
    m_Metadata:
      m_Items: []
  - m_Id: 43493735013539840
    m_Localized: مکعبوں کا چھلانگ لگانا
    m_Metadata:
      m_Items: []
  - m_Id: 43493762054217728
    m_Localized: ستونوں کا چھلانگ لگانা
    m_Metadata:
      m_Items: []
  - m_Id: 43493766349185024
    m_Localized: ستونوں کا چھلانگ لگانا
    m_Metadata:
      m_Items: []
