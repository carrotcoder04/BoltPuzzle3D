  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Următoarea saritură va începe în:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Câștigă {0} niveluri fără a rata finalizarea provocării!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Ai eșuat provocarea. Mai mult noroc data viitoare!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Începe provocarea cu {0} jucători!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Câștigă niveluri fără să pierzi.
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Câștigă partea ta de monede!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Niveluri
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Caut jucători de nivelul tău
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Jucători
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Împarți recompensa cu alți {0} câștigători!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Ai câștigat
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} s-a terminat! Mai mult noroc data viitoare!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810688
  - m_Id: 26880132651147264
    m_Localized: Câștigă {0} niveluri pentru a finaliza provocarea!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Sunt <color=#C8332D>{0} jucători</color> în provocare!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Câștigă niveluri fără a rata pentru a avansa la etapele următoare!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>Marele premiu</color> va fi împărțit în mod egal între <color=#C8332D>câștigătorii!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: FELICITĂRI!
