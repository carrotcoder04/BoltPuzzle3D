    - rid: 1603597504982810670
  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Η επόμενη εκτόξευση θα ξεκινήσει σε:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Κερδίστε {0} επίπεδα χωρίς να αποτύχετε να ολοκληρώσετε την πρόκληση!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Απέτυχες στην πρόκληση. Καλή τύχη την επόμενη φορά!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Ξεκινήστε την πρόκληση με {0} παίκτες!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Κερδίστε επίπεδα χωρίς να αποτύχετε
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Κερδίστε το μερίδιό σας από νομίσματα!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Επίπεδα
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Ψάχνετε για παίκτες στο επίπεδό σας
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Παίκτες
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Μοιράζεστε το έπαθλο με {0} άλλους νικητές!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Κέρδισες
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: Το {0} τελείωσε! Καλή τύχη την επόμενη φορά!
    m_Metadata:
      m_Items:
      - rid: 1603597504982810670
  - m_Id: 26880132651147264
    m_Localized: Κερδίστε {0} επίπεδα για να ολοκληρώσετε την πρόκληση!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Υπάρχουν <color=#C8332D>{0} παίκτες</color> στην πρόκληση!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Κερδίστε επίπεδα χωρίς να αποτύχετε να προχωρήσετε στα επόμενα βήματα!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: Το <color=#C8332D>μεγάλο βραβείο</color> θα μοιραστεί εξίσου μεταξύ των <color=#C8332D>νικητών!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: Συγχαρητήρια!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: ΚΥΒΟΙ ΠΟΥ ΠΗΔΟΥΝ
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: ΣΤΗΛΕΣ ΠΟΥ ΠΗΔΟΥΝ
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: ΚΙΟΝΕΣ ΠΟΥ ΠΗΔΟΥΝ
    m_Metadata:
      m_Items: []
  - m_Id: 43493735013539840
    m_Localized: κυβοι που πηδουν
    m_Metadata:
      m_Items: []
  - m_Id: 43493762054217728
    m_Localized: στήλες που πηδουν
    m_Metadata:
      m_Items: []
  - m_Id: 43493766349185024
    m_Localized: κιονες που πηδουν
    m_Metadata:
      m_Items: []
  - m_Id: 141778790256730112
    m_Localized: ΑΝΑΠΗΔΗΤΗ ΕΦΟΔΟΣ
    m_Metadata:
      m_Items: []
  - m_Id: 141778790294478848
    m_Localized: Αναπηδητή έφοδος
    m_Metadata:
      m_Items: []
