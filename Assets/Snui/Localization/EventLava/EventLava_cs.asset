    m_Metadata:
      m_Items:
      - rid: 1603597504982810667
  - m_Id: 26880132651147264
    m_Localized: Vyhrajte {0} úrovní pro dokončení výzvy!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: V výzvě je <color=#C8332D>{0} hráčů</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Vyhrajte úrovně bez nutnosti dokončit výzvu, abyste postoupili do dalších kroků!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>Hlavní cena</color> bude rozdělena rovným dílem mezi <color=#C8332D>vítěze!</color>'
    m_Metadata:
      m_Items: []
