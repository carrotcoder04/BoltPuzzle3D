  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Další skok začne za:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Vyhrajte {0} úrovní bez nutnosti dokončit výzvu!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Výzva nebyla splněna. Příště více štěstí!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Začněte výzvu s {0} hráči!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Vyhraj úrovně bez prohry.
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Získej svůj podíl mincí!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Úrovně
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Hledáme hráče na vaší úrovni
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
