  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 下次挑战开始倒计时：
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: 连胜{0}关，即可完成挑战!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: 很遗憾失败了，下次好运!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: 与{0}名玩家同场开赛
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: 连续通关，保持不败
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: 胜者瓜分大奖
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: 连胜关卡
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: 正在匹配玩家
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: 参与人数
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: 你将与另外{0}位获胜者瓜分奖池!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: 你成功啦!
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: "{0}已结束!\n祝你下次好运!"
    m_Metadata:
      m_Items:
      - rid: 1603597504982810665
  - m_Id: 26880132651147264
    m_Localized: 连胜{0}关，即可完成挑战!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: 挑战已集结<color=#C8332D>{0}名玩家!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: 连胜的情况下通过一关即可前进一步!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>终极大奖</color>将由<color=#C8332D>获胜者</color>平分!'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: 恭喜!
    m_Metadata:
      m_Items: []
