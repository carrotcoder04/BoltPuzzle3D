  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Nhảy tiếp theo sẽ bắt đầu trong:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Thắng {0} màn chơi mà không bỏ lỡ thử thách!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Bạn đã thất bại trong thử thách. Chúc may mắn lần sau!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Bắt đầu thử thách với {0} người chơi!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Chiến thắng các cấp độ mà không thất bại
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Kiếm được số tiền của bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Cấp độ
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Tìm kiếm người chơi cùng cấp độ với bạn
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Người chơi
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Bạn đang chia sẻ phần thưởng với {0} người chiến thắng khác!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Bạn đã chiến thắng
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} đã kết thúc! Lần sau may mắn hơn nhé!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810694
  - m_Id: 26880132651147264
    m_Localized: Thắng {0} màn chơi để hoàn thành thử thách!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Có <color=#C8332D>{0} người chơi</color> trong thử thách!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Thắng màn chơi mà không bỏ lỡ để tiến tới các bước tiếp theo!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>Giải thưởng lớn</color> sẽ được chia đều cho <color=#C8332D>người chiến thắng!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: XIN CHÚC MỪNG!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: KHỐI NHẢY
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: CỘT NHẢY
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: TRỤ NHẢY
    m_Metadata:
      m_Items: []
