  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Seuraava hyppääminen alkaa:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Voita {0} tasoa läpäisemättä haastetta!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Epäonnistuit haasteessa. Parempaa onnea ensi kerralla!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Aloita haaste {0} pelaajalla!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Voita tasot ilman epäonnistumisia
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Ansaitse osuutesi kolikoista!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Tasot
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Etsitään samantasoisia pelaajia
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Pelaajat
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Jaat palkinnon {0} muun voittajan kanssa!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Voitit
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} on päättynyt! Onnea ensi kerralla!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810672
  - m_Id: 26880132651147264
    m_Localized: Voita {0} tasoa läpäistäksesi haasteen!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Haasteessa on <color=#C8332D>{0} pelaajaa</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Voita tasoja läpäistäksesi haasteen ja edetäksesi seuraaviin vaiheisiin!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>Pääpalkinto</color> jaetaan tasan <color=#C8332D>voittajien</color> kesken!'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: ONNEKSI OLKOON!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
