  m_SharedData: {fileID: 11400000, guid: 08c21e7866fc7f240a80c30d403d01db, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1603597504982810691
  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'การกระโดดครั้งถัดไปจะเริ่มใน:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: ชนะ {0} เลเวลโดยไม่ล้มเหลวในการผ่านภารกิจ!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: คุณล้มเหลวในการท้าทาย โชคดีในครั้งต่อไป!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: เริ่มภารกิจด้วยผู้เล่น {0} คน!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: ชนะระดับโดยไม่ล้มเหลว
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: รับส่วนแบ่งเหรียญ!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: ระดับ
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: กำลังมองหาผู้เล่นที่อยู่ในระดับเดียวกับคุณ
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: ผู้เล่น
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: คุณกำลังแบ่งปันรางวัลกับผู้ชนะอื่น {0} คน!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: คุณชนะแล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} จบแล้ว! ครั้งหน้าขอให้โชคดี!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810691
  - m_Id: 26880132651147264
    m_Localized: ชนะ {0} เลเวลเพื่อทำภารกิจให้สำเร็จ!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: มีผู้เล่น <color=#C8332D>{0} คน</color> ในภารกิจนี้!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: ชนะเลเวลโดยไม่ล้มเหลวในการผ่านไปยังขั้นต่อไป!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: '<color=#C8332D>รางวัลใหญ่</color> จะถูกแบ่งเท่าๆ กันระหว่าง <color=#C8332D>ผู้ชนะ!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: ยินดีด้วย!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: ลูกบาศก์กระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: คอลัมน์กระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: เสากระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 43493735013539840
    m_Localized: ลูกบาศก์กระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 43493762054217728
    m_Localized: คอลัมน์กระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 43493766349185024
    m_Localized: เสากระโดด
    m_Metadata:
      m_Items: []
  - m_Id: 141778790256730112
    m_Localized: เด้งพุ่งทะยาน
    m_Metadata:
      m_Items: []
