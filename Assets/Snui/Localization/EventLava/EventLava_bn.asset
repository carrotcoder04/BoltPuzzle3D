  m_SharedData: {fileID: 11400000, guid: 08c21e7866fc7f240a80c30d403d01db, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1603597504982810664
  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'পরবর্তী জাম্পিং শুরু হবে:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: চ্যালেঞ্জটি সম্পূর্ণ করতে ব্যর্থ না হয়ে {0}টি লেভেল জিতুন!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: আপনি চ্যালেঞ্জে ব্যর্থ হয়েছেন। পরেরবার আরো ভালো করবেন!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: '{0} জন খেলোয়াড় দিয়ে চ্যালেঞ্জ শুরু করুন!'
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: ব্যর্থ না হয়ে লেভেল জিতুন।
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: আপনার অংশের কয়েন জিতুন!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: লেভেলসমূহ
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: আপনার লেভেলের খেলোয়াড় খুঁজছেন
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: খেলোয়াড়গণ
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: আপনি {0} জন বিজয়ীর সঙ্গে পুরস্কার ভাগ করছেন!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: আপনি জয়ী হয়েছেন
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: '{0} শেষ হয়েছে! পরবর্তীতে ভাগ্য ভালো হোক!'
    m_Metadata:
      m_Items:
      - rid: 1603597504982810664
  - m_Id: 26880132651147264
    m_Localized: চ্যালেঞ্জটি সম্পূর্ণ করতে {0}টি লেভেল জিতুন!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: চ্যালেঞ্জে <color=#C8332D>{0} জন খেলোয়াড়</color> আছে!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: পরবর্তী ধাপে অগ্রসর হতে ব্যর্থ না হয়ে লেভেল জিতুন!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: "<color=#C8332D>মহাপুরস্কার</color> <color=#C8332D>বিজয়ীদের</color> মধ্যে\nসমানভাবে ভাগ করা হবে!"
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: অভিনন্দন!
    m_Metadata:
      m_Items: []
  - m_Id: 43493591639646208
    m_Localized: ঘনক লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 43493656198373376
    m_Localized: কলাম লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 43493696933453824
    m_Localized: স্তম্ভ লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 43493735013539840
    m_Localized: ঘনক লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 43493762054217728
    m_Localized: কলাম লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 43493766349185024
    m_Localized: স্তম্ভ লাফাচ্ছে
    m_Metadata:
      m_Items: []
  - m_Id: 141778790256730112
    m_Localized: বাউন্সি রাশ
    m_Metadata:
      m_Items: []
