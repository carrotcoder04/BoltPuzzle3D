  m_TableData:
  - m_Id: 159505708477308928
    m_Localized: 'Susunod na Jumping ay magsisimula sa:'
    m_Metadata:
      m_Items: []
  - m_Id: 27276818049392640
    m_Localized: Manalo ng {0} na antas nang hindi nabigo upang makumpleto ang hamon!
    m_Metadata:
      m_Items: []
  - m_Id: 29338599487954944
    m_Localized: Hindi mo pinalampas ang hamon. Mas malas sa susunod!
    m_Metadata:
      m_Items: []
  - m_Id: 28239245050109952
    m_Localized: Simulan ang hamon sa {0} mga manlalaro!
    m_Metadata:
      m_Items: []
  - m_Id: 28239359034515456
    m_Localized: Makakuha ng mga antas nang walang pagkabigo
    m_Metadata:
      m_Items: []
  - m_Id: 28239395415908352
    m_Localized: Makakuha ng bahagi ng mga barya!
    m_Metadata:
      m_Items: []
  - m_Id: 28008956788989952
    m_Localized: Mga Antas
    m_Metadata:
      m_Items: []
  - m_Id: 27976254979301376
    m_Localized: Naghahanap ng mga manlalaro sa iyong antas
    m_Metadata:
      m_Items: []
  - m_Id: 28008534560989184
    m_Localized: Mga Players
    m_Metadata:
      m_Items: []
  - m_Id: 28240243852304384
    m_Localized: Ikaw ay nagbabahagi ng premyo kasama ang {0} iba pang mga nanalo!
    m_Metadata:
      m_Items: []
  - m_Id: 28240163988561920
    m_Localized: Ikaw ang nanalo
    m_Metadata:
      m_Items: []
  - m_Id: 159534441011601408
    m_Localized: Tapos na ang {0}! Sana susunod swerte ka!
    m_Metadata:
      m_Items:
      - rid: 1603597504982810673
  - m_Id: 26880132651147264
    m_Localized: Manalo ng {0} na antas upang makumpleto ang hamon!
    m_Metadata:
      m_Items: []
  - m_Id: 159155012007616512
    m_Localized: Mayroong <color=#C8332D>{0} mga manlalaro</color> sa hamon!
    m_Metadata:
      m_Items: []
  - m_Id: 159155983760744448
    m_Localized: Manalo ng mga antas nang hindi nabigo na sumulong sa mga susunod na hakbang!
    m_Metadata:
      m_Items: []
  - m_Id: 159156661325389824
    m_Localized: Ang <color=#C8332D>pangunahing premyo</color> ay ibabahagi nang pantay sa mga <color=#C8332D>mga nanalo!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 28239984476545024
    m_Localized: CONGRATS!
    m_Metadata:
      m_Items: []
