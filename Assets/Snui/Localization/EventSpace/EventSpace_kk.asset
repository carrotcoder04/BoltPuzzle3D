  m_TableData:
  - m_Id: 12850290688
    m_Localized: ҒАРЫШ ЖАРЫСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 362658975965184
    m_Localized: ЖАРЫСҚА ҚОСЫЛЫҢЫЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 705781535072256
    m_Localized: Шектеулі уақыт ішінде жұлдыздар жинаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 705880910716928
    m_Localized: Миссияны аяқтау үшін басқалардан бұрын жұлдыздар алыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 705922719539200
    m_Localized: Керемет сыйлықтар алаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1817044948344832
    m_Localized: САТЫ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1820701395771392
    m_Localized: Бірінші болып, керемет сыйлықтарды жеңіп алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 3365873879343104
    m_Localized: Ойыншыларды іздеу...
    m_Metadata:
      m_Items: []
  - m_Id: 5486405265383424
    m_Localized: Қайта көріңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 5486452900093952
    m_Localized: Келесі жолы бірінші болыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 5490799222448128
    m_Localized: ҚҰТТЫҚТАЙМЫН!
    m_Metadata:
      m_Items: []
  - m_Id: 5490866880765952
    m_Localized: Сіз бірінші болып аяқтадыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 38765328639975424
    m_Localized: ҒАРЫШ ЖАРЫСЫ
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
