  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Kumpul bunga untuk buka hadiah dan bertanding di <color=#FFEE2B>Arena Taman</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Menang tahap tanpa gagal untuk meningkatkan pendarab skor!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Kerja hebat! Tahniah!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Peningkatan pendarab skor anda akan diset semula!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: GANJARAN
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ARENA TAMAN
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Menang tahap!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Tingkatkan pendarab skor tanpa gagal!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Perolehi ganjaran yang menakjubkan!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: PANGKAT ANDA
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Anda akan kehilangan kemajuan <color=#C31439>multiplikasi!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Ganjaran peribadi: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Selesai!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Usaha untuk ganjaran lain kali!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Hadiah hebat!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Arena Taman\nHadiah Peribadi"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: ARENA BURGER
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Kumpul burger untuk membuka kunci ganjaran dan bertanding di <color=#FFEE2B>Arena Burger!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "ARENA BURGER\nGANJARAN PERIBADI"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: ARENA KUCING
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Kumpul tin untuk membuka ganjaran dan bertanding dalam <color=#{0}>ARENA KUCING</color>!
    m_Metadata:
      m_Items:
