  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Çiçek toplayarak ödüllerin kilidini aç ve <color=#FFEE2B>Bahçe Arena</color>'da yarış!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Seviyeleri başarısız olmadan geçerek puan çarpanınızı artırın!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Harika iş! Tebrikler!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Skor çarpanı ilerlemeniz sıfırlanacak!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: ÖDÜLLER
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: BAHÇE ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Seviyeleri Geç!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Skor çarpanını düşürmeden artır!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: İnanılmaz Ödüller Kazan!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: SIRANIZ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: '<color=#C31439>çarpan ilerlemenizi kaybedeceksiniz!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Kişisel ödüller: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Tamamlandı!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Sonraki sefere ödüllerin peşinden git!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Muhteşem ödül!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Bahçe Arena\nKişisel Ödüller"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: BURGER ARENASI
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Ödüllerin kilidini açmak için burger topla ve <color=#FFEE2B>Burger Arenası'nda</color> yarış!
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "BURGER ARENA\nKİŞİSEL ÖDÜLLER"
    m_Metadata:
      m_Items: []
