  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: 收集花束、解鎖獎勵，挑戰<color=#FFEE2B>花園爭霸賽! </color>
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: 保持連勝來提升分數倍率!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: 幹得漂亮!恭喜!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: 分數倍率將清零!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: 獎勵
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: 花園爭霸賽
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: 成功通關!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: 連勝不斷，分數倍率更高!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: 獲取豐厚獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: 你的排名
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: 你將失去<color=#C31439>倍數進度! </color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 個人獎勵：{0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: 已完成!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: 下次再戰，衝擊大獎!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: 豪華大獎!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "花園爭霸賽\n個人獎勵"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: 漢堡競技場
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: 收集漢堡以解鎖獎勵，並在<color=#FFEE2B>漢堡競技場</color>中一較高下！
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "漢堡競技場\n個人獎勵"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: 喵喵競技場
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: 收集罐頭解鎖獎勵，並在 <color=#{0}>喵喵競技場</color> 中一較高下！
    m_Metadata:
