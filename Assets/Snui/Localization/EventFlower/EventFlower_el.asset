  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: EventFlower_el
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: el
  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594988
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Σύλλεγε λουλούδια για ξεκλείδωμα ανταμοιβών και αγωνίσου στην <color=#FFEE2B>Αρένα Κήπου</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Κέρδισε επίπεδα χωρίς να αποτύχεις για να αυξήσεις τον πολλαπλασιαστή βαθμολογίας!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Καλή δουλειά! Συγχαρητήρια!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Η πρόοδος του πολλαπλασιαστή βαθμολογίας θα επαναφερθεί!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: ΕΠΑΘΛΑ
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ΑΡΕΝΑ ΚΗΠΟΥ
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Κέρδισε επίπεδα!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Αύξησε τον πολλαπλασιαστή βαθμολογίας χωρίς να αποτύχεις!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Κέρδισε εκπληκτικά έπαθλα!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: Η ΒΑΘΜΟΛΟΓΙΑ ΣΟΥ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Θα χάσετε την πρόοδο <color=#C31439> πολλαπλασιαστή!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Προσωπικές ανταμοιβές: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Ολοκληρώθηκε!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Πηγαίνετε για τις ανταμοιβές την επόμενη φορά!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Τεράστιο Βραβείο!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Αρένα Κήπου\nΠροσωπικές Ανταμοιβές"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: ΑΡΕΝΑ ΜΠΕΡΓΚΕΡ
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Συλλέξτε μπιφτέκια για να ξεκλειδώσετε ανταμοιβές και να αγωνιστείτε στην <color=#FFEE2B>Burger Arena!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "ΑΡΕΝΑ ΜΠΕΡΓΚΕΡ\nΠΡΟΣΩΠΙΚΕΣ ΑΝΤΑΜΟΙΒΕΣ"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: ΑΡΕΝΑ ΓΑΤΩΝ
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Μάζεψε κονσέρβες για να ξεκλειδώσεις ανταμοιβές και να διαγωνιστείς στην <color=#{0}>ΑΡΕΝΑ ΓΑΤΩΝ</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594988
  - m_Id: 271744063847260160
    m_Localized: "ΑΡΕΝΑ ΓΑΤΩΝ\nΠΡΟΣΩΠΙΚΕΣ ΑΜΟΙΒΕΣ"
    m_Metadata:
      m_Items: []
