  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594983
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: फूल इकट्ठा कर इनाम अनलॉक करें और <color=#FFEE2B>गार्डन एरेना</color> में प्रतिस्पर्धा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: बिना असफल हुए स्तर जीतने पर स्कोर गुणक बढ़ाएँ!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: बहुत बढ़िया काम! बधाई हो!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: आपका स्कोर गुणक प्रगति रीसेट हो जाएगा!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: पुरस्कार
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: गार्डन एरेना
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: स्तर जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: बिना असफल हुए स्कोर गुणक बढ़ाएं!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: अद्भुत पुरस्कार अर्जित करें!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: आपका रैंक
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: आप अपनी <color=#C31439>गुणा प्रगति खो देंगे!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'व्यक्तिगत पुरस्कार: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: पूरा हुआ!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: अगली बार पुरस्कारों के लिए प्रयास करें!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: भव्य इनाम!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "गार्डन एरेना\nव्यक्तिगत इनाम"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: बर्गर एरिना
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: इनाम अनलॉक करने के लिए बर्गर इकट्ठा करें और <color=#FFEE2B>बर्गर एरिना</color> में मुकाबला करें!
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "बर्गर एरिना\nनिजी इनाम"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: बिल्ली अरीना
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: रिवॉर्ड अनलॉक करने और <color=#{0}>बिल्ली अरीना</color> में प्रतिस्पर्धा करने के लिए कैन इकट्ठा करें!
    m_Metadata:
      m_Items:
      - rid: 168417876528594983
  - m_Id: 271744063847260160
    m_Localized: "बिल्ली अरीना\nव्यक्तिগত पुरस्कार"
    m_Metadata:
      m_Items: []
