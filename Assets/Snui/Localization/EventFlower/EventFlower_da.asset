  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Saml blomster for at låse belønninger op og konkurrer i <color=#FFEE2B>Have Arena</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Vælg niveauer uden at mislykkes for at øge scoremultiplikatoren!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Godt klaret! Tillykke!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Din scoremultiplikator fremskridt vil blive nulstillet!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: PRÆMIER
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
