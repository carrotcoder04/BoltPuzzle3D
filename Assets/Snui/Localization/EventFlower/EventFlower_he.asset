  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: '!אסוף פרחים כדי לפתוח פרסים ולהתחרות ב<color=#FFEE2B>זירת הגן</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: נצח שלבים והימנע מכישלון כדי להגדיל את מכפיל הניקוד שלך!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: עבודה מצוינת! מזל טוב!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: ההתקדמות שלך במכפיל הניקוד תתאפס!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: REWARDS
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: זירה גן
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: נצח שלבים!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: הגדל את מכפיל הניקוד מבלי להיכשל!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: הרווח פרסים מדהימים!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: הדירוג שלך
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: תאבד את <color=#C31439>ההתקדמות שלך במכפיל!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'פרסים אישיים: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: הושלם!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: לך על הפרסים בפעם הבאה!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: פרס ענק!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "זירה גן\nפרסים אישיים"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: זירת המבורגרים
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: אספו המבורגרים כדי לפתוח פרסים ולהתחרות ב<color=#FFEE2B>זירת המבורגרים!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "זירת המבורגרים\nפרסים אישיים"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: זירת החתולים
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: אספו פחיות כדי לפתוח פרסים ולהתחרות ב-<color=#{0}>זירת החתולים</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594961
  - m_Id: 271744063847260160
    m_Localized: "זירת החתולים\nפרסים אישיים"
    m_Metadata:
      m_Items: []
