  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594979
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: 花を集めて報酬をゲット！<color=#FFEE2B>ガーデンアリーナ</color>で勝負しよう！
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: 失敗せずにステージをクリアしてスコア倍率を上げよう！
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: お見事！おめでとう！
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: スコア倍率の進行状況はリセットされます！
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: 報酬
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ガーデンアリーナ
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: レベルをクリア！
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: 失敗せずにスコア倍率をアップグレードしよう！
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: 豪華報酬をゲットしよう！
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: あなたのランク
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: '<color=#C31439>スコア倍率の進行状況</color>を失います！'
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: '個人報酬: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: 完了！
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: 次こそは報酬を！
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: 特賞！
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "ガーデンアリーナ\nパーソナル報酬"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: バーガーアリーナ
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: バーガーを集めて報酬をアンロックし、<color=#FFEE2B>バーガーアリーナ！</color>で競い合おう！
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: バーガーアリーナ個人報酬
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: にゃんこアリーナ
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: 缶を集めて報酬をアンロックし、<color=#{0}>にゃんこアリーナ</color> で競い合おう！
    m_Metadata:
      m_Items:
      - rid: 168417876528594979
  - m_Id: 271744063847260160
    m_Localized: "にゃんこアリーナ\n個人報酬"
    m_Metadata:
      m_Items: []
