  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Kerää kukkia avataksesi palkinnot ja kilpaile <color=#FFEE2B>Puutarhataistelussa</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Voita tasoja epäonnistumatta kasvattaaksesi pistekerrointa!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Hienoa työtä! Onneksi olkoon!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Pistekerroin nollaantuu!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: PALKINTIOT
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: PUUTARHATAISTELU
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Voita tasoja!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Nosta pistekerrointa epäonnistumatta!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Ansaitse upeita palkintoja!
