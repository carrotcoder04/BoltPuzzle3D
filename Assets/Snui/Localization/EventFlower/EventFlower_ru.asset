  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594969
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Собирайте цветы, открывайте награды и сражайтесь на <color=#FFEE2B>Цветочной Арене</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Проходите уровни без поражений, чтобы увеличить множитель очков!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Молодец! Поздравляем!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Ваш прогресс множителя очков будет сброшен!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: НАГРАДЫ
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ЦВЕТОЧНЫЙ ПОРЫВ
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Выигрывайте уровни!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Продолжайте побеждать, чтобы увеличить множитель очков!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Зарабатывайте удивительные награды!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: ВАШ РЕЙТИНГ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Вы потеряете свой <color=#C31439>прогресс в умножителе!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Личные Награды: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Завершено!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: В следующий раз поборитесь за призы!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Крупная награда!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Цветочный Порыв\nЛичные Награды"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: БУРГЕР АРЕНА
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Собирайте бургеры, чтобы получать награды и соревноваться на <color=#FFEE2B>Бургер Арене!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "БУРГЕР АРЕНА\nЛИЧНЫЕ НАГРАДЫ"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: АРЕНА КОТОВ
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Собирайте банки, чтобы открыть награды и соревноваться на <color=#{0}>АРЕНА КОТОВ</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594969
  - m_Id: 271744063847260160
    m_Localized: "АРЕНА КОТОВ\nЛИЧНЫЕ НАГРАДЫ"
    m_Metadata:
      m_Items: []
