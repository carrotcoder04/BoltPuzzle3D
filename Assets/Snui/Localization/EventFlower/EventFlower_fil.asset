  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Mag-ipon ng mga bulaklak para ma-unlock ang rewards at makipaglaban sa <color=#FFEE2B>Hardin na Arena</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Manalo sa mga antas nang hindi nabibigo upang madagdagan ang multiplier ng marka!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Magandang trabaho! Binabati kita!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Maii-reset ang progreso ng iyong multiplier ng puntos!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: Mga gantimpala
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: HARDIN NA ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Panalo sa mga antas!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Palakihin ang multiplier ng puntos nang hindi nabibigo!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Kumita ng kamangha-manghang mga gantimpala!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: Ang iyong ranggo
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Mawawala ang iyong <color=#C31439>pag-unlad sa multiplie!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Mga personal na gantimpala: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Tapos na!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Pursige ang mga gantimpala sa susunod na pagkakataon!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Napakalaking premyo!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Hardin na Arena\nPersonal na Mga Gantimpala"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: BURGER ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Mangolekta ng mga burger para ma-unlock ang mga reward at makipagkumpetensya sa <color=#FFEE2B>Burger Arena!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "BURGER ARENA\nMGA PERSONAL NA GANTIMPALA"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: ARENA NG PUSA
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Mangolekta ng mga lata para mag-unlock ng rewards at makipagkompetensya sa <color=#{0}>ARENA NG PUSA</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594985
