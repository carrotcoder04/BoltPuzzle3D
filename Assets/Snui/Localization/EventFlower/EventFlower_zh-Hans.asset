  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: 收集花束、解锁奖励，挑战<color=#FFEE2B>花园争霸赛!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: 保持连胜来提升得分倍率!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: 干得漂亮!恭喜!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: 分数倍率将清零!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: 奖励
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: 花园争霸赛
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: 成功通关!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: 连胜不断，分数倍率更高!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: 获取丰厚奖励!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: 你的排名
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: 你将失去<color=#C31439>倍率进度!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 个人奖励：{0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: 已完成!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: 下次再战，冲击大奖!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: 豪华大奖!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "花园争霸赛\n个人奖励"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
