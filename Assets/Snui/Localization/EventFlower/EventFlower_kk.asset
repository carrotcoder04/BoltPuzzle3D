  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: EventFlower_kk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: kk
  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594978
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Гүл теріп, сыйлықтарды ашыңыз және <color=#FFEE2B>Бақша Аренасында</color> жарысыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Deñgeýlerdi jeñip, sätsizdikten aýyryq bolu arqyly siziñ bal mułtiplikatoryñyzdy arttyryñyzdar!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Керемет жұмыс! Құттықтаймыз!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Сіздің ұпай көбейткішіңіздің прогрессі қайта орнатылады!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: СЫЙЛЫҚТАР
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: БАҚША АРЕНАСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Деңгейлерді жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Ұпай көбейткішін сәтсіздіксіз арттырыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Керемет сыйлықтар алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: СІЗДІҢ ОРЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Сіз <color=#C31439> көбейтуді жоғалтасыз!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Жеке марапаттар: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Аяқталды!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Келесі жолы сыйлықтарға барыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Үлкен сыйлық!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Бақша Аренасы\nЖеке Сыйлықтар"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: БУРГЕР АРЕНАСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Сыйақыларды ашу және <color=#FFEE2B>Бургер Аренасында бәсекелесу үшін бургерлерді жинаңыз!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "БУРГЕР АРЕНАСЫ\nЖЕКЕ СЫЙАҚЫЛАР"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: МЫСЫҚТАР АРЕНАСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Сыйлықтардың құлпын ашу және <color=#{0}>МЫСЫҚТАР АРЕНАСЫ</color> ішінде бәсекелесу үшін банкалар жинаңыз!
    m_Metadata:
      m_Items:
      - rid: 168417876528594978
  - m_Id: 271744063847260160
    m_Localized: "МЫСЫҚТАР АРЕНАСЫ\nЖЕКЕ СЫЙЛЫҚТАР"
    m_Metadata:
      m_Items: []
