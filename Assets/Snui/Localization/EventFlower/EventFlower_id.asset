  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Kumpulkan bunga untuk membuka hadiah dan bersaing di <color=#FFEE2B>Arena Taman</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Menangkan level dan hindari gagal untuk meningkatkan pengganda skor Anda
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Kerja bagus! Selamat!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Proges pengganda skor Anda akan reset!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: HADIAH
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
