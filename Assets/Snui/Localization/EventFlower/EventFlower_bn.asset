  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594994
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: ফুল সংগ্রহ করে পুরস্কার আনলক করুন আর <color=#FFEE2B>গার্ডেন অ্যারেনা</color>-তে প্রতিযোগিতা করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: স্তর জয় এবং ব্যর্থতা এড়ানোর মাধ্যমে আপনার স্কোর গুণক বাড়ান!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: দারুণ কাজ! অভিনন্দন!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: আপনার স্কোর গুণক অগ্রগতি রিসেট করা হবে!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: পুরস্কার
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: গার্ডেন অ্যারো
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: স্তর জেতো!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: ব্যর্থ না হয়ে স্কোর গুণক বৃদ্ধি করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: অসাধারণ পুরস্কার অর্জন করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: আপনার র‍্যাংক
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: আপনি আপনার <color=#C31439>গুনফল অগ্রগতি হারিয়ে ফেলবেন!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'ব্যক্তিগত পুরস্কার: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: সম্পূর্ণ হয়েছে!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: পরের বার পুরস্কারের জন্য চেষ্টা করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: বিশাল পুরস্কার!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "গার্ডেন অ্যারেনা\nব্যক্তিগত পুরস্কার"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: বার্গার অ্যারেনা
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: পুরস্কার আনলক করতে বার্গার সংগ্রহ করুন এবং <color=#FFEE2B>বার্গার অ্যারেনায়</color> প্রতিযোগিতা করুন!
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "বার্গার অ্যারেনা\nব্যক্তিগত পুরস্কার"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: বিড়াল অ্যারেনা
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: পুরস্কার আনলক করতে এবং <color=#{0}>বিড়াল অ্যারেনা</color>-তে প্রতিযোগিতা করতে ক্যান সংগ্রহ করুন!
    m_Metadata:
      m_Items:
      - rid: 168417876528594994
  - m_Id: 271744063847260160
    m_Localized: "বিড়াল অ্যারেনা\nব্যক্তিগত পুরস্কার"
    m_Metadata:
      m_Items: []
