  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Adună flori pentru deblocarea recompenselor și intră în competiție în <color=#FFEE2B>Arena Grădinii</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Câștigă niveluri și evită eșecul pentru a-ți mări multiplicatorul de scor!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Bravo! Felicitări!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Progresul multiplicatorului de scor va fi resetat!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: RECOMPENSE
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ARENA GRĂDINII
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Câștigă nivele!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Creșteți multiplicatorul de scor fără să eșuați!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Câștigă recompense uimitoare!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: RANGUL TĂU
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Vei pierde progresul tău <color=#C31439>multiplicator!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Recompense personale: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Finalizat!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Mergi după recompense data viitoare!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Răsplată fantastică!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Arena Grădinii\nRecompense Personale"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: ARENA BURGERILOR
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Colectează burgeri pentru a debloca recompense și concurează în <color=#FFEE2B>Arena Burgerilor!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "ARENA BURGERILOR\nRECOMPENSE PERSONALE"
    m_Metadata:
      m_Items: []
