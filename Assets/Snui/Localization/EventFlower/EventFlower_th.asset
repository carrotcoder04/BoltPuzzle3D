  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: EventFlower_th
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: th
  m_SharedData: {fileID: 11400000, guid: c27726ec506177c4094cec49fcd1e7cc, type: 2}
  m_Metadata:
    m_Items:
    - rid: 168417876528594967
  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: เก็บดอกไม้เพื่อปลดล็อกรางวัลและลงแข่งขันใน<color=#FFEE2B>สนามสวน</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: ชนะเลเวลโดยไม่ล้มเหลวเพื่อเพิ่มตัวคูณคะแนน!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: ทำได้ดีมาก! ขอแสดงความยินดี!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: คะแนนทวีคูณของคุณจะถูกรีเซ็ต!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: รางวัล
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: สนามสวน
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: ชนะเลเวล!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: เพิ่มคะแนนทวีคูณโดยไม่ล้มเหลว!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: รับรางวัลสุดเจ๋ง!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: อันดับของคุณ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: คุณจะสูญเสียความก้าวหน้า <color=#C31439>คูณ!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'รางวัลส่วนบุคคล: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: เสร็จสมบูรณ์!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: ไปที่รางวัลในครั้งหน้า!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: รางวัลใหญ่โต!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "สนามสวน\nรางวัลส่วนตัว"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: อารีน่าเบอร์เกอร์
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: สะสมเบอร์เกอร์เพื่อปลดล็อกรางวัล และเข้าแข่งขันใน <color=#FFEE2B>Burger Arena!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "อารีน่าเบอร์เกอร์\nรางวัลส่วนตัว"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: อารีน่าแมวเหมียว
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: สะสมกระป๋องเพื่อปลดล็อกรางวัลและแข่งขันใน <color=#{0}>อารีน่าแมวเหมียว</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594967
  - m_Id: 271744063847260160
    m_Localized: "อารีน่าแมวเหมียว\nรางวัลส่วนตัว"
    m_Metadata:
      m_Items: []
