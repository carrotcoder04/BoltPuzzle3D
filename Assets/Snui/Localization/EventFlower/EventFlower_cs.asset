  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Sbírejte květiny pro odemčení odměn a soupeřte v <color=#FFEE2B>Zahradní Aréně</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Vyhrávejte úrovně a vyhýbejte se neúspěchu, abyste zvýšili svůj násobič skóre!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Skvělá práce! Gratulujeme!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Váš pokrok násobiče skóre bude resetován!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: ODMĚNY
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ZAHRADNÍ ARÉNA
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Vyhrajte úrovně!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Zvyšte násobič skóre, aniž byste selhali!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Získejte úžasné odměny!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: VAŠE HODNOCENÍ
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Ztratíte svůj <color=#C31439>postup v násobitele!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Osobní odměny: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Dokončeno!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Příště jdi za odměnami!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Obří odměna!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Zahradní Aréna\nOsobní Odměny"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: BURGER ARÉNA
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Sbírejte burgery, abyste odemkli odměny a soutěžili v <color=#FFEE2B>Burger Aréně!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "BURGER ARÉNA\nOSOBNÍ ODMĚNY"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: KOČIČÍ ARÉNA
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Sbírejte plechovky, odemykejte odměny a soutěžte v <color=#{0}>KOČIČÍ ARÉNA</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594991
  - m_Id: 271744063847260160
    m_Localized: "KOČIČÍ ARÉNA\nOSOBNÍ ODMĚNY"
