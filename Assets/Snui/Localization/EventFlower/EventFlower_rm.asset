  m_TableData:
  - m_Id: 60585833185402880
    m_Localized: Culeg liaurs per avrir premis e cumbatta en la <color=#FFEE2B>Arena dal Giardin</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 60246434811731968
    m_Localized: Gewinne Levels und vermeide Misserfolge, um deinen Punktmultiplikator zu erhöhen!
    m_Metadata:
      m_Items: []
  - m_Id: 61248678940106752
    m_Localized: Grond lavur! Enconuschientschas!
    m_Metadata:
      m_Items: []
  - m_Id: 61343243856502784
    m_Localized: Dein Fortschritt beim Punktmultiplikator wird zurückgesetzt!
    m_Metadata:
      m_Items: []
  - m_Id: 63869017910140928
    m_Localized: BELONUNGEN
    m_Metadata:
      m_Items: []
  - m_Id: 60246351366053888
    m_Localized: ARENA DAL GIARDIN
    m_Metadata:
      m_Items: []
  - m_Id: 61233480611127296
    m_Localized: Gewinne Levels!
    m_Metadata:
      m_Items: []
  - m_Id: 61233531257348096
    m_Localized: Erhöhe den Punktmultiplikator ohne zu scheitern!
    m_Metadata:
      m_Items: []
  - m_Id: 61233552585383936
    m_Localized: Verdiene erstaunliche Belohnungen!
    m_Metadata:
      m_Items: []
  - m_Id: 63868946472755200
    m_Localized: DEIN RANG
    m_Metadata:
      m_Items: []
  - m_Id: 191802079158722560
    m_Localized: Perdas tes <color=#C31439>progres cun multiplicatur!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 2142630904324096
    m_Localized: 'Premis persunals: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2811815930093568
    m_Localized: Finì!
    m_Metadata:
      m_Items: []
  - m_Id: 2149988078444544
    m_Localized: Emprova da gudagnar ils premis la proxima giada!
    m_Metadata:
      m_Items: []
  - m_Id: 3240164863238144
    m_Localized: Premazi grond!
    m_Metadata:
      m_Items: []
  - m_Id: 3258403383140352
    m_Localized: "Arena dal Giardin\nPremis Persunals"
    m_Metadata:
      m_Items: []
  - m_Id: 43375333200617472
    m_Localized: BURGER-ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 43375338904870912
    m_Localized: Sammle Burger, um Belohnungen freizuschalten und in der <color=#FFEE2B>Burger-Arena</color> anzutreten!
    m_Metadata:
      m_Items: []
  - m_Id: 43375341207543808
    m_Localized: "BURGER-ARENA\nPERSÖNLICHE BELOHNUNGEN"
    m_Metadata:
      m_Items: []
  - m_Id: 265605705924337664
    m_Localized: ARENA DALS GIATS
    m_Metadata:
      m_Items: []
  - m_Id: 265611107713933312
    m_Localized: Collectas launa per bloccari recompensas e concurrer en l'<color=#{0}>ARENA DALS GIATS</color>!
    m_Metadata:
      m_Items:
      - rid: 168417876528594971
  - m_Id: 271744063847260160
    m_Localized: "ARENA DALS GIATS\nRECOMPENSAS PERSUNALAS"
    m_Metadata:
      m_Items: []
