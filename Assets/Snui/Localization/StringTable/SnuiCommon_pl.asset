  - m_Id: 235816862262222848
    m_Localized: NAGRODY DLA FANÓW
    m_Metadata:
      m_Items: []
  - m_Id: 235816800794697728
    m_Localized: Dołącz do naszej rosnącej społeczności na Facebooku i graj razem z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 235816831106932736
    m_Localized: DOŁĄCZ TERAZ
    m_Metadata:
      m_Items: []
  - m_Id: 235816773359755264
    m_Localized: Dołącz i graj z nami!
    m_Metadata:
      m_Items: []
  - m_Id: 237246673576779776
    m_Localized: Grafika jest dobra
    m_Metadata:
      m_Items: []
  - m_Id: 237246681361408000
    m_Localized: Gra jest fajna
    m_Metadata:
      m_Items: []
  - m_Id: 237246694510551040
    m_Localized: Za dużo reklam
    m_Metadata:
      m_Items: []
  - m_Id: 237246703058542592
    m_Localized: Gra ma błędy
    m_Metadata:
      m_Items: []
  - m_Id: 237245482302169088
    m_Localized: Zaktualizuj grę do najnowszej wersji, aby cieszyć się lepszymi wrażeniami.
