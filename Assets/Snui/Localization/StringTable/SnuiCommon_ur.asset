    m_Metadata:
      m_Items: []
  - m_Id: 50707987734454272
    m_Localized: زندگیاں مانگیں
    m_Metadata:
      m_Items: []
  - m_Id: 50728058632527872
    m_Localized: '{0} ٹیم میں شامل ہو گیا ہے۔.'
    m_Metadata:
      m_Items: []
  - m_Id: 50728091402625024
    m_Localized: '{0} کو نکال دیا گیا۔.'
    m_Metadata:
      m_Items: []
  - m_Id: 50708198070411264
    m_Localized: درخواست
    m_Metadata:
      m_Items: []
  - m_Id: 50736182525419520
    m_Localized: زندگیاں مانگ رہا ہے!
    m_Metadata:
      m_Items: []
  - m_Id: 57494596047855616
    m_Localized: نئی ٹیم میں شامل ہونے سے پہلے آپ کو اپنی ٹیم چھوڑنی ہوگی!
    m_Metadata:
      m_Items: []
  - m_Id: 57496004599996416
    m_Localized: درجہ
    m_Metadata:
      m_Items: []
  - m_Id: 57494080442064896
    m_Localized: اسکور
    m_Metadata:
      m_Items: []
