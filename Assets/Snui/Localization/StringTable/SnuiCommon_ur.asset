    m_Metadata:
      m_Items: []
  - m_Id: 45252369947025408
    m_Localized: ٹیم کا نام
    m_Metadata:
      m_Items: []
  - m_Id: 45252486565453824
    m_Localized: '*ٹیم کا لوگو/نام بنانے کے بعد تبدیل نہیں کیا جا سکتا'
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111297
    m_Localized: مدد
    m_Metadata:
      m_Items: []
  - m_Id: 45176682426916864
    m_Localized: شامل ہوں
    m_Metadata:
      m_Items: []
  - m_Id: 50241104296009728
    m_Localized: باہر نکالیں
    m_Metadata:
      m_Items: []
  - m_Id: 47002942832631808
