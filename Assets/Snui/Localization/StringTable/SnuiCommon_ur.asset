    m_Metadata:
      m_Items: []
  - m_Id: 238438330066264064
    m_Localized: '<color=#B5DAFF>سلور کارڈز</color> آپس میں ٹیم کے اراکین میں دیے جا سکتے ہیں.'
    m_Metadata:
      m_Items: []
  - m_Id: 238438440233852928
    m_Localized: '<color=#FDDC25>سونے کے کارڈز</color> صرف ایونٹس اور انعامات سے حاصل کیے جا سکتے ہیں.'
    m_Metadata:
      m_Items: []
  - m_Id: 239838413705961472
    m_Localized: یہ کارڈ ایونٹس، انعامات، اور ٹیم کے اراکین سے حاصل کیا جا سکتا ہے.
    m_Metadata:
      m_Items: []
  - m_Id: 239838802429861888
