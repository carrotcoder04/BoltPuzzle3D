    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111296
    m_Localized: سطح {0} تک پہنچیں تاکہ درکار سطح کی حد میں اضافہ ہو۔.
    m_Metadata:
      m_Items: []
  - m_Id: 45252313470722048
    m_Localized: ٹیم کا لوگو
    m_Metadata:
      m_Items: []
