    m_Metadata:
      m_Items: []
  - m_Id: 237665078654001152
    m_Localized: 팀원
    m_Metadata:
      m_Items: []
  - m_Id: 237687049928302592
    m_Localized: 이 카드를 {0}에게 보내려고 합니다!
    m_Metadata:
      m_Items: []
  - m_Id: 237712387861372928
