    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305602
    m_Localized: Sinun täytyy odottaa {0} minuuttia, ennen kuin voit auttaa uudelleen!
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305603
    m_Localized: Olet jo esittänyt tämän pyynnön.
    m_Metadata:
      m_Items: []
