    m_Metadata:
      m_Items: []
  - m_Id: 67417490278309888
    m_Localized: OLETKO VARMA?
    m_Metadata:
      m_Items: []
  - m_Id: 67417490278309889
    m_Localized: Haluatko todella lopettaa pelin?
    m_Metadata:
