    m_Metadata:
      m_Items: []
  - m_Id: 239840360295030784
    m_Localized: Olet jo lähettänyt 3 korttia tänään.
    m_Metadata:
      m_Items: []
  - m_Id: 239841109020237824
    m_Localized: Olet jo pyytänyt korttia tänään.
