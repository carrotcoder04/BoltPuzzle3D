      m_Items: []
  - m_Id: 63717953256808448
    m_Localized: LÄHETÄ
    m_Metadata:
      m_Items: []
  - m_Id: 63719952446644224
    m_Localized: Syötä sähköpostiosoitteesi tähän
    m_Metadata:
      m_Items: []
  - m_Id: 63740716600254464
    m_Localized: Kiitos palautteestasi!
    m_Metadata:
      m_Items: []
  - m_Id: 63741145136488448
    m_Localized: Lähetys epäonnistui, yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 63762870901399552
    m_Localized: LASTAUS EPÄONNISTUI
    m_Metadata:
      m_Items: []
  - m_Id: 63764307005923328
    m_Localized: Valitse tai kuvaile ongelmaasi
    m_Metadata:
      m_Items: []
  - m_Id: 63764348902825984
    m_Localized: Syötä sähköpostiosoitteesi tähän
    m_Metadata:
      m_Items: []
  - m_Id: 78010148310736896
    m_Localized: Haluatko poistaa tietosi tältä laitteelta ja palvelimiltamme?
    m_Metadata:
      m_Items: []
  - m_Id: 78010253747150848
    m_Localized: Pelitietosi poistetaan tältä laitteelta ja palvelimiltamme välittömästi. Kaikki tietosi ja edistymisesi menetetään, eikä niitä voida palauttaa.
    m_Metadata:
      m_Items: []
  - m_Id: 78010270369177600
    m_Localized: Sinulla on aktiivisia tilauksia.
    m_Metadata:
      m_Items: []
  - m_Id: 78010281240813568
    m_Localized: Välttääksesi lisäveloituksia, siirry App Storeen > Tili > Tilaukset ja peruuta ensin kaikki aktiiviset tilaukset.
    m_Metadata:
      m_Items: []
  - m_Id: 78010291277783040
    m_Localized: Oletko varma, että poistat tietosi? Menetät nykyisen edistymisesi, eikä sitä voida palauttaa.
    m_Metadata:
      m_Items: []
  - m_Id: 78010303109914624
    m_Localized: Napauttamalla "Kyllä" käynnistät pelin uudelleen uutena käyttäjänä.
    m_Metadata:
      m_Items: []
  - m_Id: 78010720036315136
    m_Localized: YMMÄRRÄN
    m_Metadata:
      m_Items: []
  - m_Id: 95625466474389504
    m_Localized: Mikä on nimesi?
    m_Metadata:
      m_Items: []
  - m_Id: 95625437298810880
    m_Localized: SYÖTÄ NIMI
    m_Metadata:
      m_Items: []
  - m_Id: 111216658851291136
    m_Localized: Ansaitse ilmaisia elämää tiimisi jäseniltä.
    m_Metadata:
      m_Items: []
  - m_Id: 111930957190127616
    m_Localized: Sinulla ei ole ilmaisia elämiä.
    m_Metadata:
      m_Items: []
  - m_Id: 115602396111953920
    m_Localized: VIESTI
    m_Metadata:
      m_Items: []
  - m_Id: 118470840675196928
    m_Localized: Napauta muokataksesi profiiliasi
    m_Metadata:
      m_Items: []
  - m_Id: 118480965112684544
    m_Localized: Luo lempinimesi!
    m_Metadata:
      m_Items: []
  - m_Id: 118485440464412672
    m_Localized: VALITSE KUVA
    m_Metadata:
      m_Items: []
  - m_Id: 125717701572157440
    m_Localized: Suurin merkkiraja on {0}
    m_Metadata:
      m_Items: []
