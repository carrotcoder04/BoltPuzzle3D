    m_Metadata:
      m_Items: []
  - m_Id: 48164027749097472
    m_Localized: Vui lòng kiểm tra kết nối internet của bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 48163983373361152
    m_Localized: Kết nối bị mất!
    m_Metadata:
      m_Items: []
