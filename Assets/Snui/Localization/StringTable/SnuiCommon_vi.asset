    m_Metadata:
      m_Items: []
  - m_Id: 50736182525419520
    m_Localized: hỏi xin mạng sống!
    m_Metadata:
      m_Items: []
  - m_Id: 57494596047855616
    m_Localized: Bạn phải rời khỏi đội của mình trước khi tham gia đội mới!
    m_Metadata:
      m_Items: []
