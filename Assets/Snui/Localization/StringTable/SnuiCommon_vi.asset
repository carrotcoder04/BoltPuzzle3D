    m_Metadata:
      m_Items: []
  - m_Id: 48193207886929920
    m_Localized: Nhận mạng miễn phí
    m_Metadata:
      m_Items: []
  - m_Id: 52896720361611264
    m_Localized: Cấp độ của bạn không đủ để tham gia đội này
    m_Metadata:
      m_Items: []
  - m_Id: 48191512465367040
    m_Localized: THAM GIA MỘT NHÓM
    m_Metadata:
      m_Items: []
  - m_Id: 50334557843480576
    m_Localized: Bạn có chắc chắn muốn đuổi người chơi này ra khỏi đội không?
    m_Metadata:
      m_Items: []
