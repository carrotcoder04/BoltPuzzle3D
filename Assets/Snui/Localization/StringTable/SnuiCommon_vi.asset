    m_Localized: KÍCH HOẠT
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430475
    m_Localized: Mở khóa phần thưởng đặc biệt!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430476
    m_Localized: '<color=#FFF34F>{0}</color> đã nhận được!'
