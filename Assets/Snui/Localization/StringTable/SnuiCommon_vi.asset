    m_Metadata:
      m_Items: []
  - m_Id: 52780918081839104
    m_Localized: Kết nối
    m_Metadata:
      m_Items: []
  - m_Id: 52798812643647488
    m_Localized: Ký tự không được hỗ trợ.
    m_Metadata:
      m_Items: []
