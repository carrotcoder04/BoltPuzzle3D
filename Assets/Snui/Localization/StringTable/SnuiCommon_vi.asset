    m_Metadata:
      m_Items: []
  - m_Id: 51007642271735808
    m_Localized: đã gửi bạn một cuộc sống!
    m_Metadata:
      m_Items: []
  - m_Id: 48193240967405568
    m_Localized: Nhận xu miễn phí
    m_Metadata:
      m_Items: []
  - m_Id: 48193180493930496
    m_Localized: 'Tham gia hoặc tạo nhóm để:'
    m_Metadata:
      m_Items: []
  - m_Id: 52896768214425600
