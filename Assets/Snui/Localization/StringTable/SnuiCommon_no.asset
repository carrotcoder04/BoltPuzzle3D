      m_Items: []
  - m_Id: 348512051200
    m_Localized: Vær den første og vinn fantastiske belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051201
    m_Localized: Fullfør {0} nivåer først for å vinne storpremien!
