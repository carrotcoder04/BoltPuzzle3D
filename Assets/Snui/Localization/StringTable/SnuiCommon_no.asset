    m_Localized: Du ble først!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051206
    m_Localized: Søker etter spillere...
    m_Metadata:
      m_Items: []
  - m_Id: 348512051207
    m_Localized: TRINN {0}
    m_Metadata:
      m_Items: []
  - m_Id: 348512051210
    m_Localized: Vinn nivåer før andre for å fullføre oppdraget
    m_Metadata:
      m_Items: []
  - m_Id: 348512051211
    m_Localized: Tjen utrolige premier!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051212
    m_Localized: Bli med i løpet!
    m_Metadata:
      m_Items: []
