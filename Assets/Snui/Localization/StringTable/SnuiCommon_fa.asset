    m_Metadata:
      m_Items: []
  - m_Id: 188407241268781056
    m_Localized: پر کردن زندگی رایگان!
    m_Metadata:
      m_Items: []
  - m_Id: 191590517525438464
    m_Localized: جوایز!
    m_Metadata:
      m_Items: []
  - m_Id: 195269482039468032
    m_Localized: '<sprite=0> از جوایز خود در <color=#FFFF0B>Play Points</color> لذت ببرید!'
