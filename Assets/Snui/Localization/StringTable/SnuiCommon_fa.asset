    m_Metadata:
      m_Items: []
  - m_Id: 214839998228193280
    m_Localized: ستاره‌ها را جمع‌آوری کنید تا جوایز را باز کنید!
    m_Metadata:
      m_Items: []
  - m_Id: 214867523276890112
    m_Localized: باز کردن
    m_Metadata:
      m_Items: []
