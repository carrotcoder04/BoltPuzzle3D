    m_Metadata:
      m_Items: []
  - m_Id: 67417490278309889
    m_Localized: آیا واقعاً می‌خواهید بازی را ترک کنید؟
    m_Metadata:
      m_Items: []
  - m_Id: 45257875570810881
    m_Localized: بمان
    m_Metadata:
      m_Items: []
