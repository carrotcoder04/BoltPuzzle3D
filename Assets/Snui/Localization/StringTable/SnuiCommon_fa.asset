    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793728
    m_Localized: یک بسته بخر و یک بسته رایگان بگیر
    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793729
    m_Localized: بسته را دریافت کن تا جوایز رایگان را باز کنی!
    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793730
    m_Localized: دریافت شد
    m_Metadata:
      m_Items: []
