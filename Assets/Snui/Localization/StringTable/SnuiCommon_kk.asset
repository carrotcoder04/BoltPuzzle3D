  m_LocaleId:
    m_Code: kk
  m_SharedData: {fileID: 11400000, guid: 56d4b1d6a9621d04eb877a1525a91b26, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 40900312473526272
    m_Localized: Бақылауға рұқсат етіңіз
    m_Metadata:
      m_Items: []
  - m_Id: 40900371902619648
    m_Localized: Бақылауға қатысты жарнамаларды алып тастап, {0} тегін тиындар алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 40900440034893824
    m_Localized: Марапаттар алу үшін бақылауға рұқсат етіңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 40900277404950528
    m_Localized: m
    m_Metadata:
      m_Items: []
  - m_Id: 233343164604416
    m_Localized: Тегін өмір сүру
    m_Metadata:
      m_Items: []
  - m_Id: 41986630234398720
    m_Localized: ҚАЗІР ЕМЕС
    m_Metadata:
      m_Items: []
  - m_Id: 233280816275456
    m_Localized: Қайта толтыру
    m_Metadata:
      m_Items: []
  - m_Id: 266123567161344
    m_Localized: Қолдану
    m_Metadata:
      m_Items: []
  - m_Id: 41986630246981632
    m_Localized: Иә
    m_Metadata:
      m_Items: []
  - m_Id: 35481137106116608
    m_Localized: Толық
    m_Metadata:
      m_Items: []
  - m_Id: 12288803132661760
    m_Localized: Босату
    m_Metadata:
      m_Items: []
  - m_Id: 304573871808512
    m_Localized: Тегін өмір!
    m_Metadata:
      m_Items: []
  - m_Id: 1697441651875840
    m_Localized: Барлық өмірлер толы.
    m_Metadata:
      m_Items: []
  - m_Id: 1436200639389696
    m_Localized: Деңгейлік кеуде
    m_Metadata:
      m_Items: []
  - m_Id: 12288946942763008
    m_Localized: Арнайы коллекция
    m_Metadata:
      m_Items: []
  - m_Id: 1436162156650496
    m_Localized: Жұлдызды кеуде
    m_Metadata:
      m_Items: []
  - m_Id: 320630867091456
    m_Localized: '{0} ТЕГІН өмір'
    m_Metadata:
      m_Items: []
  - m_Id: 264074574159872
    m_Localized: Өмір банкі
    m_Metadata:
      m_Items: []
  - m_Id: 232529176027136
    m_Localized: Көп өмір сүру
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026432
    m_Localized: Бұл тек бір рет тегін!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026434
    m_Localized: Лақап ат қойыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026435
    m_Localized: Жарамсыз атау. Тағы біреуін теріңіз
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026436
    m_Localized: Кемінде 3 таңбаны теріңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026437
    m_Localized: Ең көп дегенде 15 таңбадан тұрады!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026433
    m_Localized: Лақап атыңызды теріңіз ...
    m_Metadata:
      m_Items: []
  - m_Id: 39808712133566464
    m_Localized: Атауы
    m_Metadata:
      m_Items: []
  - m_Id: 40123526764552192
    m_Localized: Профильді өңдеу
    m_Metadata:
      m_Items: []
  - m_Id: 40900528459210752
    m_Localized: Шектеулі уақыт оқиғалары мен жаңартулар туралы хабардар болыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 41991704809562112
    m_Localized: Шектеулі оқиғалар мен жаңартуларды алу туралы хабарландыруларға рұқсат етіңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 40900487157899264
    m_Localized: Жіберіп алмаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 42375726647730176
    m_Localized: Бедеп отыруға қайтысты cloud қазақтамалы орындау!
    m_Metadata:
      m_Items: []
  - m_Id: 42375679755411456
    m_Localized: КІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 45252780607135744
    m_Localized: ТАҢДАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 45252819287007232
    m_Localized: ЖАСАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 50335704901738496
    m_Localized: ЖОҚ
    m_Metadata:
      m_Items: []
  - m_Id: 45252991467380736
    m_Localized: САҚТАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 45199535239061504
    m_Localized: Көрініс
    m_Metadata:
      m_Items: []
  - m_Id: 51007642271735808
    m_Localized: сізге өмір жіберді!
    m_Metadata:
      m_Items: []
  - m_Id: 48193240967405568
    m_Localized: Тегін монеталар алыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 48193180493930496
    m_Localized: 'Топқа қосылыңыз немесе жаңа топ құрыңыз:'
    m_Metadata:
      m_Items: []
  - m_Id: 52896768214425600
    m_Localized: Топтың сыйымдылығы толық
    m_Metadata:
      m_Items: []
  - m_Id: 48193207886929920
    m_Localized: Тегін өмірлер алыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 52896720361611264
    m_Localized: Сіздің деңгейіңіз бұл команданы қосылу үшін жеткіліксіз
    m_Metadata:
      m_Items: []
  - m_Id: 48191512465367040
    m_Localized: ТОПҚА ҚОСЫЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 50334557843480576
    m_Localized: Ойыншыны шығарып жіберуге сенімдісіз бе?
    m_Metadata:
      m_Items: []
  - m_Id: 50332880616808448
    m_Localized: ШЫҒАРУ
    m_Metadata:
      m_Items: []
  - m_Id: 49634758253076480
    m_Localized: БАС ТАРТУ
    m_Metadata:
      m_Items: []
  - m_Id: 49634806575652864
    m_Localized: Командаңыздан кеткіңіз келе ме сенімдісіз бе?
    m_Metadata:
      m_Items: []
  - m_Id: 49634666892746752
    m_Localized: КЕТУ
    m_Metadata:
      m_Items: []
  - m_Id: 49634620147228672
    m_Localized: КОМАНДАДАН КЕТУ
    m_Metadata:
      m_Items: []
  - m_Id: 48164027749097472
    m_Localized: Интернет байланысыңызды тексеріңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 48163983373361152
    m_Localized: Байланыс үзілді!
    m_Metadata:
      m_Items: []
  - m_Id: 52805192968560640
    m_Localized: Атыңызды өзгерту сәтті аяқталды!
    m_Metadata:
      m_Items: []
  - m_Id: 52780918081839104
    m_Localized: Қосылу
    m_Metadata:
      m_Items: []
  - m_Id: 52798812643647488
    m_Localized: Таңба қолдау көрсетілмейді.
    m_Metadata:
      m_Items: []
  - m_Id: 42375933552746496
    m_Localized: APPLE АРҚЫЛЫ КІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 42375887180521472
    m_Localized: FACEBOOK АРҚЫЛЫ КІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 42375955442819072
    m_Localized: КИРУ GOOGLE АРҚЫЛЫ
    m_Metadata:
      m_Items: []
  - m_Id: 42721386727202816
    m_Localized: Сіздің прогрессіңіз сақталды.
    m_Metadata:
      m_Items: []
  - m_Id: 42721333207883776
    m_Localized: СӘТТІЛІК
    m_Metadata:
      m_Items: []
  - m_Id: 42730837634965504
    m_Localized: ӘЛІ ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 42726401105715200
    m_Localized: Ойын <color=#EF4C4C>1-деңгейден</color> қайта басталады!
    m_Metadata:
      m_Items: []
  - m_Id: 42726463454044160
    m_Localized: 'Кеңес: Прогресіңізді жалғастыру үшін қайта кіре аласыз.'
    m_Metadata:
      m_Items: []
  - m_Id: 42726296550105088
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 45200576651190272
    m_Localized: Сыйымдылық
    m_Metadata:
      m_Items: []
  - m_Id: 45176701162872832
    m_Localized: ЖАСАУ
    m_Metadata:
      m_Items: []
  - m_Id: 47003035736465408
    m_Localized: ӨҢДЕУ
    m_Metadata:
      m_Items: []
  - m_Id: 45252406294863872
    m_Localized: Қажетті деңгей
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111296
    m_Localized: '{0} деңгейге жету Қажетті деңгей шегін көтеру үшін.'
    m_Metadata:
      m_Items: []
  - m_Id: 45252313470722048
    m_Localized: Команда логотипі
    m_Metadata:
      m_Items: []
  - m_Id: 45262366646984704
    m_Localized: ЛОГОТИПТІ ТАҢДАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 45252369947025408
    m_Localized: Команда атауы
    m_Metadata:
      m_Items: []
  - m_Id: 45252486565453824
    m_Localized: '*Команда логотипі/аты жасалғаннан кейін өзгертілмейді'
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111297
    m_Localized: КӨМЕК
    m_Metadata:
      m_Items: []
  - m_Id: 45176682426916864
    m_Localized: ҚОСЫЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 50241104296009728
    m_Localized: Шығарып жіберу
    m_Metadata:
      m_Items: []
  - m_Id: 47002942832631808
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 44926451865083904
    m_Localized: МЕНІҢ КОМАНДАМ
    m_Metadata:
      m_Items: []
  - m_Id: 45250024622252032
    m_Localized: Команда атауын енгізіңіз...
    m_Metadata:
      m_Items: []
  - m_Id: 45199495682580480
    m_Localized: ІЗДЕУ
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111298
    m_Localized: Бұл ат бойынша нәтижелер жоқ.
    m_Metadata:
      m_Items: []
  - m_Id: 44926427412291584
    m_Localized: КОМАНДАЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305600
    m_Localized: Өмірлеріңіз толы
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305601
    m_Localized: Сіз бұл сұрауға көмектестіңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305602
    m_Localized: Сіз қайтадан көмектесе алу үшін {0} минут күтуіңіз керек!
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305603
    m_Localized: Сіз бұл сұрауды сұрап қойғансыз.
    m_Metadata:
      m_Items: []
  - m_Id: 46997273542909952
    m_Localized: 'Қажетті деңгей:'
    m_Metadata:
      m_Items: []
  - m_Id: 46995160800681984
    m_Localized: 'Команда ұпайы:'
    m_Metadata:
      m_Items: []
  - m_Id: 46002148947779584
    m_Localized: КОМАНДА АҚПАРАТЫ
    m_Metadata:
      m_Items: []
  - m_Id: 46996381083099136
    m_Localized: 'Апталық көмектер:'
    m_Metadata:
      m_Items: []
  - m_Id: 47072008410750976
    m_Localized: Көмектер
    m_Metadata:
      m_Items: []
  - m_Id: 47072106691682304
    m_Localized: Жетекші
    m_Metadata:
      m_Items: []
  - m_Id: 47072050559311872
    m_Localized: Деңгейлер
    m_Metadata:
      m_Items: []
  - m_Id: 50707987734454272
    m_Localized: ӨМІР СҰРАУ
    m_Metadata:
      m_Items: []
  - m_Id: 50728058632527872
    m_Localized: '{0} командаға қосылды.'
    m_Metadata:
      m_Items: []
  - m_Id: 50728091402625024
    m_Localized: '{0} шығарылды.'
    m_Metadata:
      m_Items: []
  - m_Id: 50708198070411264
    m_Localized: СҰРАНЫС
    m_Metadata:
      m_Items: []
  - m_Id: 50736182525419520
    m_Localized: тіршілік сұрау!
    m_Metadata:
      m_Items: []
  - m_Id: 57494596047855616
    m_Localized: Жаңа командаға қосылмас бұрын өз командаңыздан кетуіңіз керек!
    m_Metadata:
      m_Items: []
  - m_Id: 57496004599996416
    m_Localized: РЕЙТИНГ
    m_Metadata:
      m_Items: []
  - m_Id: 57494080442064896
    m_Localized: Есеп
    m_Metadata:
      m_Items: []
  - m_Id: 56149430573719552
    m_Localized: КОМАНДАЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 56149277246742528
    m_Localized: КӨШБАСШЫЛАР ТАҚТАСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 56149395333177344
    m_Localized: ОЙЫНШЫЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 57493952461266944
    m_Localized: Команданы көру
    m_Metadata:
      m_Items: []
  - m_Id: 63674767004131328
    m_Localized: ПІКІР
    m_Metadata:
      m_Items: []
  - m_Id: 63717830468558848
    m_Localized: Өз мәселелеріңізді таңдаңыз немесе сипаттаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 63717859195346944
    m_Localized: Мәселелерді немесе ұсыныстарды сипаттаңыз...
    m_Metadata:
      m_Items: []
  - m_Id: 63717953256808448
    m_Localized: ЖІБЕРУ
    m_Metadata:
      m_Items: []
  - m_Id: 63719952446644224
    m_Localized: Электрондық поштаңызды мұнда енгізіңіз
    m_Metadata:
      m_Items: []
  - m_Id: 63740716600254464
    m_Localized: Пікіріңіз үшін рахмет!
    m_Metadata:
      m_Items: []
  - m_Id: 63741145136488448
    m_Localized: Жіберілмеді, әрекетті қайталаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 63762870901399552
    m_Localized: ЖҮКТЕУ СӘТСІЗ АЯҚТАЛДЫ
    m_Metadata:
      m_Items: []
  - m_Id: 63764307005923328
    m_Localized: Өз мәселелеріңізді таңдаңыз немесе сипаттаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 63764348902825984
    m_Localized: Электрондық поштаңызды мұнда енгізіңіз
    m_Metadata:
      m_Items: []
  - m_Id: 78010148310736896
    m_Localized: Бұл құрылғы мен серверлерімізден деректеріңізді жоюды қалайсыз ба?
    m_Metadata:
      m_Items: []
  - m_Id: 78010253747150848
    m_Localized: Ойын деректеріңіз осы құрылғы мен серверлерімізден дереу жойылады. Барлық деректеріңіз бен жетістіктеріңіз жоғалады және қалпына келтірілмейді.
    m_Metadata:
      m_Items: []
  - m_Id: 78010270369177600
    m_Localized: Сізде белсенді жазылымдар бар.
    m_Metadata:
      m_Items: []
  - m_Id: 78010281240813568
    m_Localized: Қосымша төлемдерден аулақ болу үшін App Store > Аккаунт > Жазылымдар бөліміне өтіп, барлық белсенді жазылымдарыңызды алдымен тоқтатыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 78010291277783040
    m_Localized: Деректеріңізді жоюға сенімдісіз бе? Ағымдағы жетістіктеріңіз жоғалып, оны қалпына келтіру мүмкін емес.
    m_Metadata:
      m_Items: []
  - m_Id: 78010303109914624
    m_Localized: “Иә” батырмасын басу арқылы ойынды жаңа пайдаланушы ретінде бастайсыз.
    m_Metadata:
      m_Items: []
  - m_Id: 78010720036315136
    m_Localized: МЕН ТҮСІНДІМ
    m_Metadata:
      m_Items: []
  - m_Id: 95625466474389504
    m_Localized: Сіздің атыңыз кім?
    m_Metadata:
      m_Items: []
  - m_Id: 95625437298810880
    m_Localized: АТЫҢЫЗДЫ ЖАЗЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 111216658851291136
    m_Localized: Команда мүшелеріңізден тегін өмірлер алыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 111930957190127616
    m_Localized: Сізде тегін өмір жоқ.
    m_Metadata:
      m_Items: []
  - m_Id: 115602396111953920
    m_Localized: ХАБАР
    m_Metadata:
      m_Items: []
  - m_Id: 118470840675196928
    m_Localized: Профиліңізді өңдеу үшін түртіңіз
    m_Metadata:
      m_Items: []
  - m_Id: 118480965112684544
    m_Localized: Лақап атыңызды жасаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 118485440464412672
    m_Localized: СУРЕТТІ ТАҢДАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 125717701572157440
    m_Localized: Максималды таңба шегі {0}
    m_Metadata:
      m_Items: []
  - m_Id: 125725518169366528
    m_Localized: Менің Профилім
    m_Metadata:
      m_Items: []
  - m_Id: 125734265910452224
    m_Localized: 'Ағымдағы Деңгей:'
    m_Metadata:
      m_Items: []
  - m_Id: 125736013802758144
    m_Localized: ЖАЛПЫ СТАТИСТИКА
    m_Metadata:
      m_Items: []
  - m_Id: 125737398732578816
    m_Localized: Алғашқы жеңіс
    m_Metadata:
      m_Items: []
  - m_Id: 125737783090208768
    m_Localized: Көмек берілді
    m_Metadata:
      m_Items: []
  - m_Id: 126423333916893184
    m_Localized: Көмек алынды
    m_Metadata:
      m_Items: []
  - m_Id: 67417490278309888
    m_Localized: СЕН ӘРІ ҚАЖЕТПІСІҢ?
    m_Metadata:
      m_Items: []
  - m_Id: 67417490278309889
    m_Localized: Шынымен ойыннан шығуды қалайсыз ба?
    m_Metadata:
      m_Items: []
  - m_Id: 45257875570810881
    m_Localized: ҚАЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 45257875562422272
    m_Localized: ДЕҢГЕЙДІ ТОҚТАТУ
    m_Metadata:
      m_Items: []
  - m_Id: 45257875570810880
    m_Localized: Шығыңыз келетініне сенімдісіз бе?
    m_Metadata:
      m_Items: []
  - m_Id: 149290068038639616
    m_Localized: ЖАЛҒАСТЫРУ
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661760
    m_Localized: Жарнама тәжірибесін жақсарту үшін бақылауға рұқсат етіңіз
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661761
    m_Localized: Сіз құрылғының параметрлеріне бағытталасыз
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661762
    m_Localized: Қосыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661763
    m_Localized: Хабарландыруды рұқсат ету
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661764
    m_Localized: Трекингке рұқсат беру
    m_Metadata:
      m_Items: []
  - m_Id: 156517155136856064
    m_Localized: Құрылғы параметрлерінен хабарландыруларды қосыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 158623746145378304
    m_Localized: Команда жоқ
    m_Metadata:
      m_Items: []
  - m_Id: 159757269296209920
    m_Localized: ЖАЛҒАСТЫРУ ҮШІН ТИГІЗІҢІЗ
    m_Metadata:
      m_Items: []
  - m_Id: 164882056993562624
    m_Localized: ТАЛАП ЕТУ ҮШІН ТЫНДЫРЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 167298491044847616
    m_Localized: БАСТАУ
    m_Metadata:
      m_Items: []
  - m_Id: 167388066735972352
    m_Localized: СІЗГЕ АРНАЛҒАН ЖЕҢІЛДІКТЕР
    m_Metadata:
      m_Items: []
  - m_Id: 167388656706772992
    m_Localized: 3-ІН 1 ЖЕҢІЛДІК
    m_Metadata:
      m_Items: []
  - m_Id: 167390104249163776
    m_Localized: БАРЛЫҒЫН САТЫП АЛЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 105754245507047424
    m_Localized: ҚҰРЫЛҒЫ ЖИНАҒЫ
    m_Metadata:
      m_Items: []
  - m_Id: 105754499891585024
    m_Localized: Әр ұсынысты талап етіп, тегін сыйлықтарды ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754502554968064
    m_Localized: Тегін сыйлықтарды талап етуді ұмытпаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 172042873425879040
    m_Localized: Нан пакеті
    m_Metadata:
      m_Items: []
  - m_Id: 172075683758989312
    m_Localized: БІРІН ТАҢДА
    m_Metadata:
      m_Items: []
  - m_Id: 180366206789738496
    m_Localized: ТАЛАП
    m_Metadata:
      m_Items: []
  - m_Id: 186520677521547265
    m_Localized: ИНТЕРНЕТ ЖОҚ
    m_Metadata:
      m_Items: []
  - m_Id: 186520677521547264
    m_Localized: "Бұл әрекетке интернет байланысы қажет.\nКейінірек қайта көріңіз."
    m_Metadata:
      m_Items: []
  - m_Id: 186506587038277632
    m_Localized: "{0}\nСЫЙЛЫҚТАР!"
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219843
    m_Localized: Мұнда сіздің талап етілмеген сыйлықтарыңыз бар!
    m_Metadata:
      m_Items: []
  - m_Id: 179369413868249088
    m_Localized: ОЙНАУ
    m_Metadata:
      m_Items: []
  - m_Id: 188378725424816128
    m_Localized: РАКЕТА САТУ
    m_Metadata:
      m_Items: []
  - m_Id: 188407241268781056
    m_Localized: Тегін өмірді толтыру!
    m_Metadata:
      m_Items: []
  - m_Id: 191590517525438464
    m_Localized: СЫЙЛЫҚТАР!
    m_Metadata:
      m_Items: []
  - m_Id: 195269482039468032
    m_Localized: '<sprite=0> Ләззат алыңыз <color=#FFFF0B>Play Points</color> сыйақыларыңыздан!'
    m_Metadata:
      m_Items: []
  - m_Id: 195312493884596224
    m_Localized: ҚУАНЫШТЫ ХЭЛЛОУИН
    m_Metadata:
      m_Items: []
  - m_Id: 197048656911654912
    m_Localized: ҚҰТТЫҚТАЙМЫЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 199617985050042368
    m_Localized: АРНАЙЫ ҰСЫНЫС
    m_Metadata:
      m_Items: []
  - m_Id: 199621120049012736
    m_Localized: Пайдасыз жарнамаларды мәңгілікке алып тастаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 199625686962397184
    m_Localized: БІР РЕТ ПЕН
    m_Metadata:
      m_Items: []
  - m_Id: 201820360875696128
    m_Localized: ТЕГІН
    m_Metadata:
      m_Items: []
  - m_Id: 204334129812070400
    m_Localized: Рождество ЖЕМІСІ
    m_Metadata:
      m_Items: []
  - m_Id: 208692138415742976
    m_Localized: ҚАЙТАДАН КӨРІҢІЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 205711112789811200
    m_Localized: Блэк Фрайдей Ертісі
    m_Metadata:
      m_Items: []
  - m_Id: 212716759028850688
    m_Localized: ҚУАТ ЖИНАҒЫ
    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793728
    m_Localized: 1 пакет сатып алыңыз & 1 ТЕГІН алыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793729
    m_Localized: Тегін сыйлықтарды ашу үшін пакетті талап етіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 212716759070793730
    m_Localized: Алынды
    m_Metadata:
      m_Items: []
  - m_Id: 213344241960607744
    m_Localized: '{0} Жұлдыз жинаңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 213385543838326784
    m_Localized: СЫНЫҚ ПАКЕТ
    m_Metadata:
      m_Items: []
  - m_Id: 213385629515374592
    m_Localized: Пакетті ашып, <color=#FFE315>{0}</color> монетаға дейін талап етіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 214475252614291456
    m_Localized: Пакетті ашып, сыйлықтарыңызды талап етіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 214520926147960832
    m_Localized: АЛЫҢЫЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 214539340325314560
    m_Localized: Уақыт шегінде жұлдыздарды жинап, <color=#FFE315>{0}</color> тиынға дейін ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 214769054264582144
    m_Localized: СОҢҒЫ МҮМКІНДІК
    m_Metadata:
      m_Items: []
  - m_Id: 214769183633694720
    m_Localized: Сіз барлық табысты сыйлықтарыңызды бергіңіз келе ме?
    m_Metadata:
      m_Items: []
  - m_Id: 214769539012878336
    m_Localized: ТАҢДАМАҢ
    m_Metadata:
      m_Items: []
  - m_Id: 214783103136161792
    m_Localized: ДЕЙІН
    m_Metadata:
      m_Items: []
  - m_Id: 214839998228193280
    m_Localized: Сыйлықтарды ашу үшін жұлдзы жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 214867523276890112
    m_Localized: АШЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 215234507382448128
    m_Localized: Пакетті ашып, жұлдзы жинап, сыйлықтарыңызды талап етіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 159497032479793152
    m_Localized: ҰЛЫ ЖҮЛДЕ
    m_Metadata:
      m_Items: []
  - m_Id: 220645188114046976
    m_Localized: ЖИНАҚ
    m_Metadata:
      m_Items: []
  - m_Id: 224668775510695936
    m_Localized: '<color=#fddc25>Жаңа коллекция</color> жақын арада келеді!'
    m_Metadata:
      m_Items: []
  - m_Id: 224920229035106304
    m_Localized: '<color={0}>{1} деңгейіне</color> жетіп, коллекцияны ашыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 224920905328877568
    m_Localized: Жинақ
    m_Metadata:
      m_Items: []
  - m_Id: 224923537313357824
    m_Localized: '<color={0}>Жүктелуде…</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 228241451726659584
    m_Localized: '{0} деңгейге жетіп, Коллекцияны ашып, медальдарыңызды қараңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 228241896872337408
    m_Localized: АВАТАР
    m_Metadata:
      m_Items: []
  - m_Id: 228242197553602560
    m_Localized: РАМКА
    m_Metadata:
      m_Items: []
  - m_Id: 228242241958699008
    m_Localized: АТЫ
    m_Metadata:
      m_Items: []
  - m_Id: 228242435928481792
    m_Localized: МЕДАЛЬ
    m_Metadata:
      m_Items: []
  - m_Id: 228243239926226944
    m_Localized: Бұл стильді уақытша ашу үшін өткізуді белсендіруіңіз керек!
    m_Metadata:
      m_Items: []
  - m_Id: 230438899417079808
    m_Localized: СНЯТЬ
    m_Metadata:
      m_Items: []
  - m_Id: 230438918601826304
    m_Localized: НАДЕТЬ
    m_Metadata:
      m_Items: []
  - m_Id: 233681610001604608
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 235817653417009152
    m_Localized: Аяқталды!
    m_Metadata:
      m_Items: []
  - m_Id: 235817653417009153
    m_Localized: ҮЙ
    m_Metadata:
      m_Items: []
  - m_Id: 235817653417009154
    m_Localized: ҚҰТТЫҚТАУ
    m_Metadata:
      m_Items: []
  - m_Id: 237239390117552128
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 237239390121746432
    m_Localized: Қайта ойнау
    m_Metadata:
      m_Items: []
  - m_Id: 237239390130135040
    m_Localized: ДЕҢГЕЙ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 237239390130135041
    m_Localized: ЖҮКТЕЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 237239390134329346
    m_Localized: ӨТПЕ
    m_Metadata:
      m_Items: []
  - m_Id: 237239390142717952
    m_Localized: ЖАҚСЫ БОЛДЫ!
    m_Metadata:
      m_Items: []
  - m_Id: 237239390163689472
    m_Localized: Сіздің рангыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 237239390163689473
    m_Localized: Сыйлық
    m_Metadata:
      m_Items: []
  - m_Id: 237246559818866688
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 237246575794970624
    m_Localized: Қайта ойнау
    m_Metadata:
      m_Items: []
  - m_Id: 237246590647001088
    m_Localized: ДЕҢГЕЙ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 237246601078235136
    m_Localized: ЖҮКТЕЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 237246643658809344
    m_Localized: ӨТПЕ
    m_Metadata:
      m_Items: []
  - m_Id: 237246711614922752
    m_Localized: ЖАҚСЫ БОЛДЫ!
    m_Metadata:
      m_Items: []
  - m_Id: 237246748369608704
    m_Localized: Сіздің рангыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 237246760054939648
    m_Localized: Сыйлық
    m_Metadata:
      m_Items: []
  - m_Id: 237245536492576768
    m_Localized: КЕЙІНірек
    m_Metadata:
      m_Items: []
  - m_Id: 237246615879933952
    m_Localized: ҮЗІЛТІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 235891040235544576
    m_Localized: 'Сыйлықтар:'
    m_Metadata:
      m_Items: []
  - m_Id: 237246657709727744
    m_Localized: LV {0}-де құлпын ашыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 235816862262222848
    m_Localized: ЖАНКҮЙЕРЛЕРГЕ АРНАЛҒАН СЫЙЛЫҚТАР
    m_Metadata:
      m_Items: []
  - m_Id: 235816800794697728
    m_Localized: Біздің өсіп келе жатқан Facebook қауымдастығымызға қосылыңыз және бірге ойнаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 235816831106932736
    m_Localized: ҚАЗІР ҚОСЫЛЫҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 235816773359755264
    m_Localized: Қосылыңыз және бізбен бірге ойнаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 237246673576779776
    m_Localized: Графикасы жақсы
    m_Metadata:
      m_Items: []
  - m_Id: 237246681361408000
    m_Localized: Ойын қызықты
    m_Metadata:
      m_Items: []
  - m_Id: 237246694510551040
    m_Localized: Жарнамалар тым көп
    m_Metadata:
      m_Items: []
  - m_Id: 237246703058542592
    m_Localized: Ойынның қателері бар
    m_Metadata:
      m_Items: []
  - m_Id: 237245482302169088
    m_Localized: Жақсырақ тәжірибе алу үшін соңғы нұсқасына жаңартыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 237245456964378624
    m_Localized: ЖАҢАРТУ
    m_Metadata:
      m_Items: []
  - m_Id: 237620428677308416
    m_Localized: Карточка жіберу
    m_Metadata:
      m_Items: []
  - m_Id: 237665078654001152
    m_Localized: КОМАНДАНЫҢ МҮШЕЛЕРІ
    m_Metadata:
      m_Items: []
  - m_Id: 237687049928302592
    m_Localized: Сіз бұл картаны {0}-ға жіберуге дайынсыз!
    m_Metadata:
      m_Items: []
  - m_Id: 237712387861372928
    m_Localized: Жіберу
    m_Metadata:
      m_Items: []
  - m_Id: 237958163799728128
    m_Localized: Команда құрамындағы мүшелермен карточкалар алмасу үшін командаға қосылыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 237981312209641472
    m_Localized: 'Бұл сұрау мына үшін қол жетімді:'
    m_Metadata:
      m_Items: []
  - m_Id: 238028475220353024
    m_Localized: Күнделікті шек {0}/{1}
    m_Metadata:
      m_Items: []
  - m_Id: 238061569860165632
    m_Localized: карточка сұрау!
    m_Metadata:
      m_Items: []
  - m_Id: 238326946397675520
    m_Localized: КАРТОЧКА АЛЫНДЫ!
    m_Metadata:
      m_Items: []
  - m_Id: 238392037197471744
    m_Localized: Кімнен
    m_Metadata:
      m_Items: []
  - m_Id: 238436267575992320
    m_Localized: КАРТОЧКАНЫ СҰРАУ
    m_Metadata:
      m_Items: []
  - m_Id: 238438330066264064
    m_Localized: '<color=#B5DAFF>Күміс Карточкалар</color> команда мүшелері арасында сыйға берілуі мүмкін.'
    m_Metadata:
      m_Items: []
  - m_Id: 238438440233852928
    m_Localized: '<color=#FDDC25>Алтын Карточкалар</color> тек іс-шаралар мен сыйлықтардан ғана жиналады.'
    m_Metadata:
      m_Items: []
  - m_Id: 239838413705961472
    m_Localized: Бұл картаны іс-шаралардан, сыйлықтардан және команда мүшелерінен алуға болады.
    m_Metadata:
      m_Items: []
  - m_Id: 239838802429861888
    m_Localized: '<color=#FDDC25>Алтын карталар</color> жіберілмейді!'
    m_Metadata:
      m_Items: []
  - m_Id: 239840300178071552
    m_Localized: Оны жіберу үшін сізге дубликат карта қажет.
    m_Metadata:
      m_Items: []
  - m_Id: 239840360295030784
    m_Localized: Сіз уже бүгін 3 картаны жібердіңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 239841109020237824
    m_Localized: Сіз уже бүгін картаны сұрадыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 267800449324670976
    m_Localized: Қайта келдіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 267800545017716736
    m_Localized: Сені сағындық! Сыйлықтарыңды ал да, сапарыңды жалғастыр!
    m_Metadata:
      m_Items: []
  - m_Id: 246035593416400896
    m_Localized: Бұл картаны іс-шаралар мен сыйақылардан алуға болады.
    m_Metadata:
      m_Items: []
  - m_Id: 245969547665858560
    m_Localized: Карта жіберілді!
    m_Metadata:
      m_Items: []
  - m_Id: 247400907857190912
    m_Localized: Бонус сыйақылар
    m_Metadata:
      m_Items: []
  - m_Id: 247401008721813504
    m_Localized: Уақыт шектеусіз сатып алуларды жинап, тамаша сыйақыларға ие болыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 247401059258982400
    m_Localized: "Бас\nжүлде"
    m_Metadata:
      m_Items: []
  - m_Id: 247401253006467072
    m_Localized: БОНУС СЫЙАҚЫЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 247775982527700992
    m_Localized: Құттықтаймыз! Сіз барлық карталарды жинадыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 248229689585295360
    m_Localized: Бонус
    m_Metadata:
      m_Items: []
  - m_Id: 1164245458944
    m_Localized: АЛТЫН ӨТКІЗУ
    m_Metadata:
      m_Items: []
  - m_Id: 1164262236160
    m_Localized: '<color=#FFF200>{0}</color> басталды! Арнайы сыйлықтарды ашудың үшін жұлдыздар жинаңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164262236161
    m_Localized: '<color=#FFF200>{0}</color> аяқталды! Жаңа <color=#FFF200>{1}</color> жақында басталады!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164262236162
    m_Localized: '<color=#FFF200>{0}</color> белсендіру арқылы арнайы сыйлықтарды ашыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164262236163
    m_Localized: Арнайы Сыйлықтар
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430464
    m_Localized: Іс-шара аяқталғанша эксклюзивті бонустар алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430465
    m_Localized: 5 өмір орнына 8
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430466
    m_Localized: Алтын рамка және алтын ат
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430467
    m_Localized: Жұлдыз жина!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430468
    m_Localized: Сыйлықтарды ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430469
    m_Localized: '<color=#FDF36D>{0}</color> белсендіру арқылы арнайы сыйлықтарды ашыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430470
    m_Localized: Құттықтаймыз! Сіз <color=#FFF34F>{0}</color> белсендіруді іске қостыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430471
    m_Localized: Сіздің профиліңіздегі сурет рамкаңыз бен атыңыз алтын!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430472
    m_Localized: Сыйлық командаңызбен бөлісті!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430473
    m_Localized: Өмірдің максималды саны 8-ге көбейтілді!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430474
    m_Localized: БЕЛСЕНДІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430475
    m_Localized: Арнайы сыйлықтарды ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430476
    m_Localized: '<color=#FFF34F>{0}</color> алынды!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430477
    m_Localized: Сіздің сыйлығыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 1164266430478
    m_Localized: Сіз бұл сыйлықты алдым!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624768
    m_Localized: Бұл кезеңді ашу үшін көбірек жұлдыздар табыңыз және бұл сыйлықты ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624769
    m_Localized: Бұл сыйлықты алу үшін {0} алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624770
    m_Localized: Бұл кезеңді аяқтаңыз және {0} ашылса, сыйлыққа қол жеткізіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624771
    m_Localized: '{0} деңгейін аяқтап, {1} ашыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624772
    m_Localized: Бұл кезеңді ашу үшін көбірек жұлдыздар табыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624773
    m_Localized: Келесі кезеңге жету үшін көбірек жұлдыздар табыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624774
    m_Localized: Бұл кезеңді аяқтап, {0} ашыңыз да, Қазына сандығын ашыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624775
    m_Localized: '<color=#FFF34F>{0}</color> алыңыз және іс-шара аяқталғанда барлық тиындарды жинаңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624776
    m_Localized: '<color=#FFF34F>{0}</color> алыңыз және кезеңдер соңында Қазына сандығын ашыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624777
    m_Localized: Әр 10 жұлдыз үшін Қазына Жәшігіне 10 тиын сақтаңыз! Оларды іс-шара аяқталған кезде талап етіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164270624778
    m_Localized: Әр 10 жұлдыз үшін Қазына жәшігінде 10 монетаны сақтау үшін кезеңдерді аяқтаңыз! Іс-шара аяқталған кезде оларды жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819072
    m_Localized: СОҢҒЫ СЫЙЛЫҚ
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819073
    m_Localized: Міне, сіздің талап етілмеген сыйлықтарыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819074
    m_Localized: '<color=#fff34f>{0}</color> ашылды, бұл сіздің алғашқы сыйлығыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819075
    m_Localized: "Деңгейді аяқтау жұлдыздарды жинауға сыйлықтарды ашады! \nОларды жинау тәсілін білу үшін шертіңіз!"
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819076
    m_Localized: '<color=#fff34f>{0}</color> ашып, эксклюзивті сыйлықтарды иеленіңіз!'
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819077
    m_Localized: ӨТКІЗУ ҮШІН ШЕРТІҢІЗ
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819078
    m_Localized: БЕЛСЕНДІ
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819079
    m_Localized: БЕЛСЕНДІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 1164274819080
    m_Localized: Командаңыз үшін сыйлық
    m_Metadata:
      m_Items: []
  - m_Id: 5353076616585216
    m_Localized: Деңгейлерді жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 5372156589367296
    m_Localized: ТЕГІН
    m_Metadata:
      m_Items: []
  - m_Id: 43766314718715904
    m_Localized: РОЖДЕСТВО ПАС
    m_Metadata:
      m_Items: []
  - m_Id: 41612858264379392
    m_Localized: Рождестволық Пасс
    m_Metadata:
      m_Items: []
  - m_Id: 43168464116899840
    m_Localized: Алтын Пасс
    m_Metadata:
      m_Items: []
  - m_Id: 19695394816
    m_Localized: СЁРФИНГ ДҮБІР
    m_Metadata:
      m_Items: []
  - m_Id: 197617770496
    m_Localized: 30 минутта басқа ойыншылардан көбірек қабық жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 233189662720
    m_Localized: ШЕБЕР
    m_Metadata:
      m_Items: []
  - m_Id: 273316569088
    m_Localized: Осы сыйлықтарды алу үшін Сёрфинг шебері жарысын жеңіп алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 301875585024
    m_Localized: Сіз бұл сыйлықтарды сәтті алдыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 444700024832
    m_Localized: Шектеулі уақыт ішінде снарядтарды жинаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 476987777024
    m_Localized: Басқа ойыншыларға қарсы аяқтаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 500748509184
    m_Localized: Керемет сыйлықтар алыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 536987295744
    m_Localized: Серф Рашқа қосыл
    m_Metadata:
      m_Items: []
  - m_Id: 675730677760
    m_Localized: Дәреже
    m_Metadata:
      m_Items: []
  - m_Id: 1395896868864
    m_Localized: Сыйлық
    m_Metadata:
      m_Items: []
  - m_Id: 775722885120
    m_Localized: Ойыншылар ізделуде...
    m_Metadata:
      m_Items: []
  - m_Id: 251465525600706560
    m_Localized: Осы сыйлықтарды алу үшін Сёрфинг дүбірін жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 251109559260667904
    m_Localized: Бұл жиынтықта {0} карта бар!
    m_Metadata:
      m_Items: []
  - m_Id: 253212636654592000
    m_Localized: Кіру күндері
    m_Metadata:
      m_Items: []
  - m_Id: 255097381692891136
    m_Localized: 'Сыйлықтар кезеңі: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 348499468288
    m_Localized: Аяқталды
    m_Metadata:
      m_Items: []
  - m_Id: 348512051200
    m_Localized: Бірінші болып, керемет сыйлықтарды ұтып алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051201
    m_Localized: Алдымен {0} деңгейді аяқтаңыз, Grand Prize-ды жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051204
    m_Localized: '{0} ДЕҢГЕЙ'
    m_Metadata:
      m_Items: []
  - m_Id: 348512051205
    m_Localized: Сіз бірінші Finished!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051206
    m_Localized: Ойыншыларды іздеу...
    m_Metadata:
      m_Items: []
  - m_Id: 348512051207
    m_Localized: САТЫ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 348512051210
    m_Localized: Басқалардан бұрын деңгейлерді жеңіп, тапсырманы аяқтаңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 348512051211
    m_Localized: Керемет сыйақылар алыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051212
    m_Localized: ЖАРЫСҚА ҚОСЫЛЫҢЫЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 348512051213
    m_Localized: ЕДИНОРОГ ЖАРЫСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 348512051209
    m_Localized: Басқа ойыншыларға қарсы тапсырманы бастаңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 9561896378368
    m_Localized: Гранд сыйлық
    m_Metadata:
      m_Items: []
  - m_Id: 348512051203
    m_Localized: Қайталап көріңіз және сыйлықтар үшін алға шығыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 8358106793762816
    m_Localized: ҚАЙТАДАН КӨРІҢІЗ!
    m_Metadata:
      m_Items: []
  - m_Id: 7000105134579712
    m_Localized: ҚҰТТЫҚТАЙМЫН!
    m_Metadata:
      m_Items: []
  - m_Id: 7000232930828288
    m_Localized: ЖАРЫС ТАМАМ
    m_Metadata:
      m_Items: []
  - m_Id: 7000346080567296
    m_Localized: Келесі жолы бірінші болып аяқтаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 8358723339673600
    m_Localized: Аяқтау
    m_Metadata:
      m_Items: []
  - m_Id: 27990813114884096
    m_Localized: Жетіп қалдыңыз! Алға шықыңыз, жетектеңіз және келесі жолы үлкен жеңіске жетіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 40226007532167168
    m_Localized: Единорог Жарысы
    m_Metadata:
      m_Items: []
  - m_Id: 258714048939417600
    m_Localized: ҚОЯН ЖАРЫСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 261220253826015232
    m_Localized: Қоян жарысы
    m_Metadata:
      m_Items: []
  - m_Id: 262986913796841472
    m_Localized: МӘЛІМ.
    m_Metadata:
      m_Items: []
  - m_Id: 262986960378781696
    m_Localized: ТОП
    m_Metadata:
      m_Items: []
  - m_Id: 271045432789950464
    m_Localized: ТОПТЫ ӨҢДЕУ
    m_Metadata:
      m_Items: []
  - m_Id: 273924986122526720
    m_Localized: Үздік командалық ұсыныстар!
    m_Metadata:
      m_Items: []
  - m_Id: 277825505589190656
    m_Localized: ЕСКЕРТУ!
    m_Metadata:
      m_Items: []
  - m_Id: 277825568310812672
    m_Localized: қайта қосыла алмайды.
    m_Metadata:
      m_Items: []
  - m_Id: 277825591157186560
    m_Localized: Бұл топқа қосыла алмайсыз.
    m_Metadata:
      m_Items: []
  - m_Id: 277826028287549440
    m_Localized: ШЫҒАРУ
    m_Metadata:
      m_Items: []
  - m_Id: 278615821602775040
    m_Localized: Деңгей
    m_Metadata:
      m_Items: []
  - m_Id: 278615873058496512
    m_Localized: ДҮНИЕ
    m_Metadata:
      m_Items: []
  - m_Id: 278615967702966272
    m_Localized: МЕЙРІМДЕР
    m_Metadata:
      m_Items: []
  - m_Id: 278616096044474368
    m_Localized: ЕҢ ЖАҚСЫ ОЙЫНШЫЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 278616189900414976
    m_Localized: ЕҢ ЖАҚСЫ КОМАНДАЛАР
    m_Metadata:
      m_Items: []
  - m_Id: 278643930016243712
    m_Localized: РЕЙТИНГ
    m_Metadata:
      m_Items: []
  - m_Id: 278668086418071552
    m_Localized: Ұпай
    m_Metadata:
      m_Items: []
  - m_Id: 280381325501784064
    m_Localized: Сол айдағы команда ұпайыңызды көтеріңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 280381518901141504
    m_Localized: Алға жарысыңыз және аңыз болыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 280382392553693184
    m_Localized: Сол айдағы ұпайыңызды көтеріңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 280723815215915008
    m_Localized: Қабілет
    m_Metadata:
      m_Items: []
  - m_Id: 281101773235544064
    m_Localized: Жоғары
    m_Metadata:
      m_Items: []
  - m_Id: 281101820337577984
    m_Localized: Төмен
    m_Metadata:
      m_Items: []
  - m_Id: 303936521708232704
    m_Localized: СКЕЙТБОРД ЖАРЫСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 303936521725009920
    m_Localized: Скейтборд жарысы
    m_Metadata:
      m_Items: []
  - m_Id: 328674388338532352
    m_Localized: Командалық шабуыл
    m_Metadata:
      m_Items: []
  - m_Id: 328674935795867648
    m_Localized: Мақтануларды жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328675153786429440
    m_Localized: Командаға қосылып, Командалық шабуылға үлес қосыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328675265375887360
    m_Localized: Командадан шықсаңыз, өтіп жатқан Командалық шабуылдан да шығасыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328675424260317184
    m_Localized: Керемет сыйақылар алу үшін деңгейлерді команда болып өтіп, қайықтарды жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328675526479699968
    m_Localized: Үлес жоқ
    m_Metadata:
      m_Items: []
  - m_Id: 328691474817343488
    m_Localized: Командалық шайқас
    m_Metadata:
      m_Items: []
  - m_Id: 328691548192497664
    m_Localized: Топ рейтингі
    m_Metadata:
      m_Items: []
  - m_Id: 328691671190462464
    m_Localized: Жарайсың! Құттықтаймыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328691834302750720
    m_Localized: Қақтығыс
    m_Metadata:
      m_Items: []
  - m_Id: 328691895833190400
    m_Localized: Менің тобым
    m_Metadata:
      m_Items: []
  - m_Id: 328692100393590784
    m_Localized: 'Жеке сыйақылар: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 328692220749144064
    m_Localized: Деңгейлерде су атқыштарды жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692289833525248
    m_Localized: Жеңіске жету үшін командаңызбен шайқасыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692350239891456
    m_Localized: Жеке сыйақылар үшін көбірек жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692455319789568
    m_Localized: Керемет сыйақылар алу үшін командаға қосылып, командаңызбен шайқасыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692559271419904
    m_Localized: Командадан шықсаңыз, өтіп жатқан Командалық шайқастан да шығасыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692653794254848
    m_Localized: Керемет сыйақылар алу үшін су атқыштарды жинап, командаңызбен шайқасыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 328692775722672128
    m_Localized: Жеке марапаттар
    m_Metadata:
      m_Items: []
  - m_Id: 328692921290186752
    m_Localized: Ағымдағы орын
    m_Metadata:
      m_Items: []
  - m_Id: 328693020170903552
    m_Localized: Ағымдағы ұпай
    m_Metadata:
      m_Items: []
  - m_Id: 329403534840684544
    m_Localized: Сыйақыларыңызды алу үшін кемінде бір қайық жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 329403596081717248
    m_Localized: Келесі жолы команда сыйақыларын алу үшін үлес қосыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 330407227346116608
    m_Localized: Командалық шабуыл сыйлықтары
    m_Metadata:
      m_Items: []
  - m_Id: 330407337861832704
    m_Localized: '{0} жеке сыйлығы!'
    m_Metadata:
      m_Items: []
  - m_Id: 330407487313272832
    m_Localized: '{0} командалық сыйлығы!'
    m_Metadata:
      m_Items: []
  - m_Id: 330435785229590528
    m_Localized: Жеке сыйлықтар!
    m_Metadata:
      m_Items: []
  - m_Id: 330443706701176832
    m_Localized: '{0} жеке сыйлығы!'
    m_Metadata:
      m_Items: []
  - m_Id: 331096417918509056
    m_Localized: Басқаларды жеңу үшін деңгейлерден су атқыштарды жинап, үлес қосыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 331096633254076416
    m_Localized: Жеке сыйлықтар алу үшін көбірек жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 331098070130352128
    m_Localized: Келесі жолы сыйлық алу үшін үлес қосыңыз!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
