    m_Metadata:
      m_Items: []
  - m_Id: 158623746145378304
    m_Localized: Nincs csapat
    m_Metadata:
      m_Items: []
  - m_Id: 159757269296209920
    m_Localized: ÉRINTSD MEG A FOLYTATÁSHOZ
    m_Metadata:
      m_Items: []
  - m_Id: 164882056993562624
