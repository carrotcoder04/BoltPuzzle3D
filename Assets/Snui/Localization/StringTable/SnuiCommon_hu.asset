    m_Localized: SZEMÉLYES JUTALMAK
    m_Metadata:
      m_Items: []
  - m_Id: 328692921290186752
    m_Localized: Jelenlegi helyezés
    m_Metadata:
      m_Items: []
  - m_Id: 328693020170903552
