    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661763
    m_Localized: Engedélyezd az értesítést
    m_Metadata:
      m_Items: []
  - m_Id: 156517155132661764
    m_Localized: Engedélyezd a nyomkövetést
    m_Metadata:
      m_Items: []
  - m_Id: 156517155136856064
