  m_TableData:
  - m_Id: 233343164604416
    m_Localized: SZABAD ÉLETEK
    m_Metadata:
      m_Items: []
  - m_Id: 233280816275456
    m_Localized: UTÁNTÖLTÉS
    m_Metadata:
      m_Items: []
  - m_Id: 266123567161344
    m_Localized: HASZNÁLAT
    m_Metadata:
      m_Items: []
  - m_Id: 12288803132661760
    m_Localized: Ingyenes
    m_Metadata:
      m_Items: []
  - m_Id: 304573871808512
    m_Localized: Szabad élet!
    m_Metadata:
      m_Items: []
  - m_Id: 1697441651875840
    m_Localized: Az életetek tele van
    m_Metadata:
      m_Items: []
  - m_Id: 1436200639389696
    m_Localized: Szint mellkas
    m_Metadata:
      m_Items: []
  - m_Id: 12288946942763008
    m_Localized: Különleges gyűjtemény
    m_Metadata:
      m_Items: []
  - m_Id: 1436162156650496
    m_Localized: Csillagláda
    m_Metadata:
      m_Items: []
  - m_Id: 320630867091456
    m_Localized: '{0} Szabad életek'
    m_Metadata:
      m_Items: []
  - m_Id: 264074574159872
    m_Localized: ÉLETBANK
    m_Metadata:
      m_Items: []
  - m_Id: 232529176027136
    m_Localized: SZEREZZ TÖBB ÉLETET
    m_Metadata:
      m_Items: []
  - m_Id: 35481137106116608
    m_Localized: Teljes
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026432
    m_Localized: Csak egyszer ingyenes!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026434
    m_Localized: Kérjük, állítson be egy becenevet
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026435
    m_Localized: Érvénytelen név. Írjon be egy másikat
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026436
    m_Localized: Írjon be legalább 3 karaktert!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026437
    m_Localized: Legfeljebb 15 karaktert írjon be!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026433
    m_Localized: Írd be a becenevedet...
    m_Metadata:
      m_Items: []
  - m_Id: 39808712133566464
    m_Localized: NÉV MÓDOSÍTÁSA
    m_Metadata:
      m_Items: []
  - m_Id: 40123526764552192
    m_Localized: PROFIL SZERKESZTÉSE
    m_Metadata:
      m_Items: []
  - m_Id: 40900277404950528
    m_Localized: KEVESEBB HIRDETÉSEK
    m_Metadata:
      m_Items: []
  - m_Id: 40900312473526272
    m_Localized: Nyomon követés engedélyezése
    m_Metadata:
      m_Items: []
  - m_Id: 40900371902619648
    m_Localized: Engedélyezze a követést az irreleváns hirdetések eltávolításához, és {0} ingyenes érmét kap!
    m_Metadata:
      m_Items: []
  - m_Id: 40900440034893824
    m_Localized: Kérjük, engedélyezze a nyomon követést a jutalmak megszerzéséhez.
    m_Metadata:
      m_Items: []
  - m_Id: 40900487157899264
    m_Localized: Ne maradj le!
    m_Metadata:
      m_Items: []
  - m_Id: 40900528459210752
    m_Localized: Értesítést kaphat a korlátozott idejű eseményekről és frissítésekről.
    m_Metadata:
      m_Items: []
  - m_Id: 41986630234398720
    m_Localized: Most nem
    m_Metadata:
      m_Items: []
  - m_Id: 41986630246981632
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 41991704809562112
    m_Localized: Kérjük, engedélyezze az értesítéseket, hogy időkorlátozott eseményeket és frissítéseket kaphasson.
    m_Metadata:
      m_Items: []
  - m_Id: 42375679755411456
    m_Localized: BEJELENTKEZÉS
    m_Metadata:
      m_Items: []
  - m_Id: 42375726647730176
    m_Localized: Mentsd el az előrehaladásodat ingyen a felhőben!
    m_Metadata:
      m_Items: []
  - m_Id: 45252780607135744
    m_Localized: VÁLASSZON
    m_Metadata:
      m_Items: []
  - m_Id: 45252819287007232
    m_Localized: HOZZON LÉTRE
    m_Metadata:
      m_Items: []
  - m_Id: 50335704901738496
    m_Localized: NEM
    m_Metadata:
      m_Items: []
  - m_Id: 45252991467380736
    m_Localized: MENTÉS
    m_Metadata:
      m_Items: []
  - m_Id: 45199535239061504
    m_Localized: MEGTEKINTÉS
    m_Metadata:
      m_Items: []
  - m_Id: 51007642271735808
    m_Localized: küldött neked egy életet!
    m_Metadata:
      m_Items: []
  - m_Id: 48193240967405568
    m_Localized: Szerezd meg az ingyenes érméket
    m_Metadata:
      m_Items: []
  - m_Id: 48193180493930496
    m_Localized: 'Csatlakozz egy csapathoz vagy hozz létre egyet:'
    m_Metadata:
      m_Items: []
  - m_Id: 52896768214425600
    m_Localized: A csapat kapacitása betelt
    m_Metadata:
      m_Items: []
  - m_Id: 48193207886929920
    m_Localized: Szerezz ingyenes életeket
    m_Metadata:
      m_Items: []
  - m_Id: 52896720361611264
    m_Localized: A szintje nem elegendő a csapathoz való csatlakozáshoz
    m_Metadata:
      m_Items: []
  - m_Id: 48191512465367040
    m_Localized: CSATLAKOZZ EGY CSAPATHOZ
    m_Metadata:
      m_Items: []
  - m_Id: 50334557843480576
    m_Localized: Biztos benne, hogy ki akarja rúgni ezt a játékost?
    m_Metadata:
      m_Items: []
  - m_Id: 50332880616808448
    m_Localized: KIRÚGÁS
    m_Metadata:
      m_Items: []
  - m_Id: 49634758253076480
    m_Localized: MÉGSE
    m_Metadata:
      m_Items: []
  - m_Id: 49634806575652864
    m_Localized: Biztosan el akarja hagyni a csapatát?
    m_Metadata:
      m_Items: []
  - m_Id: 49634666892746752
    m_Localized: TÁVOZÁS
    m_Metadata:
      m_Items: []
  - m_Id: 49634620147228672
    m_Localized: CSAPAT ELHAGYÁSA
    m_Metadata:
      m_Items: []
  - m_Id: 48164027749097472
    m_Localized: Kérjük, ellenőrizze az internetkapcsolatát.
    m_Metadata:
      m_Items: []
  - m_Id: 48163983373361152
    m_Localized: Kapcsolat megszakadt!
    m_Metadata:
      m_Items: []
  - m_Id: 52805192968560640
    m_Localized: A név megváltoztatása sikeres!
    m_Metadata:
      m_Items: []
  - m_Id: 52780918081839104
    m_Localized: Kapcsolódás
    m_Metadata:
      m_Items: []
  - m_Id: 52798812643647488
    m_Localized: Nem támogatott karakter.
    m_Metadata:
      m_Items: []
  - m_Id: 42375933552746496
    m_Localized: BEJELENTKEZÉS APPLEL
    m_Metadata:
      m_Items: []
  - m_Id: 42375887180521472
    m_Localized: BEJELENTKEZÉS FACEBOOKKAL
    m_Metadata:
      m_Items: []
  - m_Id: 42375955442819072
    m_Localized: GOOGLE-LAL VALÓ BEJELENTKEZÉS
    m_Metadata:
      m_Items: []
  - m_Id: 42721386727202816
    m_Localized: A haladásod mentve van.
    m_Metadata:
      m_Items: []
  - m_Id: 42721333207883776
    m_Localized: SIKER
    m_Metadata:
      m_Items: []
  - m_Id: 42730837634965504
    m_Localized: TOVÁBBRA IS KIJELJELENTKEZÉS
    m_Metadata:
      m_Items: []
  - m_Id: 42726401105715200
    m_Localized: A játék újraindul a <color=#EF4C4C>1. szint</color>ről!
    m_Metadata:
      m_Items: []
  - m_Id: 42726463454044160
    m_Localized: 'Tippek: Visszajelentkezéssel folytathatod a haladásod.'
    m_Metadata:
      m_Items: []
  - m_Id: 42726296550105088
    m_Localized: KIJELENTKEZÉS
    m_Metadata:
      m_Items: []
  - m_Id: 45200576651190272
    m_Localized: Kapacitás
    m_Metadata:
      m_Items: []
  - m_Id: 45176701162872832
    m_Localized: LÉTREHOZÁS
    m_Metadata:
      m_Items: []
  - m_Id: 47003035736465408
    m_Localized: SZERKESZTÉS
    m_Metadata:
      m_Items: []
  - m_Id: 45252406294863872
    m_Localized: Szükséges Szint
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111296
    m_Localized: Érje el a {0} szintet a szükséges szintkorlát növeléséhez.
    m_Metadata:
      m_Items: []
  - m_Id: 45252313470722048
    m_Localized: Csapatembléma
    m_Metadata:
      m_Items: []
  - m_Id: 45262366646984704
    m_Localized: VÁLASZD KI A LOGÓT
    m_Metadata:
      m_Items: []
  - m_Id: 45252369947025408
