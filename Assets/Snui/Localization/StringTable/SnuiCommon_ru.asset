    m_Metadata:
      m_Items: []
  - m_Id: 42721333207883776
    m_Localized: УСПЕХ
    m_Metadata:
      m_Items: []
  - m_Id: 42730837634965504
    m_Localized: ПОДТВЕРДИТЬ ВЫХОД
    m_Metadata:
      m_Items: []
  - m_Id: 42726401105715200
    m_Localized: Игра начнется заново с <color=#EF4C4C>уровня 1</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 42726463454044160
    m_Localized: 'Советы: Вы можете снова войти, чтобы возобновить свой прогресс.'
    m_Metadata:
      m_Items: []
