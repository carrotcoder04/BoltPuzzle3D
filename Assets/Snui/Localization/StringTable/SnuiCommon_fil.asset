    m_Metadata:
      m_Items: []
  - m_Id: 238436267575992320
    m_Localized: HUMILING NG KARD
    m_Metadata:
      m_Items: []
  - m_Id: 238438330066264064
    m_Localized: '<color=#B5DAFF>Silver Cards</color> ay maaaring ipagkaloob sa mga kasapi ng grupo.'
    m_Metadata:
      m_Items: []
  - m_Id: 238438440233852928
    m_Localized: '<color=#FDDC25>Gold Cards</color> ay maaaring makuha lamang mula sa mga kaganapan at gantimpala.'
    m_Metadata:
      m_Items: []
  - m_Id: 239838413705961472
    m_Localized: Ang card na ito ay maaaring makuha mula sa mga kaganapan, gantimpala, at mga kasapi ng grupo.
    m_Metadata:
      m_Items: []
  - m_Id: 239838802429861888
    m_Localized: '<color=#FDDC25>Gold cards</color> hindi maaaring ipadala!'
    m_Metadata:
      m_Items: []
  - m_Id: 239840300178071552
    m_Localized: Kailangan mo ng isang duplicate na card upang maipadala ito.
    m_Metadata:
      m_Items: []
  - m_Id: 239840360295030784
    m_Localized: Naipadala mo na ang 3 card ngayon.
    m_Metadata:
      m_Items: []
  - m_Id: 239841109020237824
    m_Localized: Humiling ka na ng card ngayon.
    m_Metadata:
      m_Items: []
  - m_Id: 267800449324670976
    m_Localized: MALIGAYANG PAGBALIK!
    m_Metadata:
      m_Items: []
