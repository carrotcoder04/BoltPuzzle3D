    m_Metadata:
      m_Items: []
  - m_Id: 48193240967405568
    m_Localized: Bedava jeton al
    m_Metadata:
      m_Items: []
  - m_Id: 48193180493930496
    m_Localized: 'Takıma katıl veya takım oluştur:'
    m_Metadata:
      m_Items: []
