  m_SharedData: {fileID: 11400000, guid: 56d4b1d6a9621d04eb877a1525a91b26, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 233343164604416
    m_Localized: मुक्त जीवन
    m_Metadata:
      m_Items: []
  - m_Id: 233280816275456
    m_Localized: फिर से भरना
    m_Metadata:
      m_Items: []
  - m_Id: 266123567161344
    m_Localized: उपयोग
    m_Metadata:
      m_Items: []
  - m_Id: 12288803132661760
    m_Localized: मुफ्त
    m_Metadata:
      m_Items: []
  - m_Id: 304573871808512
    m_Localized: मुक्त जीवन!
    m_Metadata:
      m_Items: []
  - m_Id: 1697441651875840
    m_Localized: आपका जीवन पूर्ण है
    m_Metadata:
      m_Items: []
  - m_Id: 1436200639389696
    m_Localized: समतल छाती
    m_Metadata:
      m_Items: []
  - m_Id: 12288946942763008
    m_Localized: विशेष संग्रह
    m_Metadata:
      m_Items: []
  - m_Id: 1436162156650496
    m_Localized: स्टार चेस्ट
    m_Metadata:
      m_Items: []
  - m_Id: 320630867091456
    m_Localized: '{0} निःशुल्क जीवन'
    m_Metadata:
      m_Items: []
  - m_Id: 264074574159872
    m_Localized: जीवन बैंक
    m_Metadata:
      m_Items: []
  - m_Id: 232529176027136
    m_Localized: अधिक जीवन प्राप्त करें
    m_Metadata:
      m_Items: []
  - m_Id: 35481137106116608
    m_Localized: पूरा
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026433
    m_Localized: अपना उपनाम लिखें...
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026434
    m_Localized: कृपया एक उपनाम सेट करें
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026435
    m_Localized: अमान्य नाम। कोई अन्य लिखें।
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026432
    m_Localized: यह सिर्फ़ एक बार के लिए मुफ़्त है!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026436
    m_Localized: कम से कम 3 अक्षर टाइप करें!
    m_Metadata:
      m_Items: []
  - m_Id: 39824476811026437
    m_Localized: अधिकतम 15 अक्षर टाइप करें!
    m_Metadata:
      m_Items: []
  - m_Id: 39808712133566464
    m_Localized: नाम बदलें
    m_Metadata:
      m_Items: []
  - m_Id: 40123526764552192
    m_Localized: प्रोफ़ाइल संपादित करें
    m_Metadata:
      m_Items: []
  - m_Id: 40900277404950528
    m_Localized: कम विज्ञापन
    m_Metadata:
      m_Items: []
  - m_Id: 40900312473526272
    m_Localized: ट्रैकिंग की अनुमति दें
    m_Metadata:
      m_Items: []
  - m_Id: 40900371902619648
    m_Localized: अप्रासंगिक विज्ञापनों को हटाने और {0} मुफ़्त सिक्के पाने के लिए ट्रैकिंग की अनुमति दें!
    m_Metadata:
      m_Items: []
  - m_Id: 40900440034893824
    m_Localized: पुरस्कार पाने के लिए कृपया ट्रैकिंग की अनुमति दें।
    m_Metadata:
      m_Items: []
  - m_Id: 40900487157899264
    m_Localized: छोड़ें नहीं!
    m_Metadata:
      m_Items: []
  - m_Id: 40900528459210752
    m_Localized: सीमित समय की घटनाओं और अपडेट के बारे में सूचना प्राप्त करें।
    m_Metadata:
      m_Items: []
  - m_Id: 41986630234398720
    m_Localized: अभी नहीं
    m_Metadata:
      m_Items: []
  - m_Id: 41986630246981632
    m_Localized: हाँ
    m_Metadata:
      m_Items: []
  - m_Id: 41991704809562112
    m_Localized: कृपया सीमित समय की घटनाओं और अपडेट्स को प्राप्त करने के लिए सूचनाओं की अनुमति दें।
    m_Metadata:
      m_Items: []
  - m_Id: 42375679755411456
    m_Localized: साइन इन करें
    m_Metadata:
      m_Items: []
  - m_Id: 42375726647730176
    m_Localized: अपनी प्रगति को क्लाउड में निःशुल्क सहेजें!
    m_Metadata:
      m_Items: []
  - m_Id: 45252780607135744
    m_Localized: चुनें
    m_Metadata:
      m_Items: []
  - m_Id: 45252819287007232
    m_Localized: बनाएँ
    m_Metadata:
      m_Items: []
  - m_Id: 50335704901738496
    m_Localized: नहीं
    m_Metadata:
      m_Items: []
  - m_Id: 45252991467380736
    m_Localized: सेव
    m_Metadata:
      m_Items: []
  - m_Id: 45199535239061504
    m_Localized: दृश्य
    m_Metadata:
      m_Items: []
  - m_Id: 51007642271735808
    m_Localized: आपको एक जीवन भेजा!
    m_Metadata:
      m_Items: []
  - m_Id: 48193240967405568
    m_Localized: मुफ्त सिक्के प्राप्त करें
    m_Metadata:
      m_Items: []
  - m_Id: 48193180493930496
    m_Localized: 'इसके लिए टीम से जुड़ें या टीम बनाएं:'
    m_Metadata:
      m_Items: []
  - m_Id: 52896768214425600
    m_Localized: टीम की क्षमता पूरी है
    m_Metadata:
      m_Items: []
  - m_Id: 48193207886929920
    m_Localized: मुफ्त जीवन प्राप्त करें
    m_Metadata:
      m_Items: []
  - m_Id: 52896720361611264
    m_Localized: आपका स्तर इस टीम में शामिल होने के लिए पर्याप्त नहीं है
    m_Metadata:
      m_Items: []
  - m_Id: 48191512465367040
    m_Localized: एक टीम से जुड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 50334557843480576
    m_Localized: क्या आप वाकई इस खिलाड़ी को बाहर करना चाहते हैं?
    m_Metadata:
      m_Items: []
  - m_Id: 50332880616808448
    m_Localized: किक आउट
    m_Metadata:
      m_Items: []
  - m_Id: 49634758253076480
    m_Localized: रद्द करें
    m_Metadata:
      m_Items: []
  - m_Id: 49634806575652864
    m_Localized: क्या आप वाकई अपनी टीम छोड़ना चाहते हैं?
    m_Metadata:
      m_Items: []
  - m_Id: 49634666892746752
    m_Localized: छोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 49634620147228672
    m_Localized: टीम छोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 48164027749097472
    m_Localized: कृपया अपने इंटरनेट कनेक्शन की जाँच करें।.
    m_Metadata:
      m_Items: []
  - m_Id: 48163983373361152
    m_Localized: कनेक्शन खो गया!
    m_Metadata:
      m_Items: []
  - m_Id: 52805192968560640
    m_Localized: नाम सफलतापूर्वक बदल गया!
    m_Metadata:
      m_Items: []
  - m_Id: 52780918081839104
    m_Localized: जुड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 52798812643647488
    m_Localized: अक्षर समर्थित नहीं है।.
    m_Metadata:
      m_Items: []
  - m_Id: 42375933552746496
    m_Localized: एपल के साथ साइन इन करें
    m_Metadata:
      m_Items: []
  - m_Id: 42375887180521472
    m_Localized: फेसबुक के साथ साइन इन करें
    m_Metadata:
      m_Items: []
  - m_Id: 42375955442819072
    m_Localized: साइन इन करें गूगल के साथ
    m_Metadata:
      m_Items: []
  - m_Id: 42721386727202816
    m_Localized: आपकी प्रगति सहेजी गई है।.
    m_Metadata:
      m_Items: []
  - m_Id: 42721333207883776
    m_Localized: सफलता
    m_Metadata:
      m_Items: []
  - m_Id: 42730837634965504
    m_Localized: अब भी साइन आउट
    m_Metadata:
      m_Items: []
  - m_Id: 42726401105715200
    m_Localized: खेल <color=#EF4C4C>स्तर 1</color> से पुनः आरंभ होगा!
    m_Metadata:
      m_Items: []
  - m_Id: 42726463454044160
    m_Localized: 'टिप्स: आप अपनी प्रगति फिर से शुरू करने के लिए वापस साइन इन कर सकते हैं।.'
    m_Metadata:
      m_Items: []
  - m_Id: 42726296550105088
    m_Localized: साइन आउट
    m_Metadata:
      m_Items: []
  - m_Id: 45200576651190272
    m_Localized: क्षमता
    m_Metadata:
      m_Items: []
  - m_Id: 45176701162872832
    m_Localized: बनाएँ
    m_Metadata:
      m_Items: []
  - m_Id: 47003035736465408
    m_Localized: संपादित करें
    m_Metadata:
      m_Items: []
  - m_Id: 45252406294863872
    m_Localized: आवश्यक स्तर
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111296
    m_Localized: स्तर {0} पर पहुँचकर आवश्यक स्तर सीमा बढ़ाइये।.
    m_Metadata:
      m_Items: []
  - m_Id: 45252313470722048
    m_Localized: टीम लोगो
    m_Metadata:
      m_Items: []
  - m_Id: 45262366646984704
    m_Localized: लोगो चुनें
    m_Metadata:
      m_Items: []
  - m_Id: 45252369947025408
    m_Localized: टीम का नाम
    m_Metadata:
      m_Items: []
  - m_Id: 45252486565453824
    m_Localized: '*टीम का लोगो/नाम बनाने के बाद बदला नहीं जा सकता'
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111297
    m_Localized: मदद
    m_Metadata:
      m_Items: []
  - m_Id: 45176682426916864
    m_Localized: शामिल हों
    m_Metadata:
      m_Items: []
  - m_Id: 50241104296009728
    m_Localized: बाहर निकालें
    m_Metadata:
      m_Items: []
  - m_Id: 47002942832631808
    m_Localized: छोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 44926451865083904
    m_Localized: मेरी टीम
    m_Metadata:
      m_Items: []
  - m_Id: 45250024622252032
    m_Localized: टीम का नाम दर्ज करें...
    m_Metadata:
      m_Items: []
  - m_Id: 45199495682580480
    m_Localized: खोजें
    m_Metadata:
      m_Items: []
  - m_Id: 52914664781111298
    m_Localized: इस नाम के लिए कोई परिणाम नहीं है।.
    m_Metadata:
      m_Items: []
  - m_Id: 44926427412291584
    m_Localized: टीम्स
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305600
    m_Localized: तुम्हारे जीवन पूरे हैं
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305601
    m_Localized: आप पहले ही इस अनुरोध में मदद कर चुके हैं।.
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305602
    m_Localized: तुम्हें फिर से मदद करने के लिए {0} मिनट इंतज़ार करना पड़ेगा!
    m_Metadata:
      m_Items: []
  - m_Id: 52914664785305603
    m_Localized: आप पहले ही यह अनुरोध कर चुके हैं।.
    m_Metadata:
      m_Items: []
  - m_Id: 46997273542909952
    m_Localized: 'आवश्यक स्तर:'
    m_Metadata:
      m_Items: []
  - m_Id: 46995160800681984
    m_Localized: 'टीम स्कोर:'
    m_Metadata:
      m_Items: []
  - m_Id: 46002148947779584
    m_Localized: टीम जानकारी
    m_Metadata:
      m_Items: []
  - m_Id: 46996381083099136
    m_Localized: 'साप्ताहिक सहायता:'
    m_Metadata:
      m_Items: []
  - m_Id: 47072008410750976
    m_Localized: सहायता
    m_Metadata:
      m_Items: []
  - m_Id: 47072106691682304
    m_Localized: लीडर
    m_Metadata:
      m_Items: []
  - m_Id: 47072050559311872
    m_Localized: स्तर
    m_Metadata:
      m_Items: []
  - m_Id: 50707987734454272
    m_Localized: जीवन मांगे
    m_Metadata:
      m_Items: []
  - m_Id: 50728058632527872
    m_Localized: '{0} टीम में शामिल हो गया है।.'
    m_Metadata:
      m_Items: []
  - m_Id: 50728091402625024
    m_Localized: '{0} को बाहर कर दिया गया है।.'
    m_Metadata:
      m_Items: []
  - m_Id: 50708198070411264
    m_Localized: अनुरोध
    m_Metadata:
      m_Items: []
  - m_Id: 50736182525419520
    m_Localized: जीवित होने के लिए पूछ रहे हैं!
    m_Metadata:
      m_Items: []
  - m_Id: 57494596047855616
    m_Localized: नई टीम में शामिल होने से पहले आपको अपनी टीम छोड़नी होगी!
    m_Metadata:
      m_Items: []
  - m_Id: 57496004599996416
    m_Localized: रैंक
    m_Metadata:
      m_Items: []
  - m_Id: 57494080442064896
    m_Localized: स्कोर
    m_Metadata:
      m_Items: []
  - m_Id: 56149430573719552
    m_Localized: टीमें
    m_Metadata:
      m_Items: []
  - m_Id: 56149277246742528
    m_Localized: लीडरबोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 56149395333177344
    m_Localized: खिलाड़ी
    m_Metadata:
      m_Items: []
  - m_Id: 57493952461266944
    m_Localized: टीम देखें
    m_Metadata:
      m_Items: []
  - m_Id: 63674767004131328
    m_Localized: प्रतिक्रिया
    m_Metadata:
      m_Items: []
  - m_Id: 63717830468558848
    m_Localized: कृपया अपनी समस्याओं का चयन करें या वर्णन करें
    m_Metadata:
      m_Items: []
  - m_Id: 63717859195346944
    m_Localized: समस्याओं या सुझाव का वर्णन करें
    m_Metadata:
      m_Items: []
  - m_Id: 63717953256808448
    m_Localized: जमा करना
    m_Metadata:
      m_Items: []
  - m_Id: 63719952446644224
    m_Localized: आपका ईमेल यहाँ दर्ज करें
    m_Metadata:
      m_Items: []
  - m_Id: 63740716600254464
    m_Localized: आपकी प्रतिक्रिया के लिए धन्यवाद!
    m_Metadata:
      m_Items: []
  - m_Id: 63741145136488448
    m_Localized: 'सबमिट करने में विफल, कृपया पुन: प्रयास करें।'
    m_Metadata:
      m_Items: []
  - m_Id: 63762870901399552
    m_Localized: लोडिंग विफल हो गया
    m_Metadata:
      m_Items: []
  - m_Id: 63764307005923328
    m_Localized: कृपया अपनी समस्याओं का चयन करें या वर्णन करें
    m_Metadata:
      m_Items: []
  - m_Id: 63764348902825984
    m_Localized: आपका ईमेल यहाँ दर्ज करें
    m_Metadata:
      m_Items: []
  - m_Id: 78010148310736896
    m_Localized: क्या आप इस डिवाइस और हमारे सर्वर से अपना डेटा हटाना चाहते हैं?
    m_Metadata:
      m_Items: []
  - m_Id: 78010253747150848
    m_Localized: आपका गेम डेटा इस डिवाइस और हमारे सर्वर से तुरंत हटा दिया जाएगा। आपका सारा डेटा और आपकी प्रगति खो जाएगी और पुनर्स्थापित करने में असमर्थ होगी।
    m_Metadata:
      m_Items: []
  - m_Id: 78010270369177600
    m_Localized: आपके पास सक्रिय सदस्यताएं हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 78010281240813568
    m_Localized: अधिक शुल्क से बचने के लिए, कृपया App Store > खाता > सदस्यताएं पर जाएं और किसी भी सक्रिय सदस्यता को पहले रद्द करें।
    m_Metadata:
      m_Items: []
  - m_Id: 78010291277783040
    m_Localized: क्या आप निश्चित रूप से अपना डेटा हटाना चाहते हैं? आप अपनी वर्तमान प्रगति खो देंगे और इसे पुनः प्राप्त नहीं किया जा सकेगा।
    m_Metadata:
      m_Items: []
  - m_Id: 78010303109914624
    m_Localized: '"हां" पर टैप करके, आप एक नए उपयोगकर्ता के रूप में गेम को पुनः आरंभ करेंगे।'
    m_Metadata:
      m_Items: []
  - m_Id: 78010720036315136
    m_Localized: मैं समझता हूँ
    m_Metadata:
      m_Items: []
  - m_Id: 95625466474389504
    m_Localized: आपका नाम क्या है?
    m_Metadata:
      m_Items: []
  - m_Id: 95625437298810880
    m_Localized: नाम दर्ज करें
    m_Metadata:
      m_Items: []
  - m_Id: 111216658851291136
    m_Localized: टीम के सदस्यों से मुफ्त जीवन जुटाएँ।
    m_Metadata:
      m_Items: []
  - m_Id: 111930957190127616
    m_Localized: आपके पास कोई मुफ्त जीवन नहीं है।
    m_Metadata:
      m_Items: []
  - m_Id: 115602396111953920
