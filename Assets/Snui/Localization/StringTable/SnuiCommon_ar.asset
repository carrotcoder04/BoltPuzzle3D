    m_Localized: استلم كل عرض لفتح المكافآت المجانية!
    m_Metadata:
      m_Items: []
  - m_Id: 105754502554968064
    m_Localized: لا تنسَ استلام المكافآت المجانية!
    m_Metadata:
      m_Items: []
