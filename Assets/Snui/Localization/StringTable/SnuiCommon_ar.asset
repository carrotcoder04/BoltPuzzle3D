    m_Metadata:
      m_Items: []
  - m_Id: 224668775510695936
    m_Localized: '<color=#fddc25>مجموعة جديدة</color> ستصل قريباً!'
    m_Metadata:
      m_Items: []
  - m_Id: 224920229035106304
    m_Localized: وصل إلى <color={0}>المستوى {1}</color> لفتح المجموعة!
    m_Metadata:
      m_Items: []
