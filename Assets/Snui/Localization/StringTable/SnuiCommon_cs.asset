    m_Metadata:
      m_Items: []
  - m_Id: 238436267575992320
    m_Localized: POŽADOVAT KARTU
    m_Metadata:
      m_Items: []
  - m_Id: 238438330066264064
    m_Localized: '<color=#B5DAFF>Stříbrné karty</color> mohou být darovány mezi členy týmu.'
    m_Metadata:
      m_Items: []
  - m_Id: 238438440233852928
    m_Localized: '<color=#FDDC25>Zlaté karty</color> lze sbírat pouze z událostí a odměn.'
    m_Metadata:
      m_Items: []
  - m_Id: 239838413705961472
    m_Localized: Tuto kartu lze získat z událostí, odměn a od členů týmu.
    m_Metadata:
      m_Items: []
  - m_Id: 239838802429861888
    m_Localized: '<color=#FDDC25>Zlaté karty</color> nelze odeslat!'
    m_Metadata:
      m_Items: []
  - m_Id: 239840300178071552
    m_Localized: Potřebuješ duplicitní kartu, abys ji mohl poslat.
    m_Metadata:
      m_Items: []
  - m_Id: 239840360295030784
    m_Localized: Dnes jsi již poslal 3 karty.
    m_Metadata:
      m_Items: []
  - m_Id: 239841109020237824
    m_Localized: Dnes jsi již požádal o kartu.
    m_Metadata:
      m_Items: []
  - m_Id: 267800449324670976
    m_Localized: VÍTEJTE ZPĚT!
    m_Metadata:
      m_Items: []
  - m_Id: 267800545017716736
    m_Localized: Chyběli jsme ti! Vyzvedni si dárky a pokračuj ve své cestě!
    m_Metadata:
      m_Items: []
  - m_Id: 246035593416400896
