    m_Metadata:
      m_Items: []
  - m_Id: 237958163799728128
    m_Localized: Připoj se k týmu, abys vyměňoval karty s ostatními členy týmu!
    m_Metadata:
      m_Items: []
  - m_Id: 237981312209641472
    m_Localized: 'Tento požadavek je k dispozici pro:'
