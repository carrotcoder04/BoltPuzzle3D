    m_Metadata:
      m_Items: []
  - m_Id: 1164274819075
    m_Localized: "Dokončením úrovně pro sbírání hvězd se odemykají odměny! \nKlepněte se dozvědět, jak je sbírat!"
    m_Metadata:
      m_Items: []
