      m_Items: []
  - m_Id: 40900371902619648
    m_Localized: אפשר מעקב כדי להסיר מודעות לא רלוונטיות וקבל {0} מטבעות בחינם!
    m_Metadata:
      m_Items: []
  - m_Id: 40900440034893824
    m_Localized: אנא אפשר מעקב כדי לקבל תגמולים.
    m_Metadata:
      m_Items: []
  - m_Id: 40900487157899264
    m_Localized: אל תפספסו!
    m_Metadata:
      m_Items: []
  - m_Id: 40900528459210752
    m_Localized: קבל הודעה על אירועים ועדכונים בזמן מוגבל.
    m_Metadata:
      m_Items: []
  - m_Id: 41986630234398720
