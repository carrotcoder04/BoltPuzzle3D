      m_Items: []
  - m_Id: 42028719034851328
    m_Localized: Ved å trykke på Aksepter bekrefter du at du har gjennomgått og akseptert vår <a href=%@>Personvernpolicy</a> og <a href=%@>Vilkår for bruk</a>.
    m_Metadata:
      m_Items: []
  - m_Id: 42028804216971264
    m_Localized: AKSEPTER
    m_Metadata:
      m_Items: []
  - m_Id: 181574557696
    m_Localized: Noe gikk galt, vennligst prøv igjen senere.
    m_Metadata:
      m_Items: []
  - m_Id: 1393523038347264
    m_Localized: Du har allerede krevd belønningen.
    m_Metadata:
      m_Items: []
