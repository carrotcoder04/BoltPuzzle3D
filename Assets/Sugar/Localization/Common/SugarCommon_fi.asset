    m_Localized: HYVÄKSY
    m_Metadata:
      m_Items: []
  - m_Id: 181574557696
    m_Localized: Jotain meni vikaan, yritä uudelleen myöhemmin.
    m_Metadata:
      m_Items: []
  - m_Id: 1393523038347264
    m_Localized: Olet jo lunastanut palkkion.
    m_Metadata:
      m_Items: []
