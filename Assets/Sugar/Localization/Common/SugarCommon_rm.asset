  - m_Id: 42028804216971264
    m_Localized: ANNEHMEN
    m_Metadata:
      m_Items: []
  - m_Id: 181574557696
    m_Localized: Qualche chaschun ha id mal, per plaschair, prüva ulteriur pli tard.
    m_Metadata:
      m_Items: []
  - m_Id: 1393523038347264
    m_Localized: Vus avais gia reclamà il premi.
    m_Metadata:
      m_Items: []
  - m_Id: 1393750491258880
    m_Localized: Il premi è scadì.
    m_Metadata:
      m_Items: []
  - m_Id: 1393766618357760
    m_Localized: Sch’upgrada cun la versiun pli nova.
