    m_Metadata:
      m_Items: []
  - m_Id: 42028719034851328
    m_Localized: Bằng cách chạm vào Chấp nhận, bạn xác nhận rằng bạn đã xem xét và chấp nhận <a href=%@>Chính sách bảo mật</a> và <a href=%@>Điều khoản dịch vụ</a> của chúng tôi.
    m_Metadata:
      m_Items: []
  - m_Id: 42028804216971264
    m_Localized: CHẤP NHẬN
    m_Metadata:
      m_Items: []
  - m_Id: 181574557696
    m_Localized: Đã xảy ra sự cố, vui lòng thử lại sau.
    m_Metadata:
      m_Items: []
  - m_Id: 1393523038347264
    m_Localized: Bạn đã yêu cầu phần thưởng.
    m_Metadata:
      m_Items: []
  - m_Id: 1393750491258880
    m_Localized: Phần thưởng đã hết hạn.
    m_Metadata:
      m_Items: []
  - m_Id: 1393766618357760
    m_Localized: Vui lòng nâng cấp lên phiên bản mới nhất.
    m_Metadata:
      m_Items: []
  - m_Id: 56167706460676096
    m_Localized: Có sự cố gì đó
