  m_TableData:
  - m_Id: 456884477952
    m_Localized: Πώς θα μας αξιολογούσατε;
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: ΥΠΟΒΑΛΛΟΥΝ
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: ΑΞΙΟΛΟΓΗΣΤΕ ΜΑΣ
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: Παρακαλώ πείτε μας τι δεν πάει καλά
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: Παρακαλώ πείτε μας τι φταίει
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: ΛΥΠΆΜΑΙ ΠΟΥ ΤΟ ΑΚΟΎΩ
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: Ελπίζω να λάβω περισσότερες συμβουλές από εσάς
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: Παρακαλώ αφήστε τη γνώμη σας
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: ΕΥΧΑΡΙΣΤΏ
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: Εντάξει
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: Η βαθμολογία και τα σχόλιά σας θα μας βοηθήσουν να βελτιώσουμε το παιχνίδι
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: Αποτυχία αποστολής, παρακαλώ δοκιμάστε ξανά.
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: ΑΠΈΤΥΧΕ
    m_Metadata:
      m_Items: []
  - m_Id: 352322255095586816
    m_Localized: Επίπεδο Δυσκολίας
