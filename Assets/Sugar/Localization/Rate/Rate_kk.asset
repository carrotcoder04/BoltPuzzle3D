  m_SharedData: {fileID: 11400000, guid: 376336e44518ff54d9519b270e11ca2b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 456884477952
    m_Localized: Бізге қандай баға берер едіңіз?
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: ЖІБЕРУ
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: БІЗГЕ БАҒАЛАҢЫЗ
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: Не болып жатқанын айтыңызшы
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: Пікір жазыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: БҰЛДЫ ЕСІТУ ҮШІН ӨКІНІШ
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: Сізден көбірек кеңес алуға үміттенемін
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: Өз пікіріңізді қалдырыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: РАҚМЕТ СІЗГЕ
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: Жарайды
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: Жіберілмеді, әрекетті қайталаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: СӘТСІЗ
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: Сіздің рейтингіңіз бен пікіріңіз ойынды жақсартуға көмектеседі
    m_Metadata:
      m_Items: []
  - m_Id: 352322255095586816
    m_Localized: Деңгей Дүрбелеңі
    m_Metadata:
      m_Items: []
  - m_Id: 352322399882960896
    m_Localized: Жарнама Мәселелері
    m_Metadata:
      m_Items: []
  - m_Id: 352322457621749760
    m_Localized: Ойын Мәселелері
    m_Metadata:
      m_Items: []
  - m_Id: 352322468799569920
    m_Localized: Сатып алу Мәселелері
    m_Metadata:
      m_Items: []
  - m_Id: 352322648710045696
    m_Localized: Іс-шаралар & Марапаттар
    m_Metadata:
      m_Items: []
  - m_Id: 352322700010577920
    m_Localized: Жақсарту Идеялары
    m_Metadata:
      m_Items: []
  - m_Id: 352342747844173824
    m_Localized: Тақырыпты таңдаңыз
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
