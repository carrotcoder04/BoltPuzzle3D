  m_TableData:
  - m_Id: 456884477952
    m_Localized: 您會給我們打幾顆星?
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: 遞交
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: 您的評價有助於助我們改進遊戲
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: 賞個好評
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: 請告訴我們哪裡做得不夠好
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: 寫下您的評價
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: 很遺憾聽到這個消息...
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: 歡迎提供更多的建議
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: 我們樂於傾聽您的想法
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: 十分感謝!
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: 提交失敗，請稍後重試。
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: 啊噢，提交失敗
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: OK
    m_Metadata:
      m_Items: []
