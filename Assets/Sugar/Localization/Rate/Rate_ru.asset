    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: СПАСИБО
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: Не удалось отправить. Повторите попытку.
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: НЕ УДАЛОСЬ
    m_Metadata:
      m_Items: []
