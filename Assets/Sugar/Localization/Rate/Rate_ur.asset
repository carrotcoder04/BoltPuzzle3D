  m_TableData:
  - m_Id: 456884477952
    m_Localized: ہمیں کیسے درجہ دیں؟
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: جمع
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: ہمیں درجہ دیں
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: براہ کرم ہمیں بتائیں کہ کیا غلط ہے
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: تبصرہ لکھیں
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: معذرت خواہ ہیں کہ یہ سنا
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: آپ سے مزید مشورے حاصل کرنے کی امید ہے
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: براہ کرم اپنی رائے چھوڑیں
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: شکریہ
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: ٹھیک ہے
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: بھیجنے میں ناکام ہوگیا، براہ کرم دوبارہ کوشش کریں
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: ناکام ہوگیا
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: آپ کا درجہ اور فیڈبیک ہمیں کھیل کو بہتر بنانے میں مدد کرے گا
    m_Metadata:
      m_Items: []
  - m_Id: 352322255095586816
    m_Localized: لیول کی مشکل
    m_Metadata:
      m_Items: []
  - m_Id: 352322399882960896
    m_Localized: اشتہاری مسائل
    m_Metadata:
      m_Items: []
  - m_Id: 352322457621749760
