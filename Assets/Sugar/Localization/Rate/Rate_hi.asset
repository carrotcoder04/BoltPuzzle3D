  m_SharedData: {fileID: 11400000, guid: 376336e44518ff54d9519b270e11ca2b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 456884477952
    m_Localized: आप हमें कैसे रेटिंग देंगे?
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: जमा करना
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: हमें रेट करें
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: कृपया हमें बताएं कि क्या गलत है
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: कृपया हमें बताएं कि क्या ग़लत है
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: यह सुनकर दुख हुआ
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: आशा है आपसे और सलाह मिलेगी
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: कृपया अपनी राय दें
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: धन्यवाद
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: ठीक
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: आपकी रेटिंग और फीडबैक से हमें गेम को बेहतर बनाने में मदद मिलेगी
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: 'सबमिट करने में विफल, कृपया पुन: प्रयास करें।'
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: असफल
    m_Metadata:
      m_Items: []
  - m_Id: 352322255095586816
    m_Localized: स्तर कठिनाई
    m_Metadata:
      m_Items: []
  - m_Id: 352322399882960896
    m_Localized: विज्ञापन समस्याएँ
    m_Metadata:
      m_Items: []
  - m_Id: 352322457621749760
    m_Localized: खेल समस्याएँ
    m_Metadata:
      m_Items: []
  - m_Id: 352322468799569920
    m_Localized: खरीदारी समस्याएँ
    m_Metadata:
      m_Items: []
  - m_Id: 352322648710045696
    m_Localized: इवेंट्स और पुरस्कार
    m_Metadata:
      m_Items: []
  - m_Id: 352322700010577920
    m_Localized: सुधार के लिए विचार
    m_Metadata:
      m_Items: []
  - m_Id: 352342747844173824
    m_Localized: एक विषय चुनें
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
