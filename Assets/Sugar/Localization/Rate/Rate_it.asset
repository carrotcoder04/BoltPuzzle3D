  m_TableData:
  - m_Id: 456884477952
    m_Localized: Come ci valuteresti?
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: SOTTOSCRIVI
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: La tua valutazione e il tuo feedback ci aiuteranno a migliorare il gioco.
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: VALUTACI
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: Per favore, diteci cosa non va
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: Scrivi un commento.
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: MI DISPIACE SENTIRE QUESTO
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: Speriamo di ricevere più consigli da parte tua.
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: Per favore, lascia la tua opinione.
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: Grazie.
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: Invio non riuscito. Per favore riprova
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: FALLITO
    m_Metadata:
      m_Items: []
