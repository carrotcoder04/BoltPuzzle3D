  m_SharedData: {fileID: 11400000, guid: 376336e44518ff54d9519b270e11ca2b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 456884477952
    m_Localized: چگونه به ما امتیاز می‌دهید؟
    m_Metadata:
      m_Items: []
  - m_Id: 456888672256
    m_Localized: ارسال
    m_Metadata:
      m_Items: []
  - m_Id: 456892866562
    m_Localized: امتیاز بدهید
    m_Metadata:
      m_Items: []
  - m_Id: 456892866563
    m_Localized: لطفاً به ما بگویید چه اشتباهی وجود دارد
    m_Metadata:
      m_Items: []
  - m_Id: 456892866564
    m_Localized: یک نظر بنویسید
    m_Metadata:
      m_Items: []
  - m_Id: 456897060864
    m_Localized: متاسفیم که این را شنیدیم
    m_Metadata:
      m_Items: []
  - m_Id: 456897060865
    m_Localized: امیدواریم که نصیحت‌های بیشتری از شما بگیریم
    m_Metadata:
      m_Items: []
  - m_Id: 456897060866
    m_Localized: لطفاً نظر خود را بگذارید
    m_Metadata:
      m_Items: []
  - m_Id: 456897060867
    m_Localized: ممنون
    m_Metadata:
      m_Items: []
  - m_Id: 67727879299072
    m_Localized: خوب
    m_Metadata:
      m_Items: []
  - m_Id: 67390011334656
    m_Localized: ارسال ناموفق بود، لطفاً دوباره امتحان کنید
    m_Metadata:
      m_Items: []
  - m_Id: 67390028111872
    m_Localized: ناموفق
    m_Metadata:
      m_Items: []
  - m_Id: 456892866560
    m_Localized: امتیاز و بازخورد شما به ما کمک خواهد کرد تا بازی را بهبود ببخشیم
    m_Metadata:
      m_Items: []
  - m_Id: 352322255095586816
    m_Localized: سطح سختی
    m_Metadata:
      m_Items: []
  - m_Id: 352322399882960896
    m_Localized: مسائل تبلیغاتی
    m_Metadata:
      m_Items: []
  - m_Id: 352322457621749760
    m_Localized: مشکلات بازی
    m_Metadata:
      m_Items: []
  - m_Id: 352322468799569920
    m_Localized: مسائل خرید
    m_Metadata:
      m_Items: []
  - m_Id: 352322648710045696
    m_Localized: رویدادها و جوایز
    m_Metadata:
      m_Items: []
  - m_Id: 352322700010577920
    m_Localized: ایده های بهبود
    m_Metadata:
      m_Items: []
  - m_Id: 352342747844173824
    m_Localized: یک موضوع را انتخاب کنید
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
