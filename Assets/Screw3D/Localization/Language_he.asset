  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: טוען נכשל
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: העיצוב טוב
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: המשחק מהנה
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: יותר מדי פרסומות
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: למשחק יש באגים
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: עבור ל "הגדרות מערכת" כדי לאפשר גישה לאלבום.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: להוסיף רק שני חורים
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: אין ברגים לנקות
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: מאסטר בולטים תלת מימד
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: מאסטר בולטים תלת מימד
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: הפרסומת לא מוכנה.
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: אין מספיק מטבעות
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: זה ישמש לספק פרסומות מותאמות אישית ושימוש אופטימלי בשירות.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "מאסטר בולטים תלת מימד\n:פאזל מחט"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "מאסטר בולטים תלת מימד\n:פאזל מחט"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: התאימו ברגים עם קופסאות באותו צבע.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: לטפוח על המסך כדי לסובב את האובייקט.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: לטפוח בשני אצבעות כדי לזום את האובייקט.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: החורים מחזיקים ברגים לא תואמים זמנית!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: בוא נאסוף את כל הברגים!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: עבודה טובה
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: נסה שוב
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: כמעט שם
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: הוסף קופסה אחת והמשך!
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: נקה חורים והמשך!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: הוסף חור
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: מקדחה
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: פטיש
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: שבור חפץ
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: מטאטא
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: נקו חורים
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: הַפסָקָה
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: הקש על אובייקט כדי לשבור אותו.
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: תנאי שירות
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: מדיניות פרטיות
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: טוען
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: רמה {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "מזל טוב! \n<color=#FDDC25>\"סקרו מניה\"</color> הושלם!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: ישנם {0} "ברגים מיוחדים" מוסתרים ברמה.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: אסוף <color=#FDDC25>ברגים מיוחדים</color> כדי לזכות בפרסים!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: פתח פרסים
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: אסוף ברגים מיוחדים
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: עבור שלבים
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: סקרו מניה
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: הושלם
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: נצח שלבים!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: צא
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: אסוף ברגים
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: '!אסוף {0} מבצעים'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: השתמש בכלי "מקדחה" כדי להוסיף חור נוסף.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: השתמש בכלי "פטיש" כדי לשבור חפץ.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: השתמש בכלי "מטאטא" כדי לנקות את החורים.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: עיוור צבעים
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: בית
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: השתמש בכלי לעזרה!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: לְהַמשִׁיך?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: פתח שלב {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: בונוס
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: ההתקדמות שלך שוחזרה.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: עדכון גרסה
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: אנא עדכן לגרסה האחרונה כדי ליהנות מחוויה טובה יותר.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: עדכון
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"מאניה בורג" נפתח! אסוף ברגים מיוחדים כדי לזכות בפרסים!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: כלי חדש
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: לא נעול!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: מתנה ברמה
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: זכה בעוד רמות כדי לקבל פרסים!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: לְהַחִיוֹת
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: רמה לא גמורה
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "יש לך התקדמות לא גמורה ברמה.\nהאם תרצה להמשיך?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: המודעות המתקדמות שלך כבר הוסרו!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "אין פרסומות קופצות!\nאין פרסומות באנר!\n<color=#ffde00>פרסומות מתגמלות אופציונליות לקבלת פרסים נוספים!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: השתמש ב-{0} מקדחות
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: השתמש ב-{0} פטישים
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: השתמש ב-{0} מטאטאים
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: אסוף {0} קופסאות כלים
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: פשוט פתח, התאמה, הנח... וזכה!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: נגמרו אביזרים? הקש על אייקון האביזרים כדי לקנות עם מטבעות!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: נכשלת? הקש על כפתור המטבע להמשך!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: השתמש במטבעות כדי לקנות אביזרים או להחיות את הבמה!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: מצב עיוור צבעים נמצא בהגדרות. הרבה יותר ברור!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: היכנס דרך ההגדרות כדי לסנכרן את המשחק שלך!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: הדק חזק, חשוב בחדות!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: תיכשל במ<color=#C31439>קוביות קופצות!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: אתה תאבד את <color=#C31439>חייך</color> ואת <color=#C31439>אוספים מיוחדים!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: אתה תאבד את <color=#C31439>אוספים מיוחדים!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: אתה תפסיד את <color=#C31439>מסע הבלונים!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: שחק
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: הפעל ל <color=#FFFF0B>שעה אחת</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: פרס עדכון
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: תודה על העדכון שלך! הנה כמה מתנות בשבילך!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: הוסף קופסה
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: הוסף 1 קופסאות
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: אתגר רמה!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: שלב נכשל!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: ניצחת {0} שלבים וזכית בפרסים אלו!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: סקרו מניה
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: תיכשל במ<color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: אתה תפסיד
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: קשה
    m_Metadata:
      m_Items: []
  references:
    version: 2
