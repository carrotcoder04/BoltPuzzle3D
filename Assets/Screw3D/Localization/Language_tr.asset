  m_TableData:
  - m_Id: 365780000768
    m_Localized: YÜKLEME BAŞARISIZ
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Yeterli miktarda madeni para yok
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: TEKRAR DENE
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: 1 kutu ekleyin ve devam edin!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Bir delik ekleyin
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: Matkap
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: Çekiç
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Bir nesneyi kır
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: Süpürge
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Delikleri temizle
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: DURAKLAT
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Bir nesneye dokunarak kırın.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: YÜKLENİYOR
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafik iyi
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Oyun eğlenceli
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Çok fazla reklam var
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Oyunda hatalar var
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: '"Sistem Ayarları"''na giderek albüme erişimi etkinleştir.'
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Sadece iki delik ekle
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Temizlenecek vida yok
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Reklem hazır değil.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Bu, kişiselleştirilmiş reklamlar ve optimize edilmiş hizmet kullanımı sağlamak için kullanılacaktır.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nVida Sıkışması"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nVida Sıkışması"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Aynı renkteki kutularla vidaları eşleştir.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Nesneyi döndürmek için parmağınızı kaydırın.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Nesneyi büyütmek için iki parmakla kaydırın.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Delikler, eşleşmeyen vidaları geçici olarak tutar!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Haydi tüm vidaları toplayalım!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: ÇOK GÜZEL!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: NEREDEYİZ?
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Deliği temizle ve devam et!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Hizmet Şartları
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Gizlilik Politikasını
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: SEVİYE {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Tebrikler! \n<color=#FDDC25>\"VİDA ÇILGINLIĞI\"</color> tamamlandı!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Seviyede saklanan {0} "Özel Vida" var.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Ödülleri kazanmak için <color=#FDDC25>Özel Vidaları</color> toplayın!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Ödülleri açın
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Özel vidaları toplayın
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Seviyeleri geçin
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: VİDA ÇILGINLIĞI
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: BİTTİ
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Seviyeleri Geç!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: ÇIKIŞ
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: vida toplayın
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: '{0} özel ürünleri topla!'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: “Matkap” aracını kullanarak bir delik daha ekleyin.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Bir nesneyi kırmak için “Çekiç” aracını kullanın.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Delikleri temizlemek için “Süpürge” aracını kullanın.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: RENK KÖRÜ
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ANA SAYFA
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Yardım etmek için ALETİ kullan!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: DEVAM EDİYOR MUSUN?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Seviye {0}'i Açın
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: İlerlemeniz geri yüklendi.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: SÜRÜM GÜNCELLEMESİ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Daha iyi bir deneyim için lütfen en son sürüme güncelleyin.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: GÜNCELLEME
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"VİDA ÇILGINLIĞI" açıldı! Ödülleri kazanmak için özel vidaları toplayın!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: YENİ ARAÇ KİLİDİ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: AÇILDI!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: SEVİYE HEDİYESİ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Ödül almak için daha fazla seviye kazanın!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: CANLANDIRMAK
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: TAMAMLANMAMIŞ DÜZEY
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Tamamlanmamış seviye ilerlemeniz var.\nDevam etmek ister misiniz?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Otomatik Reklamlarınız zaten kaldırıldı!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Açılır reklam yok!\n- Banner reklam yok!\n<color=#ffde00>- Ekstra ödüller için isteğe bağlı ödüllü reklamlar!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: '{0} matkap kullanın!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: '{0} çekiç kullanın!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: '{0} süpürge kullanın!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: '{0} alet kutusu topla!'
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Sök, eşleştir, yerleştir… ve kazan!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Aksesuarlar bitti mi? Para ile satın almak için aksesuar simgesine dokunun!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Başaramadın mı? Devam etmek için para butonuna dokunun!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Aksesuar satın almak veya sahneyi canlandırmak için paraları kullanın!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Renk Körlüğü Modu Ayarlar'da. Çok daha net!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Oyununuzu senkronize etmek için Ayarlar üzerinden giriş yapın!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Sıkı vida, keskin düşün!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: '<color=#C31439>Küpler Atlama!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: '<color=#C31439>Canını</color> ve <color=#C31439>özel koleksiyonlarını</color> kaybedeceksin!'
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: '<color=#C31439>Özel koleksiyonlarınızı</color> kaybedeceksiniz!'
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: '<color=#C31439>Balon Yolculuğu</color> kaybedeceksiniz!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: OYNA
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktive edin <color=#FFFF0B>1 saat</color> için!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: GÜNCELLEME HEDİYESİ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Güncellemeniz için teşekkürler! İşte size bazı hediyeler!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: KUTU EKLE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: 1 kutu ekle
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: MÜCADELE SEVİYESİ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Seviye Başarısız oldu!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: '{0} seviyeyi kazanarak bu ödülleri kazandınız!'
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: VİDA ÇILGINLIĞI
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: '<color=#C31439>{0}!</color>'
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Kaybedeceklerin
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: ZOR
