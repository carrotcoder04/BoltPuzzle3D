    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Geen rekwisieten? Tik op het rekwisietenicoon om te kopen met munten!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
