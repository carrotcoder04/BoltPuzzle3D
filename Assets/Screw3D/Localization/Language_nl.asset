    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Geen pop-upadvertenties!\n- Geen banneradvertenties!\n<color=#ffde00>- Optionele beloningsadvertenties voor extra beloningen!</color>"
