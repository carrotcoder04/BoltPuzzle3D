  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: La publicité n'est pas prête.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Ceci sera utilisé pour fournir des publicités personnalisées et une utilisation optimisée du service.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master : \nPuzzle à Vis"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master : \nPuzzle à Vis"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Associez les vis avec les boîtes de la même couleur.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Glissez le doigt pour faire pivoter l'objet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Glissez deux doigts pour zoomer sur l'objet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Les trous maintiennent temporairement des vis non assorties !
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Rassemblons toutes les vis !
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: BIEN JOUÉ !
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: PRESQUE LÀ
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Dégagez les trous et continuez !
    m_Metadata:
      m_Items: []
