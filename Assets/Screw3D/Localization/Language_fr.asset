    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Trop de publicités
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Le jeu a des bogues
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Allez dans les "Paramètres du système" pour activer l'accès à l'album.
