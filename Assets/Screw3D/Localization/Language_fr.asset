    m_Localized: NIVEAU {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Félicitations pour l'achèvement de \n<color=#FDDC25>\"MANIE DES VIS\"</color> !"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Il y a {0} "Vis Spéciales" cachées dans le niveau.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Collectionnez <color=#FDDC25>Vis Spéciale</color> pour gagner des récompenses !
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Débloquez les récompenses
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Collectionnez les vis spéciales
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Résolvez les niveaux
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIE DES VIS
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
