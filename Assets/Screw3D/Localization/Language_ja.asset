MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: Language_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: 画像のアップロードに失敗しました
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: グラフィックが綺麗
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: ゲームが楽しい
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: 広告が多すぎる
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: ゲームにバグがある
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: 「システム設定」から写真へのアクセスを許可してください。
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: 穴の数は最大2つまでです
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: 取り外すネジはない
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: 広告の準備ができていません
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: コインが足りない。
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: パーソナライズ広告の表示、およびサービスの最適化に利用されます。
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master:\nネジパズルゲーム"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master:\nネジパズルゲーム"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: 同じ色のボックスにネジを入れよう！
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: スワイプでオブジェクトを回転！
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: ピンチ操作で拡大・縮小
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: 穴にネジを一時的にキープできるよ！
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: やり直す
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: ボックスを1つ追加して継続！
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: 穴を追加
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: ドリル
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: ハンマー
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: オブジェクトを壊す
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: ほうき
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: 穴を空ける
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: 一時停止
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: タップでオブジェクトを粉砕
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: 読み込み中
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: すべてのネジを回収しよう！
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: 素晴らしい!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: あと少し！
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: 穴を空けてコンティニュー！
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: 利用規約
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: プライバシーポリシー
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: ステージ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "おめでとう!\n<color=#FDDC25>「スクリューマニア」</color>すべてクリア!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: このステージには{0}個の「特別なネジ」が隠されている。
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: '<color=#FDDC25>「特別なネジ」</color>を集めて報酬をゲット!'
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: 報酬をアンロック!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: 特別なネジを集めよう
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: ステージをクリア
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: スクリューマニア
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: 完了
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: ステージクリア!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: 終了
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: ネジを集める
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: 特別なネジを{0} 個集める!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: 「ドリル」を使ってもう一つ穴を開けてみよう。
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: 「ハンマー」を使ってモデルの一部を壊してみよう。
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: 「ほうき」を使って穴を掃除してみよう。
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: 色覚サポート
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ホーム
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: アイテムを使ってサクサク攻略しよう！
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: 続けますか？
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: ステージ {0} で解放
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: ボーナス
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: 進捗状況が復元されました
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: バージョンアップ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: 最高の体験のために最新版へアップデートしてください。
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: アップデート
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: "スクリューマニア開催中!\nスペシャルスクリューを集めて報酬をゲット!"
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: 新しい道具をアンロック
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: アンロックした!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: ステージギフト
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: さらに多くのステージをクリアして報酬をゲットしよう!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: 復活
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: プレイ中のステージ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "中断しているステージがあります。\n続きからプレイしますか？"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: ポップアップ広告はすでに削除されました!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "-ポップアップ広告なし!\n-バナー広告なし!\n<color=#ffde00>-報酬付き広告は、好きなときに視聴可能!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: ドリルを {0} 個使う!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: ハンマーを {0} 個使う!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: ほうきを {0} 個使う!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: '{0} のボックスを集める!'
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: ネジを外して、揃えて、収納… 勝利を目指しましょう！
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: アイテムが足りない？アイコンをタップしてコインで購入！
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: 失敗しちゃった？コインを使って続けましょう！
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: コインでアイテム購入やステージ復活ができるよ！
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: 「色覚サポート」は設定から。もっと見やすく！
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: "設定からログインして、\nデータをシンクロしよう!"
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: ネジはキュッと回して、頭はキレッと冴えわたれ!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: '<color=#C31439>キューブジャンプ</color>に失敗しますよ!'
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: '<color=#C31439>ライフ</color>と<color=#C31439>特別なコレクション</color>を失います!'
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: "<color=#C31439>特別コレクション</color>を\n失います!"
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: '<color=#C31439> バルーンツアー</color>を失います!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: 続ける
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: '<color=#FFFF0B>1 時間</color>有効!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: アップデートギフト
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: アップデートありがとうございます!ギフトはこちら！
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ボックス追加
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: ボックスを1個追加
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: チャレンジステージ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: ステージ失敗！
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: '{0}ステージをクリアして、以下の報酬を獲得しました！'
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: スクリューマニア
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: '<color=#C31439>{0}</color> は失敗扱いとなります！'
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: 失われるアイテム
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: 難しい
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
