  m_TableData:
  - m_Id: 365780000768
    m_Localized: IND LÆSNING MISLYKKEDES
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Ikke nok mønter
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: PRØV IGEN
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Tilføj 1 kasse og fortsæt!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Tilføj et hul
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: BOR
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: HAMMER
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Bræk et objekt
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: SOPPE
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Ryd hullene
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUSE
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Tryk på et objekt for at smadre det.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: INDLÆSER
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafik er god
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Spillet er sjovt
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: For mange annoncer
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Spillet har fejl
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Gå til "Systemindstillinger" for at aktivere adgang til album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Tilføj kun to huller
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Ingen skruer at rense
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Annoncen er ikke klar.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Dette vil blive brugt til at levere personlige annoncer og optimeret servicebrug.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nSkruenål Fast"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nSkruenål Fast"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Match skruer med de samme farve kasser.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Fingerstryg for at rotere objektet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: To fingerstryg for at zoome ind på objektet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Huller holder uoverensstemmende skruer midlertidigt!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Lad os samle alle skruerne!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: GODT GJORT!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: NÆSTEN DER
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Ryd hullerne og fortsæt!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Brugervilkår
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Privatlivspolitik
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: NIVEAU {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Tillykke!\n<color=#FDDC25>\"SKRUE MANIA\"</color> færdiggjort!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Der er {0} "Specielle Skruer" gemt i niveauet.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Samle <color=#FDDC25>Specielle Skruer</color> for at vinde belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Lås belønninger op!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Samle specielle skruer
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Klarg niveauer
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: SKRUE MANIA
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: AFSLUTTET
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: VIND NIVEAUER!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: STOP
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Indsaml skruer
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Indsaml {0} særlige ting!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Brug værktøjet “Bor” for at tilføje et hul mere.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Brug “Hammer”-værktøjet til at knække en genstand.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Brug “Soppe”-værktøjet til at rydde hullerne.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: FARVEBLINDE
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: HJEM
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Brug VÆRKTØJ til at hjælpe!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: FORTSÆTTE?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Niveau{0} låses op
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Dine fremskridt er blevet gendannet.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: VERSION OPDATERING
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Opdater venligst til den nyeste version for at nyde en bedre oplevelse.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: OPDATERING
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"SKRU MANIA" låst op! Saml specielle skruer for at vinde belønninger!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NYT VÆRKTØJ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: LÅST OP!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: NIVEAU GAVE
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Vind flere niveauer for at få belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: GENOPLIVE
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: UFÆRDIG NIVAU
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Du har ufuldendt niveau fremskridt.\nVil du fortsætte?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Dine automatiserede annoncer er allerede fjernet!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Ingen popup-reklamer!\n- Ingen bannerreklamer!\n<color=#ffde00>- Valgfrie belønningsreklamer for ekstra belønninger!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Brug {0} boremaskiner!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Brug {0} hamre!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Brug {0} koste!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Samle {0} værktøjsbokse!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Skru af, match, placér… og vind!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Mangler du rekvisitter? Tryk på rekvisitikonet for at købe med mønter!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Mislykkedes? Tryk på møntknappen for at fortsætte!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Brug mønter til at købe rekvisitter eller genoplive scenen!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Farveblindtilstand er i Indstillinger. Meget klarere!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Log ind via Indstillinger for at synkronisere dit spil!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Skru fast, tænk skarpt!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Du vil fejle i <color=#C31439>Terninge springende!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Du vil miste dit <color=#C31439>liv</color> og <color=#C31439>Special samlinger!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Du vil miste dine <color=#C31439>Særlige samlinger!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Du vil miste din <color=#C31439>Balon rejse!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: SPIL VIDERE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktivér i <color=#FFFF0B>1 time</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: OPDATER GAVE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Tak for din opdatering! Her er nogle gaver til dig!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: TILFØJ BOKS
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Tilføj 1 kasser
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: UDFORDRINGSNIVEAU!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Niveau mislykkedes!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Du har vundet {0} niveauer og tjent disse belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: SKRUE MANIA
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Du vil fejle i <color=#C31439>Terninge springende!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Du mister
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: SVÆR
    m_Metadata:
      m_Items: []
  references:
    version: 2
