    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Kamu masih punya progres level yang belum selesai.\nLanjutkan sekarang?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Iklan otomatis Anda telah dihapus!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Tanpa iklan pop-up!\n- Tanpa iklan banner!\n<color=#ffde00>- Iklan berhadiah hanya jika Anda ingin dapat hadiah ekstra!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Gunakan {0} bor!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Gunakan {0} palu!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
