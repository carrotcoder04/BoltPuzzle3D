  m_TableData:
  - m_Id: 365780000768
    m_Localized: FALHA NO CARREGAMENTO
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Moedas insuficientes.
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: TENTE NOVAMENTE
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Adicione 1 caixa e continue!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Adicionar um buraco
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: BROCA
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: MARTELO
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Quebre um objeto
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: VASSOURA
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Limpe os buracos
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUSA
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Toque em um objeto para esmagá-lo.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: CARREGANDO
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Os gráficos são bons
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: O jogo é divertido
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Muitos anúncios
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: O jogo tem bugs
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Vá para "Configurações do Sistema" para habilitar o acesso ao álbum.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Adicione apenas dois buracos
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Nenhum parafuso para limpar
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: O anúncio não está pronto.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Isso será usado para fornecer anúncios personalizados e otimizar o uso do serviço.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nParafuso preso"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nParafuso preso"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Combine os parafusos com as caixas da mesma cor.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Deslize o dedo para girar o objeto.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Aperte para ampliar.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Os buracos seguram parafusos não combinados temporariamente!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Vamos coletar todos os parafusos!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: BEM FEITO!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: QUASE LÁ
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Limpe os buracos e continue!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Termos de Serviço
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Política de Privacidade
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: NÍVEL {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Parabéns! \n<color=#FDDC25>\"MANIA DO PARAFUSO\"</color> concluída!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Existem {0} "Parafusos Especiais" escondidos no nível.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Colete <color=#FDDC25>Parafusos Especiais</color> para ganhar recompensas!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Desbloqueie recompensas!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Colete parafusos especiais
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Complete níveis
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIA DO PARAFUSO
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: CONCLUÍDO
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Vença os níveis!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: SAIR
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Colete parafusos
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Colete {0} especiais!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Use a ferramenta "Broca" para fazer mais um furo.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Use a ferramenta “Martelo” para quebrar um objeto.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Use a ferramenta “Vassoura” para limpar os furos.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: MODO DALTÔNICO
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: INÍCIO
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Use a FERRAMENTA para ajudar!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: CONTINUAR?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Desbloquear Nível {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BÔNUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Seu progresso foi restaurado.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: ATUALIZAÇÃO DE VERSÃO
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Por favor, atualize para a versão mais recente para aproveitar uma melhor experiência.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: ATUALIZAÇÃO
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MANIA DOS PARAFUSOS" desbloqueada! Colete parafusos especiais para ganhar recompensas!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NOVA FERRAMENTA
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: DESBLOQUEADA!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: PRESENTE DE NÍVEL
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Ganhe mais níveis para obter recompensas!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: REVIVER
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: NÍVEL INCOMPLETO
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Você tem um nível inacabado.\nDeseja continuar?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Os anúncios pop-up foram removidos!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Sem anúncios pop-up!\n- Sem anúncios em banner!\n<color=#ffde00>- Anúncios recompensados opcionais para recompensas extras!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Use {0} brocas!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Use {0} martelos!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Use {0} vassouras!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Colete {0} caixas de ferramentas!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Desaparafuse, combine, coloque... e vença!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Ficou sem adereços? Toque no ícone de adereços para comprar com moedas!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Falhou? Toque no botão de moeda para continuar!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Use moedas para comprar adereços ou reviver a fase!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: O Modo Daltônico está nas Configurações. Muito mais claro!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Faça login nas Configurações para sincronizar seu jogo!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Aperte bem, pense rápido!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: "Você falhará na\n<color=#C31439>Cubos saltando!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Você perderá uma <color=#C31439>vida</color> e <color=#C31439>itens especiais!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Você perderá seus <color=#C31439>itens especiais!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Você perderá sua <color=#C31439>Viagem De Balão!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Ative por <color=#FFFF0B>1 hora</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: PRESENTE DE ATUALIZAÇÃO
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Obrigado pela sua atualização! Aqui estão alguns presentes para você!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ADICIONAR CAIXA
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Adicionar 1 caixa
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: NÍVEL DE DESAFIO!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Nível falhou!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Você venceu {0} níveis e ganhou estas recompensas!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MANIA DO PARAFUSO
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Você falhará na <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
