  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: LASTAUS EPÄONNISTUI
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Ei tarpeeksi kolikoita
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: YRITÄ UUDELLEEN
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Lisää 1 laatikko ja jatka!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Lisää reikä
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: PORA
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: HELMETTI
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Rikoita esine
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: HARJA
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Poista reiät
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: TAUKO
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Napauta esinettä murskataksesi sen.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: LADATAAN
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafiikka on hyvä
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Peli on hauska
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Liian monta mainosta
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Pelissä on bugeja
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Mene "Järjestelmäasetuksiin" ottaaksesi albumin käyttöön.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Lisää vain kaksi reikää
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Ei ruuveja poistettavaksi
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Pulttimestari
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Pulttimestari
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Mainosta ei ole valmis.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Tätä käytetään tarjotaksesi personoituja mainoksia ja optimoitua palvelun käyttöä.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Pulttimestari: \nRuuvipinjami"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Pulttimestari: \nRuuvipinjami"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Yhdistä ruuvit saman värisiin laatikoihin.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Sormen pyyhkäisy kääntää objektia.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Kahden sormen pyyhkäisy zoomaa objektia.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Reiät pitävät vastaamattomat ruuvit väliaikaisesti!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Kerätään kaikki ruuvit!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: HYVIN TEHTY!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: LÄHES PERILLÄ
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Tyhjennä reiät ja jatka!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Käyttöehdot
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Tietosuojakäytäntö
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: TASO {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Maligayang Bati!\n<color=#FDDC25>\"MALING BOLTAHE\"</color> natapos na!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: May {0} "Espesyal na Bolts" na nakatago sa antas.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Kolektahin ang <color=#FDDC25>Espesyal na Bolts</color> upang manalo ng mga gantimpala!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Buksan ang mga reward!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Kolektahin ang mga espesyal na bolts
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Tapusin ang mga antas
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MALING BOLTAHE
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: VALMIS
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Voita tasoja!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: QUIT
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Kerää ruuveja
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Kerää {0} erikoisesineet!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Käytä “Porakone”-työkalua lisätäksesi vielä yhden reiän.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Käytä “Helmetti”-työkalua esineen rikkomiseen.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Käytä “Harja”-työkalua reikien puhdistamiseen.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: VÄRISOKEA
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: KOTI
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Käytä TYÖKALUA avuksi!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: JATKAA?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Peli tasolle{0} lukituksen poisto
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Edistymisesi on palautettu.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: VERSIOPÄIVITYS
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Ole hyvä ja päivitä uuteen versioon nauttiaksesi paremmasta kokemuksesta.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: PÄIVITÄ
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MALING BOLTAHE" avattu! Kerää erityisiä ruuveja voittaaksesi palkintoja!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: UUSI TYÖKALU
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: AUKES!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: TASON LAHJA
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Voita lisää tasoja saadaksesi palkintoja!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: ELVYTTÄÄ
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: VALMIINA OLEVA TASO
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Sinulla on kesken oleva tason eteneminen.\nHaluatko jatkaa?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Automatisoidut mainoksesi on jo poistettu!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Ei ponnahdusmainoksia!\n- Ei bannerimainoksia!\n<color=#ffde00>- Vapaaehtoisia palkkiomainoksia ylimääräisistä palkkioista!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Käytä {0} harjoituksia!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Käytä {0} vasaroita!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Käytä {0} siivoja!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Kerää {0} työkalupakkia!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Avaa, sovita, aseta... ja voita!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Tarvikkeet loppu? Napauta tarvikkeiden kuvaketta ostaaksesi kolikoilla!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Epäonnistuiko? Napauta kolikoita jatkaaksesi!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Käytä kolikoita ostaaksesi tarvikkeita tai elvyttääksesi kentän!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Värihäiriötila on asetuksissa. Paljon selvempää!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Kirjaudu sisään asetusten kautta synkronoidaaksesi pelisi!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Kierrä tiukasti, ajattele terävästi!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Epäonnistut <color=#C31439>Kuutioiden Hyppy!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Tulet menettämään <color=#C31439>elämäsi</color> ja <color=#C31439>Erikoiskokoelmat!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Tulet menettämään <color=#C31439>Erikoiskokoelmasi!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Tulet menettämään <color=#C31439>Ilmapallon Matka!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: LEIKI
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktivoi <color=#FFFF0B>1 tunniksi</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: PÄIVITYSLAHJA
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Kiitos päivityksestäsi! Tässä on joitakin lahjoja sinulle!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: LISÄÄ LAATIKKO
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Lisää 1 laatikkoa
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: HASTETASO!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Tason epäonnistuminen!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Voitit {0} tasoa ja ansaitsit nämä palkinnot!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MALING BOLTAHE
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Epäonnistut <color=#C31439>Kuutioiden Hyppy!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Menetät
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: VAIKEA
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
