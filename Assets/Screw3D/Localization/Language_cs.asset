  m_TableData:
  - m_Id: 365780000768
    m_Localized: NAČTENÍ SELHALO
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Nedostatek mincí
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: ZKUSIT ZNOVU
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Přidejte 1 krabici a pokračujte!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Přidejte díru
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: Vrták
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: Kladivo
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Rozbijte předmět
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: Koště
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Vyčistěte díry
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUZA
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Klepněte na objekt, abyste ho rozbili.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: NAČÍTÁNÍ
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafika je dobrá
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Hra je zábavná
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Příliš mnoho reklam
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Hra má chyby
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Přejděte do "Nastavení systému" k povolení přístupu k albu.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Přidejte pouze dvě díry
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Žádné šrouby k odstranění
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Reklama není připravena.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Toto bude použito k poskytování personalizovaných reklam a optimalizaci uživatelského zážitku.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nŠroubovací hra"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nŠroubovací hra"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Slaďte šrouby se stejnými barevnými krabicemi.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Pohyb prstu k otočení objektu.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Pohyb dvou prstů k přiblížení objektu.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Díry dočasně drží nesouosé šrouby!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Pojďme shromáždit všechny šrouby!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: DOBRÁ PRÁCE!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: SKORO HOTOVO
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Odstraňte díry a pokračujte!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Podmínky užívání
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Zásady ochrany soukromí
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: ÚROVEŇ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Gratulujeme! \n<color=#FDDC25>\"ŠROUBOVÁ MÁNIE\"</color> byla dokončena!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: V úrovni je skryto {0} "Speciálních Šroubů".
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Sbírejte <color=#FDDC25>Speciální Šrouby</color> a získejte odměny!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Odemkni odměny!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Sbírejte speciální šrouby
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Dokonči úrovně
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: ŠROUBOVÁ MÁNIE
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: DOKONČENO
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Vyhrajte úrovně!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: KONEC
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Sbírejte šrouby
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Sbírej {0} speciály!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Použijte nástroj „Vrták“ pro přidání dalšího otvoru.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Použijte nástroj „kladivo“ k rozbití objektu.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Použijte nástroj „koště“ k vyčištění děr.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: BARVA BLIND
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: DOMOV
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Použijte NÁSTROJ k pomoci!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: POKRAČOVAT?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Odemknout na LV {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Váš postup byl obnoven.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: AKTUALIZACE VERZE
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Prosím, aktualizujte na nejnovější verzi, abyste si užili lepší zážitek.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: AKTUALIZACE
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"ŠROUBOVÁ MANIE" odemčeno! Sbírejte speciální šrouby, abyste získali odměny!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NOVÝ NÁSTROJ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: ODEZVĚN!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: LEVEL DÁREK
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Vyhrajte více úrovní a získejte odměny!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: OŽIVIT
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: NEDOKONČENÁ ÚROVEŇ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Máte nedokončený postup v úrovni.\nChtěli byste pokračovat?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Vaše automatizované reklamy již byly odstraněny!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Žádné vyskakovací reklamy!\n- Žádné bannerové reklamy!\n<color=#ffde00>- Volitelné odměněné reklamy pro extra odměny!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Použijte {0} vrtačky!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Použijte {0} kladiva!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Použijte {0} košťata!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Získejte {0} toolboxů!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Odšroubujte, slaďte, umístěte… a vyhrajte!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Máte nedostatek rekvizit? Klepněte na ikonu rekvizit a kupte je za mince!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Nepodařilo se? Klepněte na tlačítko mincí, abyste pokračovali!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Použijte mince k nákupu rekvizit nebo oživení úrovně!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Režim pro barvoslepé je v nastavení. Mnohem jasnější!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Přihlaste se přes nastavení, abyste synchronizovali svou hru!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Pořádně utáhněte, myslete ostře!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Selžete v <color=#C31439>Skákačí kuby!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Ztratíte svůj <color=#C31439>život</color> a <color=#C31439>speciální sbírky!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Ztratíte své <color=#C31439>Speciální sbírky!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Ztratíte svou <color=#C31439>Cesta Balónů!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: HRAJTE DÁL
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktivujte na <color=#FFFF0B>1 hodinu</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: DÁREK AKTUALIZACE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Děkujeme za vaši aktualizaci! Zde jsou nějaké dárky pro vás!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: PŘIDAT KRABIČKU
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Přidat 1 krabic
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: ÚROVEŇ VÝZVY!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Úroveň neúspěšná!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Vyhrál(a) jsi {0} úrovní a získal(a) jsi tyto odměny!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: ŠROUBOVÁ MÁNIE
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Selžete v <color=#C31439>Skákačí kuby!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Ztratíte
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: TĚŽKÁ
    m_Metadata:
      m_Items: []
  references:
