  m_TableData:
  - m_Id: 365780000768
    m_Localized: MUATAN GAGAL
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Tiada cukup syiling
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: CUBA SEMULA
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Tambah 1 kotak dan teruskan!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Tambah lubang
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: PEMBORAN
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: PEMUKUL
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Memecahkan objek
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: PENYAPU
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Bersihkan lubang
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: JEDA
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Ketik objek untuk memecahkannya.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: MEMBUAT
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafik adalah baik
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Permainan adalah menyeronokkan
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Terlalu banyak iklan
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Permainan mempunyai pepijat
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Pergi ke "Tetapan Sistem" untuk mengaktifkan akses ke album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Hanya tambahkan dua lubang
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Tiada skru untuk dibersihkan
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Iklan belum siap.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Ini akan digunakan untuk memberikan iklan tersuai dan penggunaan perkhidmatan yang dioptimumkan.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nSelai Sekrup"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nSelai Sekrup"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Padankan skru dengan kotak warna yang sama.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Geser jari untuk memutar objek.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Geser dua jari untuk memperbesar objek.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Lubang menahan skru yang tidak sepadan sementara!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Mari kumpulkan semua skru!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: KERJA YANG BAIK!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: HAMPIR SAMPAI
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Bersihkan lubang dan teruskan!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Terma Perkhidmatan
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Dasar Privasi
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: LEVEL {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Tahniah!\n<color=#FDDC25>\"MANIA SKRU\"</color> telah diselesaikan!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Terdapat {0} "Skru Istimewa" yang tersembunyi dalam tahap ini.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Kumpulkan <color=#FDDC25>Skru Istimewa</color> untuk memenangi ganjaran!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Buka ganjaran
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Kumpulkan skru istimewa
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Tumpaskan tahap
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIA SKRU
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: SELESAI
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Menang tahap!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: BERHENTI
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Kumpul skru
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Kumpul {0} khas!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Gunakan alat “PEMBORAN” untuk menambah satu lagi lubang.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Gunakan alat “PEMUKUL” untuk memecahkan objek.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Gunakan alat “PENYAPU” untuk membersihkan lubang.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: BUTA WARNA
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: RUMAH
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Gunakan ALAT untuk membantu!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: TERUSKAN?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Tingkat{0} Dibuka
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Kemajuan anda telah dipulihkan.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: KEMAS KINI VERSE
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Sila kemas kini ke versi terkini untuk menikmati pengalaman yang lebih baik.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: KEMAS KINI
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MANIA SKRU" dibuka! Kumpul skru khas untuk memenangi ganjaran!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: ALAT BAHARU
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: Dibuka!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: HADIAH TINGKAT
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Menangi lebih banyak tahap untuk mendapatkan ganjaran!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: HIDUPKAN SEMULA
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: TAHAP BELUM SIAP
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Anda mempunyai kemajuan tahap yang belum selesai.\nAdakah anda ingin meneruskan?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Iklan Automatik anda sudah dibuang!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Tiada iklan pop-up!\n- Tiada iklan banner!\n<color=#ffde00>- Iklan berganjaran pilihan untuk ganjaran tambahan!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Gunakan {0} gerudi!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Gunakan {0} tukul!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Gunakan {0} penyapu!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Kumpul {0} kotak alat!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Legakan, padankan, letakkan… dan menang!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Tiada props? Ketuk ikon prop untuk membeli dengan syiling!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Gagal? Ketuk butang syiling untuk teruskan!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Gunakan syiling untuk membeli props atau bangkitkan tahap!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Mod Buta Warna ada di Tetapan. Lebih jelas!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Log masuk melalui Tetapan untuk menyegerakkan permainan anda!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Kencangkan skru, fikir tajam!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Anda akan gagal dalam <color=#C31439>Kubus Meloncat!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Anda akan kehilangan <color=#C31439>kehidupan</color> dan <color=#C31439>koleksi Istimewa!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Anda akan kehilangan koleksi <color=#C31439>Istimewa!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Anda akan kehilangan <color=#C31439>Perjalanan Belon!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: MAIN
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktifkan untuk <color=#FFFF0B>1 jam</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: HADIAH KEMASKINI
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Terima kasih atas kemas kini anda! Ini adalah beberapa hadiah untuk anda!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: TAMBAH KOTAK
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Tambah 1 kotak
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: TAMBAHAN CABARAN!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Tahap Gagal!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Anda telah memenangi {0} peringkat dan memperoleh ganjaran ini!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MANIA SKRU
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Anda akan gagal dalam <color=#C31439>Kubus Meloncat!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Anda akan kehilangan
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: SUKAR
    m_Metadata:
      m_Items: []
