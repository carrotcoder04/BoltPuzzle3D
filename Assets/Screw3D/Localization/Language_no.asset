  m_TableData:
  - m_Id: 365780000768
    m_Localized: LASTING MISLYKTES
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Ikke nok mynter
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: PRØV IGJEN
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Legg til 1 boks og fortsett!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Legg til et hull
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: BORE
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: HAMMER
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Knus et objekt
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: KOST
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Rydd hullene
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUSE
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Trykk på et objekt for å knuse det.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: LASTER
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafikken er god
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Spillet er moro
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: For mange annonser
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Spillet har feil
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Gå til "Systeminnstillinger" for å aktivere tilgang til album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Legg bare til to hull
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Ingen skruer å rydde
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Annonsen er ikke klar.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Dette vil bli brukt for å gi personlige annonser og optimalisert bruk av tjenesten.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nSkrueklemme"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nSkrueklemme"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Matcher skruer med bokser i samme farge.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Sveip med fingeren for å rotere objektet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Sveip med to fingre for å zoome inn på objektet.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Hull holder uoverensstemmende skruer midlertidig!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: La oss samle alle skruene!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: BRA JOBBET!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: NÆRMER SEG
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Rydd hull og fortsett!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Vilkår for bruk
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Personvernerklæring
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: NIVÅ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Gefeliciteerd!\n<color=#FDDC25>\"SCHROEF MANIA\"</color> voltooid!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Er zijn {0} "Speciale Schroeven" verborgen in het niveau.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Verzamel <color=#FDDC25>Speciale Schroeven</color> om de beloningen te winnen!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Beloningen ontgrendelen
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Verzamel speciale schroeven
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Missies behalen
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: SCHROEF MANIA
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: FERDIG
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Vinn nivåer!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: SLUTT
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Samle skruer
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Samle {0} spesialer!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Bruk “Boremaskin”-verktøyet for å legge til et hull til.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Bruk “Hammer”-verktøyet for å knuse en gjenstand.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Bruk “Kost”-verktøyet for å rengjøre hullene.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: FARGEBLIND
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: HJEM
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Bruk VERKTØY for å hjelpe!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: FORTSETTE?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Lås opp nivå {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Fremdriften din er gjenopprettet.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: VERSJONSOPPDATERING
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Vennligst oppdater til den nyeste versjonen for å få en bedre opplevelse.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: OPPDATERING
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"SCHROEF MANIA" låst opp! Samle spesielle skruer for å vinne belønningene!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NYTT VERKTØY
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: LÅST OPP!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: NIVÅGAVE
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Vinn flere nivåer for å få belønninger!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: GJENOPPLIVE
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: UFULLFØRT NIVÅ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Du har uferdig nivå fremgang.\nVil du fortsette?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Dine automatiserte annonser er allerede fjernet!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Ingen popup-annonser!\n- Ingen bannerannonser!\n<color=#ffde00>- Valgfrie belønnetannonser for ekstra premier!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Bruk {0} bor!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Bruk {0} hammer!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Bruk {0} kost!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Samle {0} verktøykasser!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Skru av, matche, plassere… og vinn!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Tom for rekvisitter? Trykk rekvisitaknappen for å kjøpe med mynter!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Feilet? Trykk på myntenknappen for å fortsette!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Bruk mynter for å kjøpe rekvisitter eller gjenopplive scenen!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Fargeblind modus er i innstillingene. Klart bedre!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Logg inn via innstillinger for å synkronisere spillet ditt!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Skru stramt, tenk klart!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Du vil feile <color=#C31439>Kuber Hopper!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Du vil miste ditt <color=#C31439>liv</color> og <color=#C31439>Spesielle samlinger!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Du vil miste dine <color=#C31439>Spesielle samlinger!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Du vil miste din <color=#C31439>Balloon Reise!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: SPILL VIDERE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktiver i <color=#FFFF0B>1 time</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: OPPDATER GAVE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Takk for oppdateringen! Her er noen gaver til deg!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: LEGG TIL BOKS
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Legg til 1 bokser
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: UTFORDRINGSNIVÅ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Nivå mislyktes!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Du har vunnet {0} nivåer og tjent disse belønningene!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: SCHROEF MANIA
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Du vil feile <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Du vil miste
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: VANSKELIG
