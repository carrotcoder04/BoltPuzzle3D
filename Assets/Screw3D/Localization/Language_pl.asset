  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: ŁADOWANIE NIEUDANE
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Brak wystarczającej liczby monet
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: POWTÓRZ
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Dodaj 1 pudełko i kontynuuj!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Dodaj dziurę
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: Wiertło
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: Młotek
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Złam przedmiot
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: Miotła
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Wyczyść dziury
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUZA
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Stuknij w obiekt, aby go zniszczyć.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: ŁADOWANIE
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Grafika jest dobra
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Gry są zabawne
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Zbyt wiele reklam
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Gra ma błędy
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Przejdź do "Ustawienia systemowe", aby włączyć dostęp do albumu.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Dodaj tylko dwa otwory
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Brak śrub do usunięcia
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Reklama nie jest jeszcze gotowa.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: To będzie używane do dostarczania spersonalizowanych reklam i optymalizacji korzystania z usługi.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nZacięcie śruby"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nZacięcie śruby"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Dopasuj śruby do pudełek w tym samym kolorze.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Przesuń palcem, aby obrócić obiekt.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Przesuń dwoma palcami, aby powiększyć obiekt.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Otwory tymczasowo utrzymują niedopasowane śruby!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Zbierajmy wszystkie śruby!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: DOBRA ROBOTA!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: PRAWIE GOTOWE
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Opróżnij otwory i kontynuuj!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Warunki korzystania z usługi
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Polityka prywatności
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: POZIOM {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Gratulacje!\n<color=#FDDC25>\"MANIA WKRĘTÓW\"</color> zakończona!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: W poziomie ukrytych jest {0} "Specjalnych Wkrętów".
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Zbieraj <color=#FDDC25>Specjalne Wkręty</color>, aby zdobyć nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Odblokuj nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Zbieraj specjalne wkręty
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Pokonaj poziomy
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIA WKRĘTÓW
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: ZAKOŃCZONE
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Wygraj poziomy!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: ZAKOŃCZ
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Zbieraj śruby
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Zbieraj {0} specjalne!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Użyj narzędzia „Wiertło”, aby dodać jeszcze jedno otwór.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Użyj narzędzia „Młotek”, aby rozbić obiekt.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Użyj narzędzia „Miotła”, aby oczyścić dziury.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: DALENOSKÓRA
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: DOM
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Użyj NARZĘDZIA, aby pomóc!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: KONTYNUOWAĆ?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Odblokuj poziom{0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Twoje postępy zostały przywrócone.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: AKTUALIZACJA WERSJI
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Proszę zaktualizować do najnowszej wersji, aby cieszyć się lepszymi doświadczeniami.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: AKTUALIZACJA
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MANIA WKRĘTÓW" odblokowana! Zbieraj specjalne śruby, aby zdobyć nagrody!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NOWE NARZĘDZIE
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: ODBLOKOWANE!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: PREZENT NA POZIOMIE
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Wygraj więcej poziomów, aby zdobyć nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: WSKRZESIĆ
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: NIEDOKOŃCZONY POZIOM
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Masz niedokończony postęp na poziomie.\nCzy chcesz kontynuować?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Twoje automatyczne reklamy zostały już usunięte!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Brak wyskakujących reklam!\n- Brak reklam banerowych!\n<color=#ffde00>- Opcjonalne reklamy z nagrodą za dodatkowe korzyści!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Użyj {0} wierteł!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Użyj {0} młotków!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Użyj {0} mioteł!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Zbierz {0} skrzynek narzędziowych!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Odkręć, dopasuj, umieść… i wygraj!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Brak rekwizytów? Dotknij ikony rekwizytów, aby kupić za monety!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Nie udało się? Dotknij przycisku monety, aby kontynuować!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Użyj monet do zakupu rekwizytów lub ożywienia etapu!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Tryb daltonisty jest w Ustawieniach. Dużo wyraźniej!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Zaloguj się przez Ustawienia, aby zsynchronizować swoją grę!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Mocno dokręć, myśl ostro!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Nie uda ci się <color=#C31439>Skaczące Kostki!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Stracisz swoje <color=#C31439>życie</color> i <color=#C31439>specjalne zbiory!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Stracisz swoje <color=#C31439>Specjalne kolekcje!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Stracisz swoją <color=#C31439>Wędrówka Balonowa!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: GRAJ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Aktywuj na <color=#FFFF0B>1 godzinę</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: PREZENT AKTUALIZACYJNY
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Dziękujemy za twoje aktualizacje! Oto kilka prezentów dla Ciebie!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: DODAJ PUDEŁKO
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Dodaj 1 pudełek
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: POZIOM WYZWANIA!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Nie udało się przejść poziomu!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Wygrałeś {0} poziomów i zdobyłeś te nagrody!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MANIA WKRĘTÓW
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Nie uda ci się <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Stracisz
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: TRUDNY
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
