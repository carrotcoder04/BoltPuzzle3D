%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: Language_kk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: kk
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: ЖҮКТЕУ СӘТСІЗ АЯҚТАЛДЫ
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Монета жеткіліксіз
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: ҚАЙТАЛАУ
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: 1 қорап қосыңыз және жалғастырыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Бір тесікті қосыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: БҰРҒЫ
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: ҰРЫШ
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Объекті сындыру
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: ШЕШІР
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Тесіктерді тазалаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: ТОҚТАТУ
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Затқа соққы жасаңыз, оны сындыру үшін.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: ЖҮКТЕЛУ
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Графика жақсы
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Ойын қызықты
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Жарнамалар тым көп
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Ойында қателер бар
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: “Жүйе параметрлері” бөліміне өтіп, альбомға қолжетімділікті қосыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Тек екі тесік қосыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Тазалайтын бұрандалар жоқ
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D болт шебері
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D болт шебері
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Жарнама дайын емес.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Бұл жекелендірілген жарнамалар мен оңтайландырылған қызметті пайдалану үшін қолданылады.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D болт шебері: \nбұрандалы ойын"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D болт шебері: \nбұрандалы ойын"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Бұрандаларды бір түсті қораптармен сәйкестендіріңіз.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Объектіні айналдыру үшін саусақты сырғытыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Объектіні ұлғайту үшін екі саусақты сырғытыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Тесіктер сәйкес келмейтін бұрандаларды уақытша ұстайды!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Барлық бұрандаларды жинайық!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: Жарайсың
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: Аз қалды!
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Тесіктерді тазалап, жалғастырыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Қызмет көрсету шарттары
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Құпиялық саясаты
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: ДЕҢГЕЙ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Құттықтаймыз!\n<color=#FDDC25>\"БОЛТ МАНИЯСЫ\"</color> аяқталды!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Деңгейде {0} "Арнайы Болт" жасырылған.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Сыйлықтарды жеңу үшін <color=#FDDC25>Арнайы Болттарды</color> жинаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Құндылықтарды ашу
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: арнайы болттарды жинаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Бағдарламаларды жеңу
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: БОЛТ МАНИЯСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: АЯҚТАЛДЫ
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Деңгейлерді жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: ШЫҒУ
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Бұрандаларды жинаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: '{0} aрнайы жинау!'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Тағы бір тесу үшін “БҰРҒЫ” құралын пайдаланыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: “ҰРЫШ” құралын қолданып, нысанды сындыру.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: “ШЕШІР” құралын пайдаланып тесіктерді тазалаңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: ТҮСТІ ТҮСІРУ
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ҮЙ
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Pomozte si nástrojem TOOL!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: ЖАЛҒАСТЫРУ?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: LV {0} деңгейінде ашу
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: БОНУС
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Сіздің прогрессіңіз қалпына келтірілді.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: НҰСҚА ЖАҢАРТУ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Жақсырақ тәжірибе алу үшін соңғы нұсқаға жаңартыңыз.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: ЖАҢАРТУ
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"БОЛТ МАНИЯСЫ" ашылды! Құнды сыйлықтарды алу үшін арнайы бұрандаларды жинаңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: ЖАҢА ҚҰРАЛ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: АШЫЛДЫ!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: ДЕҢГЕЙ СЫЙЫ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Сыйлықтарды алу үшін көбірек деңгейлерді жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: Жаңғыру
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: ДОҢДЕЛГЕН ДЕҢГЕЙ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Сізде аяқталмаған деңгей прогресі бар.\nЖалғастырғыңыз келе ме?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Сіздің автоматтандырылған жарнамаларыңыз жойылды!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Қалқыма жарнамалар жоқ!\n- Баннерлік жарнамалар жоқ!\n<color=#ffde00>- Қосымша сыйлықтар үшін қосымша сыйлықты жарнамалар!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: '{0} бұрғыларын пайдаланыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: '{0} балғаларды пайдаланыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: '{0} метлаларды пайдаланыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: '{0} құралдар жәшігін жинаңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Бұрап, сәйкестендіріп, орналастырыңыз... және жеңіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Ресурстар таусылды ма? Монеталарға сатып алу үшін ресурс белгішесін басыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Сәтсіздікке ұшырадыңыз ба? Жалғастыру үшін монета батырмасын басыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Ресурстарды сатып алу немесе кезеңді қайта тіріліп қалу үшін монеталарды пайдаланыңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Түс көру режимі параметрлерде. Айқынырақ!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Ойынның синхрондалуы үшін параметрлер арқылы кіріңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Бұрау мықты, ойлау өткір!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Сіз <color=#C31439>Кубиктер секіріп жатыр!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Сіз <color=#C31439>өміріңізді</color> және <color=#C31439>Арнайы коллекциялар</color> жоғалтасыз!
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Сіз <color=#C31439>Арнайы жинақтарыңызды</color> жоғалтып аласыз!
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Сіз <color=#C31439>Шар Саяхаты</color> жоғалтып аласыз!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: ОЙНАУ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: '<color=#FFFF0B>1 сағатты</color> іске қосыңыз!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: ЖАҢАРТУ СЫЙЛЫҒЫ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Жаңартқаныңыз үшін рақмет! Мұнда сізге арналған бірнеше сыйлықтар!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ҚОСУ ЖОБАСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: 1 қорап қосыңыз
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: СЫНЫП ДЕҢГЕЙІ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Деңгейдің сәтсіз аяқталуы!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Сіз {0} деңгейді жеңіп, осы сыйлықтарды жеңдіңіз!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: БОЛТ МАНИЯСЫ
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Сіз <color=#C31439>Кубиктер секіріп жатыр!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Мыналардан айырыласыз
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: ҚИЫН
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
