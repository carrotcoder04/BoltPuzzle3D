  m_LocaleId:
    m_Code: ur
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: لوڈنگ ناکام
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: گرافک اچھا ہے
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: کھیل مزےدار ہے
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: بہت زیادہ اشتہارات ہیں
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: کھیل میں کچھ غلطیاں ہیں
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: البم تک رسائی کے لیے "سسٹم کی ترتیبات" پر جائیں.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: صرف دو سوراخ شامل کریں
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: صاف کرنے کے لیے کوئی پیچ نہیں ہیں
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D اسکرو پن جام
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D اسکرو پن جام
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: اشتہار تیار نہیں ہے.
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: کافی سکے نہیں ہیں
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: یہ ذاتی اشتہارات اور بہتر سروس استعمال فراہم کرنے کے لیے استعمال کیا جائے گا.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D بولٹ ماسٹر\n: اسکرو پن جام"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D بولٹ ماسٹر\n: اسکرو پن جام"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: ایک ہی رنگ کے خانوں کے ساتھ پیچ ملائیں.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: شے کو گھمانے کے لیے انگلی سے سوائپ کریں.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: شے کو زوم کرنے کے لیے دو انگلیوں سے سوائپ کریں.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: سوراخ عارضی طور پر ناکارہ پیچ رکھیں گے!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: آئیں سب پیچ اکٹھا کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: بہت اچھا
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: دوبارہ کوشش کریں
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: تقریباً پہنچ گئے
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: 1 باکس شامل کریں اور جاری رکھیں!
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: سوراخ صاف کریں اور جاری رکھیں!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: ایک سوراخ شامل کریں
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: ڈرل
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: ہتھوڑا
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: کسی چیز کو توڑ دو
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: جھاڑو
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: سوراخ صاف کریں
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: توقف
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: کسی چیز پر ٹیپ کریں اور اسے توڑ دیں۔
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: خدمت کی شرائط
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: رازداری کی پالیسی
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: لوڈ ہو رہا ہے
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: سطح {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "مبارک ہو! \n<color=#FDDC25>\"سکرو مینیا\"</color> مکمل ہوا!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: لیول میں {0} "خصوصی سکرو" پوشیدہ ہیں۔
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: انعامات جیتنے کے لئے <color=#FDDC25>خصوصی سکرو</color> جمع کریں! حیرت انگیز انعامات حاصل کرنے کے لئے تمام اہم سنگ میل مکمل کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: انعامات ان لاک کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: خصوصی سکرو جمع کریں
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: لیولز مکمل کریں
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: سکرو مینیا
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: ختم ہو گیا
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: سطحیں جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: چھوڑ دیں
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: اسکرو جمع کریں
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: '{0} خاص پیچ جمع کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: '"ڈرل" ٹول استعمال کریں اور ایک اور سوراخ ڈالیں۔'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: '"ہتھوڑی" ٹول کا استعمال کریں تاکہ کسی چیز کو توڑا جا سکے۔'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: '"جھاڑو" ٹول کا استعمال کریں تاکہ سوراخ صاف کیے جا سکیں۔'
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: کلر بلائنڈ
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: گھر
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: مدد کے لیے اوزار استعمال کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: جاری رکھیں؟
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: LV {0} پر کھولیں
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: بونس
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: آپ کی ترقی بحال ہو گئی ہے۔
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: ورژن اپ ڈیٹ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: بہتر تجربے کے لیے براہ کرم جدید ترین ورژن میں اپ ڈیٹ کریں۔
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: اپ ڈیٹ
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"سکرو مینس" انلاک ہو گیا! انعامات جیتنے کے لیے خاص سکرو جمع کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: نیا ٹول
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: غیر مقفل!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: لیول گفٹ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: انعامات حاصل کرنے کے لیے مزید سطحیں جیتیں!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: زندہ کرنا
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: نامکمل سطح
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "آپ کے پاس غیر مکمل سطح کی پیشرفت ہے۔\nکیا آپ جاری رکھنا چاہیں گے؟"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: آپ کے خودکار اشتہارات پہلے ہی ہٹا دیے گئے ہیں!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "کوئی پاپ اپ اشتہارات نہیں!\nکوئی بینر اشتہارات نہیں!\n<color=#ffde00>اضافی انعامات کے لیے اختیاری انعامی اشتہارات!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: '{0} ڈرلز استعمال کریں'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: '{0} ہتھوڑے استعمال کریں'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: '{0} جھاڑو استعمال کریں'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: '{0} ٹول باکس جمع کریں'
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: ڈھیلا کرو، میچ کرو، رکھو… اور جیتو!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: سامان ختم ہو گیا؟ سکہ کے آئیکون پر ٹیپ کریں تاکہ خرید سکیں!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: ناکام؟ جاری رکھنے کے لیے سکہ کے بٹن پر ٹیپ کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: سامان خریدنے یا اسٹیج کو زندہ کرنے کے لیے سکوں کا استعمال کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: رنگ بصیرت موڈ سیٹنگز میں ہے۔ بہت واضح!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: اپنی کھیل کو ہم وقت ساز کرنے کے لیے سیٹنگز کے ذریعے لاگ ان کریں!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: سختی سے جڑیں، تیز سوچیں!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: آپ <color=#C31439>مکعبوں کا چھلانگ لگانا!</color> میں ناکام ہوں گے
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: آپ اپنی <color=#C31439>زندگی</color> اور <color=#C31439>خاص مجموعوں!</color> کو کھو دیں گے۔
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: آپ اپنے <color=#C31439>خاص مجموعات!</color> کھو دیں گے
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: آپ اپنے <color=#C31439>غبارے کا سفر!</color> کو کھو دیں گے
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: کھیلیں
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: '<color=#FFFF0B>1 گھنٹہ</color> کے لئے چالو کریں!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: اپ ڈیٹ کا تحفہ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: آپ کی تازہ کاری کا شکریہ! آپ کے لئے کچھ تحائف یہاں ہیں!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: بক্স شامل کریں
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: 1 خانوں کا اضافہ کریں
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: چیلنج کی سطح!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: سطح ناکام!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: آپ نے {0} لیولز جیتے اور یہ انعامات حاصل کیے!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: سکرو مینیا
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: آپ <color=#C31439>{0}!</color> میں ناکام ہوں گے
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: آپ کھو دیں گے
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: مشکل
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
