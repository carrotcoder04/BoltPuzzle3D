%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: Language_uk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: uk
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: ЗАВАНТАЖЕННЯ НЕ ВІДБУЛОСЯ
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Недостатньо монет
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: Спробуйте знову
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Додайте 1 коробку і продовжуйте!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Додайте отвір
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: БУР
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: МОЛОТОК
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Розбийте об’єкт
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: МЕТЛА
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Очистіть отвори
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: ПАУЗА
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Торкніться об'єкта, щоб його розбити.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: ЗАВАНТАЖЕННЯ
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Графіка хороша
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Гра цікава
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Занадто багато реклами
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: У грі є баги
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Перейдіть до "Налаштування системи", щоб дозволити доступ до альбому.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Додайте тільки дві дірки
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Немає гвинтів для очищення
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Реклама ще не готова.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Це буде використано для надання персоналізованих реклами та оптимізованого використання сервісу.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nГвинтовий джем"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nГвинтовий джем"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Складіть гвинти з коробками одного кольору.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Смахніть пальцем, щоб обернути об'єкт.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Смахніть двома пальцями, щоб збільшити об'єкт.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Дірки тимчасово утримують невідповідні гвинти!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Давайте зберемо всі гвинти!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: МОЛОДЕЦЬ
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: МАЙЖЕ ТАМ
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Очистіть дірки і продовжуйте!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Умови обслуговування
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Політика конфіденційності
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: РІВЕНЬ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Вітаємо! \n<color=#FDDC25>\"СКРЮ МАНІЯ\"</color> завершено!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: У рівні приховано {0} "Спеціальний Гвинт".
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Збирайте <color=#FDDC25>Спеціальні Гвинти</color>, щоб виграти нагороди!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Відкривай нагороди!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Збирайте спеціальні гвинти
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Проходь рівні
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: СКРЮ МАНІЯ
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: ЗАВЕРШЕНО
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Перемагайте на рівнях!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: ВИЙТИ
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Збирайте гвинти
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Збирайте {0} спеціальні гвинти!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Використовуйте інструмент «Бур» для додавання ще одного отвору.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Використовуйте інструмент «Молоток», щоб розбити об'єкт.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Використовуйте інструмент «Мітла», щоб очистити отвори.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: ДАЛЬТОНІК
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ДІМ
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Використовуйте ІНСТРУМЕНТ, щоб допомогти!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: ПРОДОВЖИТИ?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Розблокувати на LV {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: БОНУС
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Ваш прогрес було відновлено.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: ОНОВЛЕННЯ ВЕРСІЇ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Будь ласка, оновіть до останньої версії, щоб насолодитися кращим досвідом.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: ОНОВЛЕННЯ
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"СКРЮ МАНІЯ" розблоковано! Збирайте спеціальні гвинти, щоб отримати винагороди!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: НОВИЙ ІНСТРУМЕНТ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: ВІДКРИТО!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: ПОДАРУНОК РІВНЯ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Вигравайте більше рівнів, щоб отримати винагороди!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: ВІДРОЖИТИ
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: НЕЗАВЕРШЕНИЙ РІВЕНЬ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "У вас незавершений прогрес на рівні.\nБажаєте продовжити?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Ваші автоматизовані оголошення вже видалені!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Без спливаючих реклам!\n- Без банерної реклами!\n<color=#ffde00>- Додаткові винагороди за перегляд реклами (опційно)!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Використовуйте {0} свердловин!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Використовуйте {0} молотків!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Використовуйте {0} мітел!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Зберіть {0} ящиків інструментів!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Відкрутіть, зіграйтесь, розмістіть… і вигравайте!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Закінчилися реквізити? Натисніть значок реквізиту, щоб купити за монети!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Не вийшло? Натисніть кнопку монет, щоб продовжити!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Використовуйте монети, щоб купити реквізити або відновити рівень!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Режим для дальтоніків у налаштуваннях. Більш ясно!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Увійдіть через налаштування, щоб синхронізувати вашу гру!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Закручуйте щільно, думайте чітко!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Ви провалите <color=#C31439>Cтікучі Pубіки!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Ти втратиш своє <color=#C31439>життя</color> і <color=#C31439>Спеціальні колекції!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Ви втратите свої <color=#C31439>Спеціальні колекції!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Ви втратите свій <color=#C31439>Подорож Випускників!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: ГРАЙ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Активуйте на <color=#FFFF0B>1 годину</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: ОНОВЛЕНЕ ПОДАРУНКОВЕ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Дякуємо за оновлення! Ось кілька подарунків для вас!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ДОДАТИ ЯЩИК
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Додайте 1 коробок
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: РОЗМІР ВИКЛИКУ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Рівень не пройдено!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Ви виграли {0} рівнів і отримали ці нагороди!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: СКРЮ МАНІЯ
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Ви провалите <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Ви втратите
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: СКЛАДНО
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
