  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: ÎNCĂRCARE EȘUATĂ
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Nu sunt suficiente monede
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: ÎNCERCAȚI DIN NOU
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Adăugați 1 cutie și continuați!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Adăugați un gaura
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: Burghiu
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: Ciocan
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Sparge un obiect
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: Mătură
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Curățați găurile
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUZĂ
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Apasă pe un obiect pentru a-l sparge.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: SE ÎNCARCĂ
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Graficul este bun
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Jocul este distractiv
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Prea multe reclame
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Jocul are erori
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Accesați "Setările Sistemului" pentru a activa accesul la album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Adăugați doar două găuri
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Niciun șurub de curățat
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Reclama nu este pregătită.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Aceasta va fi folosită pentru a oferi reclame personalizate și utilizarea optimizată a serviciului.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nScrew Pin Jam"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nScrew Pin Jam"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Asociază șuruburi cu cutii de aceeași culoare.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Glisează degetul pentru a roti obiectul.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Glisează cu două degete pentru a mări obiectul.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Găurile rețin temporar șuruburile neasortate!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Să colectăm toate șuruburile!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: BINE FĂCUT!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: PRESC DE AICI
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Curățați găurile și continuați!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Termen de Serviciu
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Politica de Confidențialitate
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: NIVELUL {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Felicitări! \n<color=#FDDC25>\"MANIA CU ȘURUBURI\"</color> completată!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Există {0} de "Şuruburi Speciale" ascunse în nivel.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Colectează <color=#FDDC25>Şuruburi Speciale</color> pentru a câștiga recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Deblochează recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Colectează șuruburi speciale
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Depășește nivele
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIA CU ȘURUBURI
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: TERMINAT
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Câștigă nivele!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: IEȘIRE
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Colectează șuruburi
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Colectează {0} speciale!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Folosește instrumentul „Burghiu” pentru a adăuga încă o gaură.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Folosește unealta „Ciocan” pentru a sparge un obiect.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Folosește unealta „Mătură” pentru a curăța găurile.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: DOLONIC
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ACASĂ
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Folosește UNELTA pentru ajutor!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: CONTINUA?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Deblocați la LV {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Dein Fortschritt wurde wiederhergestellt.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: ACTUALIZARE VERSIUNE
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Vă rugăm să actualizați la cea mai recentă versiune pentru a vă bucura de o experiență mai bună.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: ACTUALIZARE
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MANIA CU ȘURUBURI" deblocat! Colectează șuruburi speciale pentru a câștiga recompense!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: UNELTA NOUĂ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: DEBLOCATĂ!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: CADOU NIVEL
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Câștigă mai multe niveluri pentru a obține recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: REVIEAZĂ
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: NIVEL NEFINIT
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Ai progres în nivel neterminat.\nAi dori să continui?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Anunțurile automate deja îndepărtate!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Fără reclame pop-up!\n- Fără reclame banner!\n<color=#ffde00>- Reclame recompensate opționale pentru recompense suplimentare!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Foloseste {0} bormașini!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Foloseste {0} ciocane!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Foloseste {0} mături!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Colectează {0} cufere de unelte!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Desfă, potrivește, plasează... și câștigă!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Fără accesorii? Atinge pictograma de accesorii pentru a cumpăra cu monede!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Ai eșuat? Atinge butonul cu monede pentru a continua!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Folosește monedele pentru a cumpăra accesorii sau a revigora scena!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Modul pentru daltonici este în Setări. Mult mai clar!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Conectează-te prin Setări pentru a sincroniza jocul tău!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Întărește, gândește clar!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Vei eșua în <color=#C31439>Cuburi SărindI!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Îți vei pierde <color=#C31439>viața</color> și <color=#C31439>colecțiile speciale!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Vei pierde colecțiile tale <color=#C31439>Speciale!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Vei pierde <color=#C31439> Călătoria Balonului! </color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: JOACĂ-TE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Activează pentru <color=#FFFF0B> 1 oră </color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: CADOU DE UPDATE
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Îți mulțumim pentru actualizare! Iată câteva cadouri pentru tine!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ADĂUGA BOX
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Adaugă 1 cutii
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: NIȘA DE PROVOCARE!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Nivel eșuat!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Ai câștigat {0} niveluri și ai câștigat aceste recompense!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MANIA CU ȘURUBURI
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Vei eșua în <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Vei pierde
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: GREU
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
