  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: 圖片上傳失敗
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: 美術設計不錯
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: 遊戲很有趣
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: 廣告太多
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: 遊戲有 bug
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: 請前往「系統設置」啟用相冊訪問權限。
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: 最多添加2個孔位
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: 沒有螺絲需要清理
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D 螺絲大師
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D 螺絲大師
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: 廣告尚未準備好。
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: 没有足够的金幣
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: 這將用於提供個性化廣告和優化服務。
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D 螺絲大師：\n螺絲消消樂遊戲"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D 螺絲大師：\n螺絲消消樂遊戲"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: 將螺絲與同色盒子配對。
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: 手指劃動螢幕以旋轉模型。
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: 雙指劃動可縮放模型。
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: 孔位可暫時容納無法匹配的螺絲。
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: 來蒐集所有的螺絲吧!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: 幹得漂亮!
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: 重試
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: 就差一點點
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: 添加1個盒子並繼續遊戲!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: 添加1個孔位
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: 鑽頭
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: 錘子
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: 擊碎一塊物體
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: 掃把
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: 清理孔位
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: 暫停
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: 選擇並擊碎一塊物體。
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: 服務條款
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: 隱私政策
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: 快速加載中
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: 清除孔位並繼續遊戲!
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: 關卡 {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "恭喜你完成了\n<color=#FDDC25>「瘋狂螺絲大作戰」</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: 關卡中藏著{0}顆“特殊螺絲”。
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: 收集<color=#FDDC25>特殊螺絲</color>即可贏得獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: 解鎖獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: 收集特殊螺絲!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: 通過關卡!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: 瘋狂螺絲大作戰
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: 已完成
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: 通過關卡!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: 離開
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: 收集螺絲
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: 收集{0}個特殊螺絲!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: 使用「鑽頭」可增加一個洞孔!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: 使用「錘子」可打碎一塊板子!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: 使用「掃帚」可清理所有孔洞!
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: 色盲模式
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: 首頁
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: 使用工具加速通關!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: 繼續遊戲？
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: 第{0}關解鎖
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: 獎勵
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: 關卡進度已恢復
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: 版本更新
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: 請更新到最新版本以享受更好的體驗。
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: 更新
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: "瘋狂螺絲大作戰解鎖了!\n收集特殊螺絲、贏取豐厚獎勵!"
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: 全新工具
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: 已解鎖!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: 關卡禮物
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: 繼續通關，贏取更多獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: 復活
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: 關卡未完成
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "你還有未完成的關卡進度\n是否繼續闖關？"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: 已移除強制廣告!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- 無強制廣告!\n- 無橫幅廣告!\n<color=#ffde00>- 保留可選擇激勵廣告，以獲取額外獎勵! </color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: 使用{0}個鑽頭!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: 使用{0}個錘子!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: 使用{0}個掃帚!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: 消除{0}個盒子!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: 旋下螺絲，同色配對，通關取勝!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: 道具用完了？點擊道具圖標，即可用金幣購買!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: 關卡失敗了？點擊金幣按鈕即可繼續遊戲!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: 金幣可用來購買道具或復活關卡哦!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: 在設定中開啟色盲模式。清晰度大大提升!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: 在設定頁面登入帳戶，同步你的遊戲進度!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: 手擰螺絲，智鬥難題!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: 你的 <color=#C31439>積木跳躍賽</color>活動將失敗!
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: 你將失去1條<color=#C31439>生命值</color>和<color=#C31439>特殊物品! </color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: 你將失去已收集的<color=#C31439>特殊物品!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: 你將失去<color=#C31439>熱氣球之旅</color>進度!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: 繼續遊玩
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: 啟動後暢玩<color=#FFFF0B>1小時</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: 遊戲升級禮物
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: 感謝更新!這是你的專屬禮物!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: 增加盒子
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: 增加1個盒子
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: 挑戰關卡!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: 挑戰失敗!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: 你贏了{0}個關卡並獲得了這些獎勵!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: 瘋狂螺絲大作戰
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: 你的<color=#C31439>{0}</color>活動將會失敗!
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: 你將失去
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: 困難
    m_Metadata:
      m_Items: []
