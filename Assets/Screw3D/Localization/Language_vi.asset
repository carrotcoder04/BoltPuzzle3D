  m_TableData:
  - m_Id: 365780000768
    m_Localized: TẢI LỖI
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Không đủ tiền xu
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: THỬ LẠI
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Thêm 1 hộp và tiếp tục!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Thêm một lỗ
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: MŨI KHOAN
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: BÚA
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Đập vỡ một vật thể
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: CHỔI
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Làm sạch các lỗ
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: TẠM NGỪNG
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Chạm vào vật thể để đập vỡ.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: ĐANG TẢI
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Đồ họa tốt
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Trò chơi thú vị
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Quá nhiều quảng cáo
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Trò chơi có lỗi
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Hãy vào "Cài Đặt Hệ Thống" để cho phép truy cập album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Chỉ cần thêm hai lỗ
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Không có vít nào để dọn sạch
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Quảng cáo chưa sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Điều này sẽ được sử dụng để cung cấp quảng cáo cá nhân hóa và tối ưu hóa việc sử dụng dịch vụ.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nKẹt Chốt Vit"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nKẹt Chốt Vit"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Ghép vít với các hộp cùng màu.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Vuốt ngón tay để xoay vật thể.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Vuốt hai ngón tay để phóng to vật thể.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Các lỗ giữ vít không khớp tạm thời!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Hãy thu thập tất cả các vít!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: LÀM TỐT!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: GẦN ĐẾN RỒI
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Dọn sạch các lỗ và tiếp tục!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Điều khoản Dịch vụ
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Chính sách Bảo mật
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: CẤP ĐỘ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Chúc mừng!\n<color=#FDDC25>\"CUỒNG VÍT\"</color> đã hoàn thành!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Có {0} "Vít Đặc Biệt" được giấu trong cấp độ.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Thu thập <color=#FDDC25>Vít Đặc Biệt</color> để nhận phần thưởng!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Mở khóa phần thưởng
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Thu thập các con vít đặc biệt
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Hoàn thành cấp độ
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: CUỒNG VÍT
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: HOÀN THÀNH
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Vượt qua các cấp độ!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: THOÁT
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Thu thập đinh vít
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Thu thập {0} đặc biệt!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Sử dụng công cụ “Khoan” để thêm một lỗ nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Sử dụng công cụ “Búa” để đập vỡ một vật.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Sử dụng công cụ “Chổi” để quét sạch các lỗ.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: MÙ MÀU
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: NHÀ
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Sử dụng CÔNG CỤ để giúp đỡ!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: TIẾP TỤC?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Mở khóa cấp độ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: THƯỞNG
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Tiến trình của bạn đã được khôi phục.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: CẬP NHẬT PHIÊN BẢN
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Vui lòng cập nhật lên phiên bản mới nhất để tận hưởng trải nghiệm tốt hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: CẬP NHẬT
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"CUỒNG VÍT" đã mở khóa! Thu thập các ốc vít đặc biệt để giành phần thưởng!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: CÔNG CỤ MỚI!
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: MỞ KHÓA!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: QUÀ TẶNG CẤP ĐỘ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Giành được nhiều cấp độ hơn để nhận phần thưởng!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: PHỤC HỒI
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: CẤP ĐỘ CHƯA HOÀN THÀNH
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Bạn có tiến trình cấp độ chưa hoàn thành.\nBạn có muốn tiếp tục không?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Quảng cáo tự động của bạn đã bị xóa!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Không có quảng cáo pop-up!\n- Không có quảng cáo banner!\n<color=#ffde00>- Quảng cáo tự nguyện nhận thưởng để có thêm phần thưởng!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Sử dụng {0} khoan!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Sử dụng {0} búa!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Sử dụng {0} chổi!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Thu thập {0} hộp công cụ!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Tháo ra, ghép lại, đặt… và chiến thắng!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Hết đạo cụ? Nhấn biểu tượng đạo cụ để mua bằng xu!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Thất bại? Nhấn nút xu để tiếp tục!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Sử dụng xu để mua đạo cụ hoặc hồi sinh giai đoạn!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Chế độ Mù Màu có trong Cài đặt. Rõ ràng hơn nhiều!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Đăng nhập qua Cài đặt để đồng bộ trò chơi của bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Vặn chặt, suy nghĩ sáng suốt!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Bạn sẽ thất bại trong <color=#C31439>Khối Nhảy!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Bạn sẽ mất <color=#C31439>cuộc sống</color> và <color=#C31439>Bộ sưu tập đặc biệt!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Bạn sẽ mất những <color=#C31439>Bộ sưu tập đặc biệt của bạn!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Bạn sẽ mất <color=#C31439>Hành Trình Bong Bóng!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: CHƠI TIẾP
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Kích hoạt trong <color=#FFFF0B>1 giờ</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: QUÀ CẬP NHẬT
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Cảm ơn bạn đã cập nhật! Đây là một số món quà cho bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: THÊM HỘP
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Thêm 1 hộp
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: CẤP ĐỘ THÁCH THỨC!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Cấp độ thất bại!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Bạn đã thắng {0} cấp độ và nhận được những phần thưởng này!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: CUỒNG VÍT
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Bạn sẽ thất bại trong <color=#C31439>{0}!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Bạn sẽ mất
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: KHÓ
    m_Metadata:
      m_Items: []
