  m_TableData:
  - m_Id: 365780000768
    m_Localized: CARICAMENTO FALLITO
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Non ci sono abbastanza monete
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: RIPROVA
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Aggiungi 1 scatola e continua!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Aggiungi un buco
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: TRAPANO
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: MARTELLO
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Rompi un oggetto
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: SCOPA
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Pulisci i buchi
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: PAUSA
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Tocca un oggetto per distruggerlo.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: CARICAMENTO
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: La grafica è buona
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Il gioco è divertente
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Troppe pubblicità
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Il gioco ha bug
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Vai su "Impostazioni di Sistema" per abilitare l'accesso all'album.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Aggiungi solo due fori
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Nessuna vite da rimuovere
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Bolt Master
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: La pubblicità non è pronta.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Questo sarà utilizzato per fornire pubblicità personalizzate e ottimizzare l'uso del servizio.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Master: \nVite inceppata"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Master: \nVite inceppata"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Abbina le viti con le scatole dello stesso colore.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Scorri con un dito per ruotare l'oggetto.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Scorri con due dita per ingrandire l'oggetto.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: I fori trattengono temporaneamente le viti non abbinate!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Raccogliamo tutte le viti!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: OTTIMO LAVORO!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: QUASI ARRIVATO
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Svuota i fori e continua!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Termini di Servizio
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Informativa sulla privacy
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: LIVELLO {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Congratulazioni!\n<color=#FDDC25>\"MANIA DELLA VITE\"</color> completata!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Ci sono {0} "Viti Speciali" nascoste nel livello.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Colleziona <color=#FDDC25>Viti Speciali</color> per vincere premi!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Sblocca ricompense
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Colleziona viti speciali
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Supera livelli
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: MANIA DELLA VITE
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: FINITO
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Vinci i livelli!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: QUIT
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Raccogli viti
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Raccogli {0} speciali!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Usa lo strumento "Trapano" per aggiungere un altro foro.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Usa lo strumento “Martello” per rompere un oggetto.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Usa lo strumento “Scopa” per pulire i buchi.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: DALTONICO
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: CASA
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Usa lo STRUMENTO per aiutare!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: CONTINUARE?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Sblocca Livello {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: I tuoi progressi sono stati ripristinati.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: AGGIORNAMENTO VERSIONE
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Si prega di aggiornare all'ultima versione per godere di un'esperienza migliore.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: AGGIORNAMENTO
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"MANIA DELLA VITE" sbloccato! Colleziona viti speciali per vincere ricompense!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: NUOVO STRUMENTO
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: SBLOCCATO!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: REGALO DI LIVELLO
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Vinci più livelli per ottenere premi!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: RIVIVERE
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: LIVELLO NON FINITO
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Hai dei progressi nel livello incompleti.\nVuoi continuare?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: I tuoi annunci automatici sono già stati rimossi!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Nessun annuncio pop-up!\n- Nessun banner pubblicitario!\n<color=#ffde00>- Annunci premiati opzionali per ricompense extra!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Usa {0} trapani!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Usa {0} martelli!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Usa {0} scope!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Raccogli {0} cassette degli attrezzi!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Svitare, abbinare, posizionare… e vincere!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Finito i props? Tocca l'icona del prop per acquistarli con le monete!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Fallito? Tocca il pulsante delle monete per continuare!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Usa le monete per acquistare props o ripristinare il livello!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: La modalità daltonico è nelle impostazioni. Molto più chiara!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Accedi tramite impostazioni per sincronizzare il tuo gioco!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Avvita bene, pensa acuto!
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Perderai la tua <color=#C31439>vita</color> e <color=#C31439>collezioni speciali!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Non completerai la <color=#C31439>Cubi Saltanti!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Perderai le tue <color=#C31439>Collezioni Speciali!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Perderai il tuo <color=#C31439>Viaggio In Balloon!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: GIOCA
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Attiva per <color=#FFFF0B>1 ora</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: REGALO D'AGGIORNAMENTO
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Grazie per il tuo aggiornamento! Ecco alcuni regali per te!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: AGGIUNGI SCATOLA
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Aggiungi 1 scatole
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: LIVELLO SFIDA!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: Livello fallito!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Hai vinto {0} livelli e hai guadagnato questi premi!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: MANIA DELLA VITE
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Non completerai la <color=#C31439>Cubi Saltanti!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Perderai
    m_Metadata:
      m_Items: []
