    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Die Werbung ist nicht bereit.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Dies wird verwendet, um personalisierte Anzeigen und optimierte Serviceverwendung bereitzustellen.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: "3D Bolt Meister: \nScrew Pin Jam"
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: "3D Bolt Meister: \nScrew Pin Jam"
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Verbinde Schrauben mit Kisten der gleichen Farbe.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Wischen, um das Objekt zu drehen.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Ziehen zum Zoomen.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Löcher halten nicht passende Schrauben vorübergehend!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Lass uns alle Schrauben sammeln!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
