%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: Language_el
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: el
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: Αποτυχία φόρτωσης
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: Δεν υπάρχουν αρκετά νομίσματα
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: ΞΑΝΑ ΠΡΟΣΠΑΘΗΣΤΕ
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: Προσθέστε 1 κουτί και συνεχίστε!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: Πρόσθεσε μια τρύπα
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: ΤΡΥΠΑΝΙ
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: ΣΦΥΡΑ
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: Σπάστε ένα αντικείμενο
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: ΣΚΟΥΠΑ
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: Καθαρίστε τις τρύπες
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: ΠΑΥΣΗ
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: Πατήστε ένα αντικείμενο για να το σπάσετε.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: ΦΟΡΤΩΣΗ
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: Η γραφική είναι καλή
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: Το παιχνίδι είναι διασκεδαστικό
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: Πάρα πολλές διαφημίσεις
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: Το παιχνίδι έχει σφάλματα
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: Πηγαίνετε στις "Ρυθμίσεις Συστήματος" για να ενεργοποιήσετε την πρόσβαση στο άλμπουμ.
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: Προσθέστε μόνο δύο τρύπες
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: Δεν υπάρχουν βίδες για να καθαρίσετε
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D Μπολτ Μάστερ
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D Μπολτ Μάστερ
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: Η διαφήμιση δεν είναι έτοιμη.
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: Αυτό θα χρησιμοποιηθεί για την παροχή προσωποποιημένων διαφημίσεων και βελτιστοποιημένης χρήσης υπηρεσιών.
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: '3D Μπολτ Μάστερ: Σφήνα'
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: '3D Μπολτ Μάστερ: Σφήνα'
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: Εναρμονίστε τις βίδες με τα κουτιά του ίδιου χρώματος.
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: Κάντε swipe με το δάχτυλο για να περιστρέψετε το αντικείμενο.
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: Κάντε swipe με δύο δάχτυλα για να κάνετε zoom στο αντικείμενο.
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: Οι τρύπες κρατούν τις βίδες που δεν ταιριάζουν προσωρινά!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: Ας συγκεντρώσουμε όλες τις βίδες!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: ΜΠΡΑΒΟ!
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: ΣΧΕΔΟΝ ΕΚΕΙ
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: Καθαρίστε τις τρύπες και συνεχίστε!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: Όροι Υπηρεσίας
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: Πολιτική Απορρήτου
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: ΕΠΙΠΕΔΟ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "Συγχαρητήρια! Ολοκληρώθηκε το \n<color=#FDDC25>\"ΒΙΩΜΑ ΜΕ ΒΙΔΕΣ\"</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: Υπάρχουν {0} "Ειδικές Βίδες" κρυμμένες στο επίπεδο.
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: Συλλέξτε <color=#FDDC25>Ειδικές Βίδες</color> για να κερδίσετε τα βραβεία!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: Ξεκλείδωσε ανταμοιβές!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: Συλλέξτε ειδικές βίδες
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: Ξεπέρασε επίπεδα
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: ΒΙΩΜΑ ΜΕ ΒΙΔΕΣ
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: ΤΕΛΕΙΩΣΕ
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: Κέρδισε επίπεδα!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: ΕΞΟΔΟΣ
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: Συλλέξτε βίδες
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: Συλλέξτε {0} ειδικές!
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: Χρησιμοποιήστε το εργαλείο “ΤΡΥΠΑΝΙ” για να προσθέσετε μια ακόμη τρύπα.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: Χρησιμοποιήστε το εργαλείο «ΣΦΥΡΑ» για να σπάσετε ένα αντικείμενο.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: Χρησιμοποιήστε το εργαλείο «ΣΚΟΥΠΑ» για να καθαρίσετε τις τρύπες.
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: ΑΧΡΩΜΑΤΙΣΜΟΣ
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: ΣΠΙΤΙ
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: Χρησιμοποιήστε το ΕΡΓΕΙΟ για βοήθεια!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: ΣΥΝΕΧΙΖΩ;
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: Ξεκλειδώστε Επίπεδο {0}
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: ΜΠΟΝΟΥΣ
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: Η πρόοδός σας έχει αποκατασταθεί.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: ΕΝΗΜΕΡΩΣΗ ΕΚΔΟΣΗΣ
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: Παρακαλώ ενημερώστε στην τελευταία έκδοση για να απολαύσετε μια καλύτερη εμπειρία.
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: ΕΝΗΜΕΡΩΣΗ
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"ΒΙΩΜΑ ΜΕ ΒΙΔΕΣ" ξεκλειδώθηκε! Συγκέντρωσε ειδικές βίδες για να κερδίσεις τις ανταμοιβές!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: ΝΕΟ ΕΡΓΑΛΕΙΟ
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: ΞΕΚΛΕΙΔΩΘΗΚΕ!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: ΕΠΙΠΕΔΟ ΔΩΡΟ
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: Κερδίστε περισσότερα επίπεδα για να κερδίσετε ανταμοιβές!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: ΑΝΑΣΤΑΙΝΩ
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: ΑΤΕΛΕΙΩΤΟ ΕΠΙΠΕΔΟ
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "Έχετε ατελείωτη πρόοδο σε επίπεδο.\nΘα θέλατε να συνεχίσετε;"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: Οι Αυτόματες Διαφημίσεις σας έχουν ήδη αφαιρεθεί!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- Χωρίς αναδυόμενα διαφημίσεις!\n- Χωρίς διαφημιστικά banners!\n<color=#ffde00>- Προαιρετικές διαφημίσεις με ανταμοιβή για επιπλέον ανταμοιβές!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: Χρησιμοποίησε {0} τρυπάνια!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: Χρησιμοποίησε {0} σφυριά!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: Χρησιμοποίησε {0} σκούπες!
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: Συλλέξτε {0} εργαλειοθήκες!
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: Ξεβιδώστε, ταιριάξτε, τοποθετήστε… και κερδίστε!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: Δεν έχετε αξεσουάρ; Πατήστε το εικονίδιο αξεσουάρ για να αγοράσετε με νομίσματα!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: Αποτύχατε; Πατήστε το κουμπί νομισμάτων για να συνεχίσετε!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: Χρησιμοποιήστε νομίσματα για να αγοράσετε αξεσουάρ ή να αναβιώσετε την πίστα!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: Η λειτουργία αχρωματοψίας βρίσκεται στις Ρυθμίσεις. Πολύ πιο καθαρή!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: Συνδεθείτε μέσω Ρυθμίσεων για να συγχρονίσετε το παιχνίδι σας!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: Βιδώστε καλά, σκεφτείτε οξυδερκώς!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: Θα αποτύχετε στην <color=#C31439>Κυβοι που πηδουν!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: Θα χάσεις τη <color=#C31439>ζωή</color> σου και <color=#C31439>Ειδικές συλλογές!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: Θα χάσετε τις <color=#C31439>Ειδικές συλλογές!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: Θα χάσεις την <color=#C31439>Ταξίδι Με Μπαλόνια!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: ΠΑΙΞΕ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: Ενεργοποίησε για <color=#FFFF0B>1 ώρα</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: ΔΩΡΟ ΕΝΗΜΕΡΩΣΗΣ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: Σ' ευχαριστούμε για την ενημέρωσή σου! Ορίστε μερικά δώρα για σένα!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: ΠΡΟΣΘΕΣΕ ΚΟΥΤΙ
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: Πρόσθεσε 1 κουτιά
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: ΕΠΙΠΕΔΟ ΠΡΟΚΛΗΣΗΣ!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: ΑΠΟΤΥΧΙΑ ΕΠΙΠΕΔΟΥ!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: Κέρδισες {0} επίπεδα και κέρδισες αυτές τις ανταμοιβές!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: ΒΙΩΜΑ ΜΕ ΒΙΔΕΣ
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: Θα αποτύχετε στην <color=#C31439>Κυβοι που πηδουν!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: Θα χάσετε
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: ΔΥΣΚΟΛΟ
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
