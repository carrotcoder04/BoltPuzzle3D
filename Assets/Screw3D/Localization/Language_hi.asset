%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1aac8e9c81dd1c685a0bf64c67249e0c, type: 3}
  m_Name: Language_hi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: 27c9beb39bf46524a810ade5065abc3a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 365780000768
    m_Localized: लोडिंग विफल हो गया
    m_Metadata:
      m_Items: []
  - m_Id: 17711244432629760
    m_Localized: पर्याप्त सिक्के नहीं हैं
    m_Metadata:
      m_Items: []
  - m_Id: 21332337328381952
    m_Localized: पुनः प्रयास करें
    m_Metadata:
      m_Items: []
  - m_Id: 21332339001909248
    m_Localized: 1 बॉक्स जोड़ें और जारी रखें!
    m_Metadata:
      m_Items: []
  - m_Id: 21332339710746624
    m_Localized: एक छेद जोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 21332341468160000
    m_Localized: ड्रिल
    m_Metadata:
      m_Items: []
  - m_Id: 21332925856342016
    m_Localized: हथौड़ा
    m_Metadata:
      m_Items: []
  - m_Id: 21332927840247808
    m_Localized: एक वस्तु तोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 21332929249533952
    m_Localized: झाड़ू
    m_Metadata:
      m_Items: []
  - m_Id: 21332930449104896
    m_Localized: छेद साफ करें
    m_Metadata:
      m_Items: []
  - m_Id: 21332931858391040
    m_Localized: ठहराव
    m_Metadata:
      m_Items: []
  - m_Id: 21333309966508032
    m_Localized: किसी वस्तु पर टैप करें और उसे तोड़ें.
    m_Metadata:
      m_Items: []
  - m_Id: 21333440157704192
    m_Localized: लोड हो रहा है
    m_Metadata:
      m_Items: []
  - m_Id: 1671097737216
    m_Localized: ग्राफिक अच्छा है
    m_Metadata:
      m_Items: []
  - m_Id: 2006998573056
    m_Localized: गेम मजेदार है
    m_Metadata:
      m_Items: []
  - m_Id: 2008537882624
    m_Localized: बहुत सारे विज्ञापन
    m_Metadata:
      m_Items: []
  - m_Id: 2010119135232
    m_Localized: गेम में बग हैं
    m_Metadata:
      m_Items: []
  - m_Id: 2265040543744
    m_Localized: '"सिस्टम सेटिंग्स" पर जाएं ताकि अल्बम तक पहुँच सक्षम किया जा सके।'
    m_Metadata:
      m_Items: []
  - m_Id: 14182546999861248
    m_Localized: केवल दो छिद्र जोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 14182607217483776
    m_Localized: साफ करने के लिए कोई स्क्रू नहीं
    m_Metadata:
      m_Items: []
  - m_Id: 14430059359100928
    m_Localized: 3D बोल्ट मास्टर
    m_Metadata:
      m_Items: []
  - m_Id: 14430184026398720
    m_Localized: 3D बोल्ट मास्टर
    m_Metadata:
      m_Items: []
  - m_Id: 17424358203973632
    m_Localized: विज्ञापन तैयार नहीं है।
    m_Metadata:
      m_Items: []
  - m_Id: 19859794792800256
    m_Localized: इसका उपयोग व्यक्तिगत विज्ञापन और अनुकूलित सेवा उपयोग प्रदान करने के लिए किया जाएगा।
    m_Metadata:
      m_Items: []
  - m_Id: 20224634396860416
    m_Localized: '3D बोल्ट मास्टर: स्क्रू जाम'
    m_Metadata:
      m_Items: []
  - m_Id: 20224637282541568
    m_Localized: '3D बोल्ट मास्टर: स्क्रू जाम'
    m_Metadata:
      m_Items: []
  - m_Id: 21332155161370624
    m_Localized: एक जैसी रंग की बक्सों के साथ स्क्रू मिलाएँ।
    m_Metadata:
      m_Items: []
  - m_Id: 21332301794238464
    m_Localized: वस्तु को घुमाने के लिए अंगुली स्वाइप करें।
    m_Metadata:
      m_Items: []
  - m_Id: 21332320983179264
    m_Localized: वस्तु को ज़ूम करने के लिए दो अंगुलियों से स्वाइप करें।
    m_Metadata:
      m_Items: []
  - m_Id: 21332328943968256
    m_Localized: छिद्र असंगत स्क्रू को अस्थायी रूप से पकड़ते हैं!
    m_Metadata:
      m_Items: []
  - m_Id: 21332331062091776
    m_Localized: आइए सभी स्क्रू इकट्ठा करें!
    m_Metadata:
      m_Items: []
  - m_Id: 21332336523075584
    m_Localized: बहुत अच्छा
    m_Metadata:
      m_Items: []
  - m_Id: 21332338196602880
    m_Localized: लगभग पहुँच गए
    m_Metadata:
      m_Items: []
  - m_Id: 21426829767204864
    m_Localized: छिद्र साफ करें और जारी रखें!
    m_Metadata:
      m_Items: []
  - m_Id: 21333313808490496
    m_Localized: सेवा की शर्तें
    m_Metadata:
      m_Items: []
  - m_Id: 21333437041336320
    m_Localized: गोपनीयता नीति
    m_Metadata:
      m_Items: []
  - m_Id: 21428140755640320
    m_Localized: स्तर {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30111899772248064
    m_Localized: "बधाई हो! \n<color=#FDDC25>\"स्क्रू मैनिया\"</color> पूरा हुआ!"
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053763
    m_Localized: स्तर में {0} "विशेष स्क्रू" छिपे हुए हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053762
    m_Localized: इन्हें इकट्ठा करें <color=#FDDC25>विशेष स्क्रू</color> पुरस्कार जीतने के लिए!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899768053760
    m_Localized: पुरस्कार अनलॉक करें!
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859458
    m_Localized: विशेष स्क्रू इकट्ठा करें
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859457
    m_Localized: स्तर जीतें
    m_Metadata:
      m_Items: []
  - m_Id: 30111899763859456
    m_Localized: स्क्रू मैनिया
    m_Metadata:
      m_Items: []
  - m_Id: 61304828918226944
    m_Localized: समाप्त
    m_Metadata:
      m_Items: []
  - m_Id: 34836419909246976
    m_Localized: स्तर जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 8070819077939200
    m_Localized: बाहर निकलें
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219905
    m_Localized: स्क्रू इकट्ठा करें
    m_Metadata:
      m_Items: []
  - m_Id: 42760616564219907
    m_Localized: '{0} विशेष एकत्र करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062784
    m_Localized: “ड्रिल” उपकरण का उपयोग करके एक और छेद जोड़ें.
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062785
    m_Localized: '"हथौड़ा" टूल का उपयोग करके किसी वस्तु को तोड़ें।'
    m_Metadata:
      m_Items: []
  - m_Id: 49949479955062786
    m_Localized: '"झाड़ू" टूल का उपयोग करके छेद साफ करें।'
    m_Metadata:
      m_Items: []
  - m_Id: 54743339331739648
    m_Localized: कलर ब्लाइंड
    m_Metadata:
      m_Items: []
  - m_Id: 56917147161452544
    m_Localized: घर
    m_Metadata:
      m_Items: []
  - m_Id: 56916809062801408
    m_Localized: उपकरण का उपयोग करें मदद के लिए!
    m_Metadata:
      m_Items: []
  - m_Id: 65524306266808320
    m_Localized: जारी रखें?
    m_Metadata:
      m_Items: []
  - m_Id: 41015862499467264
    m_Localized: स्तर{0} अनलॉक करें
    m_Metadata:
      m_Items: []
  - m_Id: 82947387843141632
    m_Localized: बोनस
    m_Metadata:
      m_Items: []
  - m_Id: 82947389877379072
    m_Localized: आपकी प्रगति बहाल कर दी गई है.
    m_Metadata:
      m_Items: []
  - m_Id: 82947391869673472
    m_Localized: संस्करण अपडेट
    m_Metadata:
      m_Items: []
  - m_Id: 82947393778081792
    m_Localized: कृपया बेहतर अनुभव के लिए नवीनतम संस्करण में अपडेट करें।
    m_Metadata:
      m_Items: []
  - m_Id: 82947395959119872
    m_Localized: अपडेट
    m_Metadata:
      m_Items: []
  - m_Id: 82947762847473664
    m_Localized: '"स्क्रू मैनिया" अनलॉक हो गया! पुरस्कार जीतने के लिए विशेष स्क्रू इकट्ठा करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 83729669470281728
    m_Localized: नया उपकरण
    m_Metadata:
      m_Items: []
  - m_Id: 83729684733353984
    m_Localized: अनलॉक किया गया है!
    m_Metadata:
      m_Items: []
  - m_Id: 83729687115718656
    m_Localized: लेवल गिफ़्ट
    m_Metadata:
      m_Items: []
  - m_Id: 83729689330311168
    m_Localized: पुरस्कार पाने के लिए ज़्यादा लेवल जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 90278512504594432
    m_Localized: पुनर्जीवित
    m_Metadata:
      m_Items: []
  - m_Id: 89826605159931904
    m_Localized: अपूर्ण स्तर
    m_Metadata:
      m_Items: []
  - m_Id: 89826608586678272
    m_Localized: "आपके पास अधूरा स्तर प्रगति है।\nक्या आप जारी रखना चाहेंगे?"
    m_Metadata:
      m_Items: []
  - m_Id: 91270772847271936
    m_Localized: आपके स्वचालित विज्ञापन पहले ही हटा दिए गए हैं!
    m_Metadata:
      m_Items: []
  - m_Id: 147063343653314560
    m_Localized: "- कोई पॉप-अप विज्ञापन नहीं!\n- कोई बैनर विज्ञापन नहीं!\n<color=#ffde00>- अतिरिक्त इनाम के लिए वैकल्पिक पुरस्कृत विज्ञापन!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 101117574626926592
    m_Localized: '{0} ड्रिल का उपयोग करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120896
    m_Localized: '{0} हथौड़े का उपयोग करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120897
    m_Localized: '{0} झाड़ू का उपयोग करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 101117574631120899
    m_Localized: '{0} टूलबॉक्स इकट्ठा करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 105754157372137472
    m_Localized: विज्ञापन, मेल खाएं, रखें... और जीतें!
    m_Metadata:
      m_Items: []
  - m_Id: 105754232760557568
    m_Localized: प्रॉप्स खत्म? सिक्कों से खरीदने के लिए प्रॉप आइकन पर टैप करें!
    m_Metadata:
      m_Items: []
  - m_Id: 105754235302305792
    m_Localized: असफल? जारी रखने के लिए सिक्कों के बटन पर टैप करें!
    m_Metadata:
      m_Items: []
  - m_Id: 105754236803866624
    m_Localized: प्रॉप्स खरीदने या स्टेज को रिवाइव करने के लिए सिक्कों का उपयोग करें!
    m_Metadata:
      m_Items: []
  - m_Id: 105754239249145856
    m_Localized: रंग-भेदी मोड सेटिंग्स में है। बहुत स्पष्ट!
    m_Metadata:
      m_Items: []
  - m_Id: 105754240528408576
    m_Localized: अपने खेल को सिंक करने के लिए सेटिंग्स के माध्यम से लॉग इन करें!
    m_Metadata:
      m_Items: []
  - m_Id: 105754241262411776
    m_Localized: अच्छी तरह से स्क्रू करें, तेज सोचें!
    m_Metadata:
      m_Items: []
  - m_Id: 115645270635569152
    m_Localized: आप <color=#C31439>घन कूदते!</color> में असफल होंगे।
    m_Metadata:
      m_Items: []
  - m_Id: 115645275379326976
    m_Localized: आप अपने <color=#C31439>जीवन</color> और <color=#C31439>विशेष संग्रह!</color> खो देंगे!
    m_Metadata:
      m_Items: []
  - m_Id: 115645305515401216
    m_Localized: आप अपने <color=#C31439>विशेष संग्रह!</color> खो देंगे
    m_Metadata:
      m_Items: []
  - m_Id: 115645315657228288
    m_Localized: आप <color=#C31439>गुब्बारा यात्रा</color> खो देंगे!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624041025536
    m_Localized: खेलें
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219840
    m_Localized: '<color=#FFFF0B>1 घंटे</color> के लिए सक्रिय करें!'
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219845
    m_Localized: अपडेट उपहार
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219846
    m_Localized: आपके अपडेट के लिए धन्यवाद! आपके लिए कुछ उपहार हैं!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219847
    m_Localized: बॉक्स जोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 122776624045219848
    m_Localized: 1 बॉक्स जोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414146
    m_Localized: चुनौती स्तर!
    m_Metadata:
      m_Items: []
  - m_Id: 122776624049414148
    m_Localized: स्तर विफल हुआ!
    m_Metadata:
      m_Items: []
  - m_Id: 161578115962757120
    m_Localized: आपने {0} स्तर जीते और ये पुरस्कार अर्जित किए!
    m_Metadata:
      m_Items: []
  - m_Id: 169587814167470080
    m_Localized: स्क्रू मैनिया
    m_Metadata:
      m_Items: []
  - m_Id: 169587814171664384
    m_Localized: आप <color=#C31439>घन कूदते!</color> में असफल होंगे।
    m_Metadata:
      m_Items: []
  - m_Id: 204681899265744896
    m_Localized: आप खो देंगे
    m_Metadata:
      m_Items: []
  - m_Id: 209106736197394432
    m_Localized: कठिन
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
