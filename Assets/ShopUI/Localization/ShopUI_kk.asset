  m_TableData:
  - m_Id: 14446482153472
    m_Localized: Жаңадан бастаушы топ
    m_Metadata:
      m_Items: []
  - m_Id: 1742614440173568
    m_Localized: Ең жақсы құндылық!
    m_Metadata:
      m_Items: []
  - m_Id: 14113282449408
    m_Localized: Болдырмады
    m_Metadata:
      m_Items: []
  - m_Id: 13346152636416
    m_Localized: Жалғастыру
    m_Metadata:
      m_Items: []
  - m_Id: 15200370548736
    m_Localized: Тегін
    m_Metadata:
      m_Items: []
  - m_Id: 16573329825792
    m_Localized: Үлкен байлам
    m_Metadata:
      m_Items: []
  - m_Id: 17052365479936
    m_Localized: Аңызға айналған байлам
    m_Metadata:
      m_Items: []
  - m_Id: 16223801696256
    m_Localized: Шектеулі ұсыныс!
    m_Metadata:
      m_Items: []
  - m_Id: 17154383536128
    m_Localized: Шебер түйреуіш
    m_Metadata:
      m_Items: []
  - m_Id: 17264207192064
    m_Localized: Мега байламы
    m_Metadata:
      m_Items: []
  - m_Id: 12736836303577088
    m_Localized: Қосымша ұсыныстар!
    m_Metadata:
      m_Items: []
  - m_Id: 17855167848448
    m_Localized: Ең танымал!
    m_Metadata:
      m_Items: []
  - m_Id: 15607314505728
    m_Localized: Жарнамалармен ойнаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 230547251200
    m_Localized: Сіздің сатып алуыңыз тоқтатылды.
    m_Metadata:
      m_Items: []
  - m_Id: 15410249326592
    m_Localized: Жарнамаларды алып тастаңыз
    m_Metadata:
      m_Items: []
  - m_Id: 15534962761728
    m_Localized: Автоматтандырылған жарнамаларды біржола алып тастаңыз!
    m_Metadata:
      m_Items: []
  - m_Id: 15906989137920
    m_Localized: Дүкен
    m_Metadata:
      m_Items: []
  - m_Id: 17414367469568
    m_Localized: Ультра байлам
    m_Metadata:
      m_Items: []
  - m_Id: 54661344438247424
    m_Localized: Күнделікті жиынтық
    m_Metadata:
      m_Items: []
  - m_Id: 54661686546653184
    m_Localized: Жаңа белес
    m_Metadata:
      m_Items: []
  - m_Id: 75395962292396032
    m_Localized: САТТЫҚ САТЫП АЛУ!
    m_Metadata:
      m_Items: []
  - m_Id: 153221218880708608
    m_Localized: Бұл деңгейде тегін <color=#fddc25>ТІРІЛУ</color>!
    m_Metadata:
      m_Items: []
  - m_Id: 178259481198583808
    m_Localized: БУСТЕР ЖИНАҒЫ
    m_Metadata:
      m_Items: []
  - m_Id: 192394475516977152
    m_Localized: Бұл деңгейде тегін <color={0}>ТІРІЛУ</color>!
